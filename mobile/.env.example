# Android emulator: 10.0.2.2 reaches the development computer.
# A physical device needs the computer's reachable LAN IP, e.g. 192.168.1.10.
VITE_APP_ENV=local
VITE_API_BASE_URL=http://10.0.2.2:8000/api/v1
# Set to full when the deployed gateway rejects or cannot forward NDJSON responses.
VITE_AGENT_RESPONSE_MODE=ndjson
VITE_AUTH_MODE=dev
VITE_CLOUDBASE_ENV_ID=
