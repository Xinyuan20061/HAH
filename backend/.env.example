APP_NAME=HealthMate API
ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-development-only
CREDENTIALS_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Development: sqlite:///./healthmate.db
# WeChat Cloud Run: use a persistent MySQL-compatible database URL.
DATABASE_URL=sqlite:///./healthmate.db
CORS_ORIGINS=*
PORT=8000
# Explicit opt-in only; run migrations separately before production replicas.
RUN_MIGRATIONS_ON_START=false
PUBLIC_BASE_URL=http://127.0.0.1:8000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# RAG 语义检索嵌入模型（bge-small-zh ONNX，外部目录，不进交付包）
EMBEDDING_MODEL_DIR=D:\HealthMateData\models\bge-small-zh-v1.5
# 本地兜底对话引擎（Qwen2.5-0.5B ONNX，外部目录；DeepSeek 不可用时自动接管基础问答，plan 意图仍走规则）
LOCAL_LLM_MODEL_DIR=D:\HealthMateData\models\qwen2.5-0.5b-instruct-onnx
LOCAL_LLM_MAX_NEW_TOKENS=200

# Optional OpenAI-compatible speech service. Text chat works without these.
VOICE_API_KEY=
VOICE_API_BASE_URL=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_MAX_AUDIO_BYTES=8388608

WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Keep false when Cloud Run public ingress is enabled for the local AI Worker.
CLOUD_HEADER_LOGIN_ENABLED=false
CLOUDBASE_ENV_ID=
CLOUDRUN_SERVICE_NAME=healthmate-api

# local (developer machine) | cloud_ref (recommended on WeChat Cloud Run) | s3
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200
CLOUD_MEDIA_URL_TTL_SECONDS=7200

# Local GPU worker bridge. Generate a long random token and set the same value in ai-worker/.env.
WORKER_TOKEN=
WORKER_LEASE_SECONDS=180
WORKER_MAX_ATTEMPTS=3
WORKER_OFFLINE_AFTER_SECONDS=45
MOTION_PREVIEW_RETENTION_DAYS=7

# Optional S3/COS-compatible backend for future migration.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=healthmate-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

LOG_LEVEL=INFO
RETAIN_SENSITIVE_AUDIT_EXCERPT=false
