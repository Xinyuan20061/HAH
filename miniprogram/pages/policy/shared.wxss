.policy-page{min-height:100vh;padding:28rpx 28rpx 72rpx;box-sizing:border-box;background:#f7f7f2;color:#111613}
.policy-hero{padding:32rpx;border-radius:28rpx;color:#f7f7f2;background:#111613}
.policy-kicker{font-size:18rpx;letter-spacing:3rpx;color:rgba(255,255,255,.58)}
.policy-title{margin-top:12rpx;font-size:38rpx;font-weight:780;line-height:1.3}
.policy-lead{margin-top:14rpx;color:rgba(255,255,255,.72);font-size:22rpx;line-height:1.65}
.policy-card{margin-top:20rpx;padding:26rpx;border:1rpx solid #eeeee6;border-radius:23rpx;background:#fff}
.policy-card-title{font-size:26rpx;font-weight:760}
.policy-copy{margin-top:12rpx;color:#5f665f;font-size:21rpx;line-height:1.7}
.policy-note{margin-top:16rpx;padding:16rpx 18rpx;border-radius:15rpx;color:#506336;background:#f1f4e9;font-size:19rpx;line-height:1.6}
.policy-warning{color:#805b25;background:#f7f1e2}
.policy-error{color:#8b4437;background:#f8eeeb}
.policy-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #eeeee6;font-size:21rpx}
.policy-row:last-child{border-bottom:0}
.policy-muted{color:#7b8177;font-size:19rpx;line-height:1.55}
.policy-pill{flex:none;padding:7rpx 13rpx;border-radius:999rpx;color:#506336;background:#e9efd9;font-size:18rpx}
.policy-button{height:82rpx;margin:20rpx 0 0;border:0;border-radius:17rpx;color:#111613;background:#c4e267;font-size:23rpx;font-weight:730;line-height:82rpx}
.policy-button::after{border:0}
.policy-button.secondary{color:#506336;background:#e9efd9}
.policy-button.quiet{color:#5f665f;background:#f0f0e9}
.policy-button.danger{color:#fff;background:#79584f}
.policy-button[disabled]{opacity:.45}
.policy-link{display:flex;justify-content:space-between;align-items:center;min-height:76rpx;border-top:1rpx solid #eeeee6;color:#506336;font-size:21rpx}
.policy-link:first-of-type{margin-top:12rpx}
.policy-section{margin:34rpx 4rpx 15rpx;font-size:25rpx;font-weight:760}
.policy-grid{display:flex;gap:12rpx;margin-top:18rpx}
.policy-choice{flex:1;padding:20rpx 10rpx;border:2rpx solid #eeeee6;border-radius:17rpx;text-align:center;color:#5f665f;background:#fff;font-size:21rpx}
.policy-choice.selected{border-color:#8ca44f;color:#33491d;background:#f1f4e9}
.policy-input-row{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;padding:18rpx 0;border-bottom:1rpx solid #eeeee6;font-size:21rpx}
.policy-input-row text:first-child{width:190rpx;flex:none;color:#5f665f}
.policy-input-row input{flex:1;min-width:0;padding:10rpx 12rpx;border-radius:12rpx;background:#f7f7f2;font-size:21rpx}
.policy-list-item{padding:20rpx 0;border-top:1rpx solid #eeeee6}
.policy-list-head{display:flex;justify-content:space-between;gap:12rpx;font-size:21rpx;font-weight:700}
.policy-list-sub{margin-top:8rpx;color:#73796f;font-size:18rpx;line-height:1.5}
.policy-progress{height:10rpx;margin-top:16rpx;overflow:hidden;border-radius:99rpx;background:#eeeee6}
.policy-progress view{height:100%;border-radius:inherit;background:#a6bd57}
.policy-loading{padding:64rpx 20rpx;text-align:center;color:#7b8177;font-size:21rpx}
