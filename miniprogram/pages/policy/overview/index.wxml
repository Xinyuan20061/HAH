<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="policy-page ui-page-content">
  <view class="policy-hero">
    <view class="policy-kicker">PERSONAL ACTION PROTOCOL</view>
    <view class="policy-title">把一次尝试<br/>变成可复核的个人记录</view>
    <view class="policy-lead">先约定要做什么、观察什么，再记录执行与主观感受。系统不会把一次观察说成因果或健康效果。</view>
  </view>

  <view wx:if="{{loading}}" class="policy-loading">正在整理周期与历史记录…</view>
  <view wx:elif="{{error}}" class="policy-card policy-error">
    <view class="policy-card-title">暂时无法读取</view>
    <view class="policy-copy">{{error}}</view>
    <button class="policy-button secondary" bindtap="retry">重新读取</button>
  </view>

  <block wx:else>
    <view wx:if="{{warning}}" class="policy-card policy-warning">
      <view class="policy-copy">{{warning}}</view>
      <button class="policy-button secondary" bindtap="openCapabilities">查看能力授权设置</button>
    </view>
    <view wx:if="{{current}}" class="policy-card">
      <view class="policy-card-title">正在进行的 7 天周期</view>
      <view class="policy-row"><text>当前状态</text><text class="policy-pill">{{current.statusLabel}}</text></view>
      <view class="policy-row"><text>单次训练时长</text><text>{{current.sessionMinutes || '按已确认协议' }} 分钟</text></view>
      <view class="policy-row"><text>执行记录</text><text>{{current.completed}} / {{current.total}} 次完成</text></view>
      <view class="policy-progress"><view style="width: {{current.ratio}}%;"></view></view>
      <view class="policy-muted">结束时间：{{current.endLabel}}</view>
      <button class="policy-button" bindtap="openEpisode">继续记录与查看证据</button>
    </view>
    <view wx:else class="policy-card">
      <view class="policy-card-title">现在可开始的协议</view>
      <block wx:for="{{candidate.candidates}}" wx:key="template_id">
        <view class="policy-copy">{{item.title}}</view>
        <view class="policy-copy">{{item.description}}</view>
        <view class="policy-note">观察指标：{{item.metric_label}}。周期 7 天；基线与周期内各至少记录 5 次。</view>
      </block>
      <view wx:for="{{candidate.reasons}}" wx:key="*this" class="policy-note policy-warning">{{item}}</view>
      <button class="policy-button" disabled="{{!candidate.can_compile || !candidate.can_propose}}" bindtap="openProtocol">查看并设置协议</button>
      <button wx:if="{{!candidate.can_compile || !candidate.can_propose}}" class="policy-button secondary" bindtap="openCapabilities">查看能力授权设置</button>
    </view>

    <view class="policy-section">最近的个人周期</view>
    <view class="policy-card">
      <view wx:if="{{!history.length}}" class="policy-copy">完成的周期会保存在这里；数据不足时会明确标记，不会补造结论。</view>
      <view wx:for="{{history}}" wx:key="id" class="policy-list-item" data-id="{{item.id}}" bindtap="openHistoryItem">
        <view class="policy-list-head"><text>{{item.date}}</text><text class="policy-pill">{{item.status}}</text></view>
        <view class="policy-list-sub {{item.revoked ? 'policy-warning' : ''}}">{{item.conclusion}}</view>
      </view>
      <view class="policy-link" bindtap="openHistory"><text>查看全部历史与记忆管理</text><text>›</text></view>
    </view>

    <view class="policy-note">个人策略只整理你明确记录的执行和观察；可以停止周期、撤回过时证据或重置当前经验，原始健康记录不会被改写。</view>
  </block>
</view>
