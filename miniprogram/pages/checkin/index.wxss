.intro{padding:34rpx}.intro-title{font-size:36rpx;font-weight:750;line-height:1.4;margin:20rpx 0 10rpx}.intro-sub{opacity:.72;font-size:23rpx;line-height:1.6}.label{font-size:24rpx;color:#60706A;font-weight:600}.value{font-size:27rpx;color:#214F42}.water-actions{display:flex;gap:14rpx;margin-top:18rpx}.water-actions text{background:#E9F3EF;color:#235B4B;padding:13rpx 20rpx;border-radius:999rpx;font-size:22rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.hint{font-size:19rpx;color:#9AA39F;margin:7rpx 0 0 10rpx}.steps{margin-top:28rpx}.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.mood{background:#fff;border:2rpx solid transparent;border-radius:24rpx;padding:20rpx 8rpx;text-align:center;color:#75807C;font-size:22rpx}.mood.selected{border-color:#2E6B59;background:#EDF5F2;color:#245A4B;font-weight:650}.emoji{font-size:38rpx;margin-bottom:8rpx}.save{margin-top:34rpx}
