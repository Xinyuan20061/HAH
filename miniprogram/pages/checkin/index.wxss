.intro{padding:32rpx}.intro-title{font-size:36rpx;font-weight:750;line-height:1.4;margin:20rpx 0 12rpx}.intro-sub{opacity:.72;font-size:23rpx;line-height:1.6}.label{font-size:24rpx;color:#5f665f;font-weight:600}.value{font-size:27rpx;color:#111613}.water-actions{display:flex;gap:16rpx;margin-top:20rpx}.water-actions text,.water-actions view{background:#f7f7f2;color:#111613;padding:12rpx 20rpx;border-radius:999rpx;font-size:22rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.hint{font-size:19rpx;color:#506336;margin:8rpx 0 0 12rpx}.steps{margin-top:32rpx}.moods{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.mood{background:#fff;border:2rpx solid transparent;border-radius:24rpx;padding:20rpx 8rpx;text-align:center;color:#5f665f;font-size:22rpx}.mood.selected{border-color:#c4e267;background:#f7f7f2;color:#111613;font-weight:650}.emoji{font-size:38rpx;margin-bottom:8rpx}.save{margin-top:32rpx}
