.plan-hero{padding:38rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;opacity:.65}.plan-title{font-size:40rpx;font-weight:760;margin:18rpx 0 10rpx}.plan-sub{opacity:.72;line-height:1.6;font-size:23rpx}.progress-row{margin-top:30rpx;display:flex;align-items:center;gap:18rpx;font-size:20rpx;opacity:.85}.progress-bar{height:8rpx;background:rgba(255,255,255,.2);border-radius:999rpx;overflow:hidden;flex:1}.progress-fill{height:100%;background:#fff;border-radius:999rpx}.task{display:flex;align-items:flex-start;transition:.2s}.check{width:58rpx;height:58rpx;border-radius:19rpx;background:#E8F2EE;color:#1D5848;display:flex;align-items:center;justify-content:center;font-weight:700;margin-right:22rpx;flex:none}.task.done{opacity:.66}.task.done .check{background:#1D5848;color:#fff}.task.done .task-title{text-decoration:line-through}.task-title{font-size:29rpx;font-weight:720}.task-desc{font-size:23rpx;line-height:1.6;margin-top:10rpx}.note{margin-top:34rpx;background:#EEF4F1;box-shadow:none}.note-title{font-weight:700;color:#285A4C}.note-desc{font-size:22rpx;line-height:1.7;margin-top:10rpx}
.agent-week{padding:28rpx;background:linear-gradient(145deg,#f0f7f3,#fff)}.agent-kicker{font-size:16rpx;letter-spacing:2rpx;color:#39725f;font-weight:800}.agent-title{font-size:29rpx;font-weight:820;margin-top:6rpx}.agent-count{font-size:24rpx;font-weight:800;color:#2b6653}.agent-range{font-size:18rpx;margin:8rpx 0 14rpx}.week-task{display:flex;align-items:flex-start;border-top:1rpx solid #e8efeb;padding:18rpx 0}.week-task.done{opacity:.62}.week-task.done .task-title{text-decoration:line-through}
.grow{flex:1;min-width:0}
.task-side{display:flex;flex-direction:column;align-items:flex-end;gap:10rpx;margin-left:14rpx;flex:none}
.restore-btn{font-size:20rpx;font-weight:700;color:#2b6653;background:#e8f2ee;border-radius:999rpx;padding:8rpx 18rpx}
.del-btn{width:44rpx;height:44rpx;border-radius:50%;background:#f3ece8;color:#8a5a45;display:flex;align-items:center;justify-content:center;font-size:26rpx;line-height:1}
.tag-custom{display:inline-block;margin-left:10rpx;font-size:16rpx;font-weight:700;color:#8a5a19;background:#fff4df;border-radius:999rpx;padding:4rpx 12rpx;vertical-align:middle}
.undo-hint{margin-left:12rpx;font-size:18rpx;color:#7b8983}
.add-bar{margin:22rpx 0 4rpx;padding:20rpx;border:2rpx dashed #b8c9c1;border-radius:20rpx;text-align:center;color:#2b6653;font-weight:700;font-size:25rpx;background:#f9fbfa}
.add-panel{margin-top:16rpx;background:#fff;border-radius:22rpx;padding:22rpx;box-shadow:0 6rpx 24rpx rgba(31,65,55,.07)}
.add-input{background:#f4f7f2;border-radius:16rpx;padding:20rpx 22rpx;font-size:25rpx;margin-bottom:14rpx}
.add-textarea{background:#f4f7f2;border-radius:16rpx;padding:20rpx 22rpx;font-size:23rpx;height:140rpx;width:100%;box-sizing:border-box}
.add-actions{display:flex;gap:14rpx;margin-top:18rpx}
.add-actions button{flex:1;height:80rpx;border-radius:18rpx;font-size:24rpx;font-weight:700}
.btn-primary{background:#183f34!important;color:#fff!important}
.btn-primary::after,.btn-soft::after{border:none}
