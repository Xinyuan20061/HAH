.plan-hero{padding:40rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;opacity:.65}.plan-title{font-size:40rpx;font-weight:760;margin:20rpx 0 12rpx}.plan-sub{opacity:.72;line-height:1.6;font-size:23rpx}.progress-row{margin-top:32rpx;display:flex;align-items:center;gap:20rpx;font-size:20rpx;opacity:.85}.progress-bar{height:8rpx;background:rgba(255,255,255,.2);border-radius:999rpx;overflow:hidden;flex:1}.progress-fill{height:100%;background:#fff;border-radius:999rpx}.task{display:flex;align-items:flex-start;padding:24rpx;transition:opacity .25s ease-out}.check{width:58rpx;height:58rpx;border-radius:50%;background:#e9efd9;color:#111613;display:flex;align-items:center;justify-content:center;font-weight:700;margin-right:24rpx;flex:none;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease-out}.check image{width:32rpx;height:32rpx}.task.done{opacity:.66}.task.done .check{background:#c4e267;color:#111613;transform:scale(1.04);box-shadow:0 0 0 6rpx rgba(17,22,19,.1)}.task.done .task-title{text-decoration:line-through}.task-title{font-size:29rpx;font-weight:720}.task-desc{font-size:23rpx;line-height:1.6;margin-top:12rpx}.note{margin-top:32rpx;background:#f7f7f2;box-shadow:none}.note-title{font-weight:700;color:#111613}.note-desc{font-size:22rpx;line-height:1.7;margin-top:12rpx}
.agent-week{padding:32rpx;background:linear-gradient(145deg,#f7f7f2,#fff)}.agent-kicker{font-size:16rpx;letter-spacing:2rpx;color:#506336;font-weight:800}.agent-title{font-size:29rpx;font-weight:820;margin-top:8rpx}.agent-count{font-size:24rpx;font-weight:800;color:#506336}.agent-range{font-size:18rpx;margin:8rpx 0 16rpx}.week-task{display:flex;align-items:flex-start;border-top:1rpx solid #e9efd9;padding:24rpx 0}.week-task.done{opacity:.62}.week-task.done .task-title{text-decoration:line-through}
.grow{flex:1;min-width:0}
.task-side{display:flex;flex-direction:column;align-items:flex-end;gap:12rpx;margin-left:16rpx;flex:none}
.restore-btn{font-size:20rpx;font-weight:700;color:#506336;background:#e9efd9;border-radius:999rpx;padding:8rpx 20rpx;animation:restoreIn .22s ease-out}
@keyframes restoreIn{from{opacity:0;transform:translateY(-6rpx)}to{opacity:1;transform:translateY(0)}}
.del-btn{width:52rpx;height:52rpx;border-radius:50%;background:#eeeee6;display:flex;align-items:center;justify-content:center}.del-btn image{width:28rpx;height:28rpx}
.tag-custom{display:inline-block;margin-left:12rpx;font-size:16rpx;font-weight:700;color:#8a5a19;background:#fff4df;border-radius:999rpx;padding:4rpx 12rpx;vertical-align:middle}
.undo-hint{margin-left:12rpx;font-size:18rpx;color:#5f665f}
.add-control{display:flex;align-items:center;justify-content:center;gap:12rpx;margin:24rpx 0 4rpx;padding:20rpx;border:2rpx dashed #e9efd9;border-radius:20rpx;text-align:center;color:#506336;font-weight:700;font-size:25rpx;background:#f7f7f2}.add-control image{width:30rpx;height:30rpx}
.week-link .ui-chevron{transition:transform .24s cubic-bezier(.2,.8,.2,1)}.week-link .ui-chevron.open{transform:rotate(90deg)}
.add-panel{margin-top:16rpx;background:#fff;border-radius:22rpx;padding:24rpx;box-shadow:0 6rpx 24rpx rgba(17,22,19,.07)}
.add-input{background:#f7f7f2;border-radius:16rpx;padding:20rpx 24rpx;font-size:25rpx;margin-bottom:16rpx}
.add-textarea{background:#f7f7f2;border-radius:16rpx;padding:20rpx 24rpx;font-size:23rpx;height:140rpx;width:100%;box-sizing:border-box}
.add-actions{display:flex;gap:16rpx;margin-top:20rpx}
.add-actions button{flex:1;height:80rpx;border-radius:18rpx;font-size:24rpx;font-weight:700}
.btn-primary{background:#c4e267!important;color:#111613!important}
.btn-primary::after,.btn-soft::after{border:none}
