.plan-page{padding-bottom:96rpx;background:#f7f7f2}
.plan-page.has-agent-review{padding-bottom:220rpx}
.plan-intro{margin:8rpx 0 24rpx}
.section-kicker{color:#506336;font-size:17rpx;font-weight:720;letter-spacing:1rpx}

.agent-review-float{position:fixed;z-index:40;right:32rpx;bottom:calc(40rpx + env(safe-area-inset-bottom));width:calc(100vw - 64rpx);pointer-events:none}
.agent-review-panel{width:100%;padding:24rpx;box-sizing:border-box;border:1rpx solid #eeeee6;border-radius:28rpx;background:#fff;box-shadow:0 20rpx 48rpx rgba(17,22,19,.14);opacity:0;transform:translateY(16rpx) scale(.98);transform-origin:92% 100%;transition:opacity .24s ease-out,transform .3s cubic-bezier(.2,.8,.2,1);pointer-events:none}
.agent-review-float.expanded .agent-review-panel{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
.review-head{display:flex;align-items:center;gap:12rpx}
.review-avatar{width:64rpx;min-width:64rpx;height:64rpx;overflow:hidden;border-radius:18rpx;background:#e9efd9}
.review-avatar image{display:block;width:100%;height:100%}
.review-identity{min-width:0;flex:1}
.review-name{color:#111613;font-size:24rpx;font-weight:780;line-height:1.2}
.review-role{margin-top:4rpx;color:#5f665f;font-size:17rpx}
.preview-badge{flex:none;padding:8rpx 12rpx;border-radius:16rpx;background:#e9efd9;color:#506336;font-size:16rpx;font-weight:760}
.review-bubble{position:relative;margin-top:20rpx;padding:20rpx;border-radius:20rpx;background:#f7f7f2}
.review-reply{min-height:36rpx;max-height:132rpx;overflow-y:auto;color:#111613;font-size:22rpx;line-height:1.55;white-space:pre-wrap}
.review-cursor{display:inline-block;width:4rpx;height:24rpx;margin-left:4rpx;border-radius:4rpx;background:#506336;vertical-align:-4rpx;animation:reviewBlink .8s ease-in-out infinite}
.preview-title{margin-top:12rpx;color:#111613;font-size:28rpx;font-weight:820;line-height:1.3}
.preview-list{height:320rpx;margin-top:12rpx;border-top:1rpx solid #eeeee6;border-bottom:1rpx solid #eeeee6}
.preview-item{display:flex;align-items:flex-start;gap:12rpx;padding:16rpx 0;border-top:1rpx solid #eeeee6}
.preview-item:first-child{border-top:0}
.preview-day{flex:none;width:64rpx;padding-top:4rpx;color:#506336;font-size:17rpx;font-weight:760}
.preview-copy{min-width:0;flex:1}
.preview-item-title{color:#111613;font-size:21rpx;font-weight:740;line-height:1.4}
.preview-item-desc{display:-webkit-box;overflow:hidden;margin-top:4rpx;color:#5f665f;font-size:18rpx;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.preview-category{flex:none;margin-top:4rpx;padding:4rpx 8rpx;border-radius:12rpx;background:#e9efd9;color:#506336;font-size:15rpx}
.preview-note{margin-top:8rpx;color:#5f665f;font-size:18rpx;text-align:right}
.preview-actions{display:flex;gap:16rpx;margin-top:16rpx}
.preview-actions button{height:76rpx;border-radius:20rpx;font-size:21rpx;font-weight:760;line-height:76rpx;flex:1}
.preview-actions button::after{border:0}
.preview-secondary{background:#e9efd9!important;color:#506336!important}
.preview-primary{background:#c4e267!important;color:#111613!important}
.preview-applied{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:16rpx;padding:20rpx;border-radius:20rpx;background:#506336;color:#fff;font-size:21rpx;font-weight:760}
.preview-applied text:first-child{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;border-radius:50%;background:#c4e267;color:#111613;font-size:18rpx}
.preview-loading{display:flex;align-items:center;justify-content:center;gap:12rpx;height:240rpx}
.preview-loading-dot{width:16rpx;height:16rpx;border-radius:50%;background:#506336;animation:previewDot .9s ease-in-out infinite}
.preview-loading-dot:nth-child(2){animation-delay:.12s}
.preview-loading-dot:nth-child(3){animation-delay:.24s}
.preview-error{position:relative;display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:200rpx;color:#5f665f;font-size:19rpx;line-height:1.5}
.preview-retry{flex:none;padding:12rpx 20rpx;border-radius:16rpx;background:#e9efd9;color:#506336;font-weight:720}
.agent-review-trigger{position:relative;display:flex;align-items:center;justify-content:center;width:96rpx;min-width:96rpx;max-width:96rpx;height:96rpx;min-height:96rpx;max-height:96rpx;margin:16rpx 0 0 auto;overflow:visible;background:#fff;box-shadow:0 12rpx 36rpx rgba(17,22,19,.16);transition:opacity .16s ease-out,transform .24s cubic-bezier(.2,.8,.2,1);pointer-events:auto}
.agent-review-trigger.open{transform:scale(1.04)}
.agent-review-trigger image{display:block;width:84rpx;height:84rpx;border-radius:50%;background:#e9efd9}
.review-unread-dot{position:absolute;right:0;top:0;width:20rpx;height:20rpx;box-sizing:border-box;border:4rpx solid #fff;border-radius:50%;background:#506336}

.activity-card{padding:8rpx 4rpx 20rpx}
.activity-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}
.activity-title{margin-top:4rpx;color:#111613;font-size:29rpx;font-weight:780}
.activity-stat{display:flex;flex-direction:column;align-items:flex-end;color:#5f665f;font-size:14rpx}
.activity-stat text:first-child{color:#111613;font-size:32rpx;font-weight:820;line-height:1}
.activity-bands{margin-top:24rpx}
.activity-band+.activity-band{margin-top:16rpx}
.activity-grid{display:flex;gap:4rpx;width:100%}
.activity-week{display:flex;min-width:0;flex:1;flex-direction:column;gap:4rpx}
.activity-cell{position:relative;overflow:hidden;width:100%;height:20rpx;border:0;border-radius:6rpx;box-sizing:border-box;background:#eeeee6;flex:none}
.activity-cell.spacer{visibility:hidden}
.activity-cell.unfilled,.legend-cell.unfilled{background:#eeeee6}
.activity-fill{position:absolute;top:0;right:0;bottom:0;left:0;border-radius:inherit;opacity:1}
.activity-bands.reveal .activity-fill{animation:activityReveal .4s ease-out both}
.activity-cell.partial .activity-fill{background:#c4e267}
.activity-cell.complete .activity-fill{background:#506336}
.activity-cell.today{position:relative;z-index:1;box-shadow:0 0 0 2rpx #111613;transform:scale(1.12)}
.activity-months{position:relative;height:24rpx;margin-top:8rpx;color:#8c9189;font-size:13rpx}
.month-label{position:absolute;top:0;white-space:nowrap;transform:translateX(-2rpx)}
.activity-foot{display:flex;align-items:flex-end;justify-content:flex-end;gap:20rpx;margin-top:8rpx;padding-top:16rpx;border-top:1rpx solid #eeeee6;color:#8c9189;font-size:13rpx;line-height:1.45}
.activity-legend{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8rpx 12rpx;color:#5f665f}
.activity-legend view{display:flex;align-items:center;gap:4rpx;white-space:nowrap}
.legend-cell{display:inline-block;width:8rpx;height:8rpx;border:0;border-radius:3rpx;background:#eeeee6;box-sizing:border-box}
.legend-cell.partial{background:#c4e267}
.legend-cell.complete{background:#506336}
.activity-skeleton{height:144rpx;margin-top:24rpx;border-radius:16rpx}
.activity-error{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:120rpx;margin-top:20rpx;color:#5f665f;font-size:17rpx}
.activity-retry{flex:none;padding:12rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-weight:700}
.shimmer{background:linear-gradient(100deg,#e9efd9 20%,#f7f7f2 40%,#e9efd9 60%);background-size:220% 100%;animation:planShimmer 1.3s infinite}

.settings-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin:32rpx 4rpx 16rpx}
.settings-title{margin-top:4rpx;color:#111613;font-size:29rpx;font-weight:780}
.completion-pill{padding:8rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:18rpx;font-weight:760;font-variant-numeric:tabular-nums}
.plan-settings{padding:24rpx;border:1rpx solid #eeeee6;border-radius:28rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}
.plan-simple{box-shadow:none}
.task{display:flex;align-items:flex-start;padding:24rpx;transition:opacity .25s ease-out}
.check{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;margin-right:20rpx;border-radius:50%;background:#e9efd9;color:#111613;font-weight:700;flex:none;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease-out}
.check image{width:32rpx;height:32rpx}
.task.done{opacity:.66}
.task.done .check{background:#c4e267;transform:scale(1.04);box-shadow:0 0 0 6rpx rgba(17,22,19,.1)}
.task.done .task-title{text-decoration:line-through}
.task-title{font-size:25rpx;font-weight:720;line-height:1.4}
.task-desc{margin-top:8rpx;font-size:20rpx;line-height:1.55}
.grow{min-width:0;flex:1}
.task-side{display:flex;flex:none;flex-direction:column;align-items:flex-end;gap:12rpx;margin-left:16rpx}
.restore-btn{padding:8rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:17rpx;font-weight:700}
.del-btn{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;background:#eeeee6}
.del-btn image{width:26rpx;height:26rpx}
.tag-custom{display:inline-block;margin-left:12rpx;padding:4rpx 12rpx;border-radius:999rpx;background:#fff4df;color:#8a5a19;font-size:14rpx;font-weight:700;vertical-align:middle}
.add-control{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:16rpx;padding:20rpx;border:1rpx dashed #cdd9ab;border-radius:18rpx;background:#f7f7f2;color:#506336;font-size:21rpx;font-weight:700}
.add-control image{width:28rpx;height:28rpx}
.add-panel{margin-top:16rpx;padding:20rpx;border-radius:20rpx;background:#f7f7f2}
.add-input,.add-textarea{width:100%;padding:16rpx 20rpx;border-radius:14rpx;background:#fff;box-sizing:border-box;font-size:22rpx}
.add-input{margin-bottom:12rpx}
.add-textarea{height:128rpx}
.add-actions{display:flex;gap:12rpx;margin-top:16rpx}
.add-actions button{height:76rpx;border-radius:18rpx;font-size:22rpx;font-weight:700;flex:1}
.btn-primary{background:#c4e267!important;color:#111613!important}
.btn-primary::after,.btn-soft::after{border:0}

.week-link{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#e9efd9;color:#506336;font-size:21rpx;font-weight:700}
.week-link .ui-chevron{transition:transform .24s cubic-bezier(.2,.8,.2,1)}
.week-link .ui-chevron.open{transform:rotate(90deg)}
.week-panel{margin-top:12rpx;padding:24rpx}
.week-task{display:flex;align-items:flex-start;padding:20rpx 0;border-top:1rpx solid #e9efd9}
.week-task.done{opacity:.62}
.week-task.done .task-title{text-decoration:line-through}
.notice{margin-top:24rpx}

@keyframes planShimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
@keyframes activityReveal{0%{opacity:0}100%{opacity:1}}
@keyframes previewDot{0%,100%{opacity:.35;transform:translateY(0)}50%{opacity:1;transform:translateY(-8rpx)}}
@keyframes reviewBlink{0%,100%{opacity:.25}50%{opacity:1}}
