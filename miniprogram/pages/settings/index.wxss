.settings-page{padding-top:32rpx;padding-bottom:64rpx}.settings-head{margin-bottom:24rpx}.eyebrow{color:#506336;font-size:19rpx;font-weight:720;letter-spacing:2rpx}.page-title{margin-top:4rpx;color:#111613;font-size:46rpx;font-weight:780}.setting-enter{animation:settingIn .34s cubic-bezier(.2,.8,.2,1) both}.delay-one{animation-delay:.06s}.delay-two{animation-delay:.12s}@keyframes settingIn{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}
.service-panel{padding:32rpx;border-radius:28rpx;background:#111613;color:#fff;box-shadow:0 16rpx 36rpx rgba(17,22,19,.14)}.service-top{display:flex;align-items:center;justify-content:space-between}.panel-kicker{color:#c4e267;font-size:19rpx;font-weight:720;letter-spacing:2rpx}.panel-title{margin-top:4rpx;font-size:32rpx;font-weight:760}.backend-dot{width:20rpx;height:20rpx;border-radius:50%;background:#5f665f}.backend-dot.on{background:#c4e267}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.service-item{padding:20rpx;border-radius:22rpx;background:#fff;color:#111613}.service-orb{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;border-radius:50%;background:#c4e267}.service-orb.voice{background:#e9efd9}.service-orb image{width:32rpx;height:32rpx}.service-name{margin-top:20rpx;font-size:24rpx;font-weight:740}.service-state{margin-top:4rpx;color:#9b5b00;font-size:19rpx}.service-state.ready{color:#506336}
.section-title{margin:32rpx 0 16rpx;color:#111613;font-size:28rpx;font-weight:760}.preference-panel,.settings-list{overflow:hidden;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}.preference-row{display:flex;min-height:106rpx;align-items:center;justify-content:space-between;padding:24rpx}.divider-row{border-top:1rpx solid #eeeee6}.row-title{color:#111613;font-size:25rpx;font-weight:700}.companion-switch{display:flex;padding:4rpx;border-radius:999rpx;background:#f7f7f2}.companion{display:flex;align-items:center;gap:8rpx;padding:8rpx 12rpx;border-radius:999rpx;color:#5f665f;font-size:20rpx}.companion.active{background:#e9efd9;color:#111613;font-weight:700}.companion image{width:32rpx;height:32rpx;border-radius:50%}
.settings-row{display:flex;min-height:106rpx;align-items:center;padding:24rpx;border-bottom:1rpx solid #eeeee6}.settings-row.last{border-bottom:0}.row-icon{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;flex:none;margin-right:16rpx;border-radius:50%;background:#e9efd9}.row-icon image{width:32rpx;height:32rpx}.grow{flex:1}.row-arrow{width:32rpx;height:32rpx;opacity:.56}.retry-btn{flex:none;margin:0;padding:0 20rpx;min-height:64rpx;border:0;border-radius:999rpx;background:#e9efd9;color:#111613;font-size:21rpx;line-height:64rpx}.retry-btn::after{border:0}
