.privacy-page{background:#f5f7f6}.privacy-hero{display:flex;gap:22rpx;align-items:flex-start}.shield{width:70rpx;height:70rpx;border-radius:22rpx;background:#153f34;color:#d8ff84;display:flex;align-items:center;justify-content:center;font-size:38rpx}.privacy-hero .title{font-size:34rpx}.policy-row{display:grid;grid-template-columns:145rpx 1fr;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf1ef}.policy-row:last-child{border-bottom:0}.policy-row text:first-child{font-weight:700}.policy-row text:last-child{color:#76827d;font-size:22rpx;line-height:1.55}.boundary{background:#173f34;color:#fff}.boundary-title{font-size:28rpx;font-weight:780;margin-bottom:18rpx}.boundary>view{font-size:22rpx;line-height:1.8}.boundary-foot{margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid rgba(255,255,255,.15);opacity:.7}.action-desc,.counts,.danger-desc{font-size:21rpx;line-height:1.6}.action-btn{margin:0;min-width:120rpx}.danger-zone{border:1rpx solid #f1d7d4}.danger-title{font-weight:760;color:#8c403a}.danger-btn{margin-top:24rpx;background:#fff1ef!important;color:#a7433c!important;border-radius:999rpx!important;font-size:24rpx!important}.danger-btn::after{border:none}
