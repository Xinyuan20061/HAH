.hero{padding:32rpx}.hero-title{font-size:38rpx;font-weight:760;margin:20rpx 0 12rpx}.hero-sub{font-size:23rpx;line-height:1.65;opacity:.74}.switch-row{min-height:72rpx}.label-title{font-size:27rpx;font-weight:700}.small{font-size:21rpx;line-height:1.5;margin-top:4rpx}.field+.field{margin-top:32rpx}.model-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.model-chips text,.model-chips view{font-size:20rpx;padding:12rpx 16rpx;background:#f7f7f2;color:#5f665f;border-radius:999rpx}.model-chips text.active,.model-chips view.active{background:#e9efd9;color:#111613;font-weight:650}.security{background:#f7f7f2;box-shadow:none}.security-title{font-size:26rpx;font-weight:700;color:#111613;margin-bottom:12rpx}.security-item{font-size:21rpx;color:#5f665f;line-height:1.7;margin-top:4rpx}.test{margin-top:32rpx}.save{margin-top:16rpx}.reset{text-align:center;color:#8B5555;font-size:22rpx;padding:32rpx 0}

.backend-card{margin-top:20rpx}.backend-url{max-width:470rpx;word-break:break-all;margin-top:8rpx}.backend-status{font-size:22rpx;padding:8rpx 16rpx;border-radius:999rpx;background:#f7f7f2;color:#5f665f}.backend-status.ok{background:#f7f7f2;color:#506336}.backend-status.bad{background:#fff0ee;color:#a6473b}.backend-message{margin:16rpx 0}.mini-btn{font-size:24rpx;height:72rpx;line-height:72rpx;margin:12rpx 0}.dev-box{margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid rgba(196,226,103,.08)}.dev-actions{gap:16rpx}.grow{flex:1}.tiny{font-size:20rpx;line-height:1.6;margin-top:12rpx}
