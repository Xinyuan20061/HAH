.hero{padding:34rpx}.hero-title{font-size:38rpx;font-weight:760;margin:20rpx 0 10rpx}.hero-sub{font-size:23rpx;line-height:1.65;opacity:.74}.switch-row{min-height:72rpx}.label-title{font-size:27rpx;font-weight:700}.small{font-size:21rpx;line-height:1.5;margin-top:5rpx}.field+.field{margin-top:28rpx}.model-chips{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}.model-chips text{font-size:20rpx;padding:10rpx 14rpx;background:#F0F4F2;color:#60706A;border-radius:999rpx}.model-chips text.active{background:#DDEDE6;color:#205848;font-weight:650}.security{background:#EFF5F2;box-shadow:none}.security-title{font-size:26rpx;font-weight:700;color:#275A4B;margin-bottom:12rpx}.security-item{font-size:21rpx;color:#68756F;line-height:1.7;margin-top:5rpx}.test{margin-top:30rpx}.save{margin-top:16rpx}.reset{text-align:center;color:#8B5555;font-size:22rpx;padding:28rpx 0}

.backend-card{margin-top:20rpx}.backend-url{max-width:470rpx;word-break:break-all;margin-top:6rpx}.backend-status{font-size:22rpx;padding:8rpx 16rpx;border-radius:999rpx;background:#eef2f0;color:#66756f}.backend-status.ok{background:#e7f4ed;color:#1d6a4f}.backend-status.bad{background:#fff0ee;color:#a6473b}.backend-message{margin:16rpx 0}.mini-btn{font-size:24rpx;height:72rpx;line-height:72rpx;margin:10rpx 0}.dev-box{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid rgba(20,55,45,.08)}.dev-actions{gap:16rpx}.grow{flex:1}.tiny{font-size:20rpx;line-height:1.6;margin-top:10rpx}
