.api-page{padding-top:24rpx;padding-bottom:64rpx}.grow{flex:1;min-width:0}.service-tabs{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:24rpx}.service-tab{display:flex;min-width:0;align-items:center;padding:20rpx;border:1rpx solid #eeeee6;border-radius:22rpx;background:#fff}.service-tab.active{border-color:#c4e267;background:#e9efd9}.tab-icon{display:flex;width:52rpx;height:52rpx;align-items:center;justify-content:center;flex:none;margin-right:12rpx;border-radius:50%;background:#f7f7f2}.service-tab.active .tab-icon{background:#fff}.tab-icon image{width:30rpx;height:30rpx}.tab-title{font-size:23rpx;font-weight:740}.tab-state{margin-top:4rpx;color:#5f665f;font-size:18rpx}
.config-panel,.backend-panel{padding:32rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}.panel-enter{animation:panelIn .34s cubic-bezier(.2,.8,.2,1) both}@keyframes panelIn{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:32rpx}.panel-kicker{color:#506336;font-size:18rpx;font-weight:720;letter-spacing:2rpx}.panel-title{margin-top:4rpx;font-size:32rpx;font-weight:760}.field+.field{margin-top:32rpx}.label-title{font-size:24rpx;font-weight:700}.field-state{margin-top:4rpx;color:#506336;font-size:19rpx}.input{box-sizing:border-box;width:100%;margin-top:12rpx;padding:20rpx;border-radius:18rpx;background:#f7f7f2;color:#111613;font-size:24rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.chip{padding:12rpx 16rpx;border-radius:999rpx;background:#f7f7f2;color:#5f665f;font-size:19rpx}.chip.active{background:#e9efd9;color:#111613;font-weight:700}.model-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:32rpx}.field.compact{min-width:0;margin:0}.system-chip{display:inline-flex;margin-bottom:24rpx;padding:8rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:19rpx}.actions{display:flex;gap:16rpx;margin-top:32rpx}.actions button{margin:0}.btn-soft,.btn-primary{min-height:80rpx;border:0;border-radius:20rpx;font-size:24rpx;line-height:80rpx}.btn-soft::after,.btn-primary::after{border:0}.btn-soft{background:#f7f7f2;color:#111613}.btn-primary{background:#c4e267;color:#111613}
.diagnostic{display:flex;min-height:96rpx;align-items:center;margin-top:24rpx;padding:20rpx 24rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}.diagnostic-dot{width:16rpx;height:16rpx;flex:none;margin-right:16rpx;border-radius:50%;background:#b7bcb2}.diagnostic-dot.on{background:#c4e267}.diagnostic-dot.bad{background:#c0392b}.diagnostic-title{font-size:23rpx;font-weight:720}.diagnostic-state{margin-top:4rpx;overflow:hidden;color:#5f665f;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.diagnostic-arrow{width:32rpx;height:32rpx;transition:transform .2s ease-out}.diagnostic-arrow.open{transform:rotate(90deg)}.backend-panel{margin-top:16rpx}.backend-url{color:#5f665f;font-size:19rpx;word-break:break-all}.mini{width:100%;margin:20rpx 0 0}.backend-panel .input{margin-top:20rpx}.compact-actions{margin-top:16rpx}.security-line{display:flex;align-items:center;justify-content:center;gap:8rpx;margin-top:24rpx;color:#5f665f;font-size:19rpx}.security-line image{width:28rpx;height:28rpx}.reset{padding:32rpx 0;color:#c0392b;font-size:21rpx;text-align:center}
