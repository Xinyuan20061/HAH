<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page ui-page-content">
  <view class="hero card hero-grad">
    <view class="pill pill-dark">个人服务</view>
    <view class="hero-title">使用 DeepSeek API</view>
    <view class="hero-sub">Key 仅加密保存在后端。</view>
  </view>

  <view class="card backend-card">
    <view class="row space">
      <view>
        <view class="label-title">HealthMate 后端</view>
        <view class="muted small backend-url">{{backendUrl}}</view>
      </view>
      <view class="backend-status {{backendOnline===true?'ok':backendOnline===false?'bad':''}}">
        {{backendOnline===true?'已连接':backendOnline===false?'未连接':'检测中'}}
      </view>
    </view>
    <view class="muted small backend-message">{{backendMessage}}</view>
    <button class="btn-soft mini-btn tappable" loading="{{checkingBackend}}" bindtap="checkBackend" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">检测后端连接</button>
    <view class="dev-box" wx:if="{{!cloudMode}}">
      <view class="muted small">开发/真机调试地址</view>
      <input class="input" value="{{devBackendUrl}}" bindinput="onBackendInput" placeholder="http://192.168.x.x:8000/api/v1"/>
      <view class="row dev-actions">
        <button class="btn-soft mini-btn grow tappable" bindtap="saveBackendUrl" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">使用此地址</button>
        <button class="btn-soft mini-btn grow tappable" bindtap="resetBackendUrl" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">恢复本机默认</button>
      </view>
      <view class="muted tiny">真机请填写电脑局域网 IP 或 HTTPS 地址。</view>
    </view>
    <view class="dev-box" wx:else>
      <view class="muted small">已连接微信云托管。</view>
    </view>
  </view>

  <view class="card">
    <view class="row space switch-row">
      <view>
        <view class="label-title">启用个人配置</view>
      </view>
      <switch checked="{{form.enabled}}" bindchange="toggle" color="#506336"/>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label-title">DeepSeek API Key</view>
      <view class="muted small" wx:if="{{hasKey}}">已保存 {{keyHint}}，留空则不更换。</view>
      <input class="input" password value="{{form.api_key}}" data-k="api_key" bindinput="inp" placeholder="sk-..."/>
    </view>
    <view class="field">
      <view class="label-title">Base URL</view>
      <input class="input" value="{{form.base_url}}" data-k="base_url" bindinput="inp" placeholder="https://api.deepseek.com"/>
    </view>
    <view class="field">
      <view class="label-title">服务 ID</view>
      <input class="input" value="{{form.model}}" data-k="model" bindinput="inp" placeholder="从 DeepSeek 控制台复制服务 ID"/>
      <view class="model-chips">
        <block wx:for="{{models}}" wx:key="*this">
          <view class="{{form.model==item?'active':''}} tappable" bindtap="useModel" data-model="{{item}}" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view>
        </block>
      </view>
    </view>
  </view>

  <view class="security card">
    <view class="security-title">安全设计</view>
    <view class="security-item">• Key 加密保存在后端</view>
    <view class="security-item">• 前端不显示 Key 明文</view>
  </view>

  <button class="btn-soft test tappable" loading="{{testing}}" bindtap="test" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">测试 DeepSeek 连接</button>
  <button class="btn-primary save tappable" loading="{{saving}}" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存配置</button>
  <view class="reset tappable" bindtap="reset" hover-class="tap" hover-start-time="0" hover-stay-time="80">恢复系统默认配置</view>
</view>
