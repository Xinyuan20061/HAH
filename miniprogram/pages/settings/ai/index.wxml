<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page api-page ui-page-content">
  <view class="service-tabs">
    <view class="service-tab tappable {{textActive?'active':''}}" data-section="text" bindtap="selectSection" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
      <view class="tab-icon ui-fixed-circle"><image src="/assets/icons/spark.png" mode="aspectFit"/></view><view class="grow"><view class="tab-title">文字模型</view><view class="tab-state">{{form.enabled&&hasKey?'个人配置':'系统模式'}}</view></view>
    </view>
    <view class="service-tab tappable {{voiceActive?'active':''}}" data-section="voice" bindtap="selectSection" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
      <view class="tab-icon ui-fixed-circle"><image src="/assets/icons/speaker.png" mode="aspectFit"/></view><view class="grow"><view class="tab-title">语音服务</view><view class="tab-state">{{form.voice_enabled&&hasVoiceKey?'个人配置':systemVoiceConfigured?'系统可用':'待配置'}}</view></view>
    </view>
  </view>

  <view wx:if="{{activeSection==='text'}}" class="config-panel panel-enter">
    <view class="panel-head"><view><view class="panel-kicker">TEXT MODEL</view><view class="panel-title">文字模型</view></view><switch checked="{{form.enabled}}" bindchange="toggleText" color="#506336"/></view>
    <view class="field"><view class="label-title">API Key</view><view wx:if="{{hasKey}}" class="field-state">已保存 {{keyHint}}</view><input class="input" password value="{{form.api_key}}" data-k="api_key" bindinput="inp" placeholder="sk-..."/></view>
    <view class="field"><view class="label-title">Base URL</view><input class="input" value="{{form.base_url}}" data-k="base_url" bindinput="inp" placeholder="https://api.deepseek.com"/></view>
    <view class="field"><view class="label-title">模型</view><input class="input" value="{{form.model}}" data-k="model" bindinput="inp" placeholder="deepseek-chat"/><view class="chips"><view wx:for="{{models}}" wx:key="*this" class="chip tappable {{form.model===item?'active':''}}" bindtap="useModel" data-model="{{item}}" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view></view></view>
    <view class="actions"><button class="btn-soft grow tappable" loading="{{testing}}" bindtap="testText" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">测试连接</button><button class="btn-primary grow tappable" loading="{{saving}}" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存</button></view>
  </view>

  <view wx:else class="config-panel panel-enter">
    <view class="panel-head"><view><view class="panel-kicker">VOICE</view><view class="panel-title">语音服务</view></view><switch checked="{{form.voice_enabled}}" bindchange="toggleVoice" color="#506336"/></view>
    <view wx:if="{{systemVoiceConfigured&&!hasVoiceKey}}" class="system-chip">系统语音可直接使用</view>
    <view class="field"><view class="label-title">语音 API Key</view><view wx:if="{{hasVoiceKey}}" class="field-state">已保存 {{voiceKeyHint}}</view><input class="input" password value="{{form.voice_api_key}}" data-k="voice_api_key" bindinput="inp" placeholder="留空使用系统服务"/></view>
    <view class="field"><view class="label-title">Base URL</view><input class="input" value="{{form.voice_base_url}}" data-k="voice_base_url" bindinput="inp" placeholder="OpenAI-compatible API 地址"/></view>
    <view class="model-grid"><view class="field compact"><view class="label-title">语音识别</view><input class="input" value="{{form.voice_stt_model}}" data-k="voice_stt_model" bindinput="inp" placeholder="whisper-1"/></view><view class="field compact"><view class="label-title">语音合成</view><input class="input" value="{{form.voice_tts_model}}" data-k="voice_tts_model" bindinput="inp" placeholder="tts-1"/></view></view>
    <view class="field"><view class="label-title">声音</view><input class="input" value="{{form.voice_name}}" data-k="voice_name" bindinput="inp" placeholder="alloy"/><view class="chips"><view wx:for="{{voices}}" wx:key="*this" class="chip tappable {{form.voice_name===item?'active':''}}" bindtap="useVoice" data-voice="{{item}}" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view></view></view>
    <view class="actions"><button class="btn-soft grow tappable" loading="{{testingVoice}}" bindtap="testVoice" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">测试语音</button><button class="btn-primary grow tappable" loading="{{saving}}" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存</button></view>
  </view>

  <view class="diagnostic tappable" bindtap="toggleBackend" hover-class="tap-card" hover-start-time="0" hover-stay-time="80"><view class="diagnostic-dot {{backendOnline===true?'on':backendOnline===false?'bad':''}}"></view><view class="grow"><view class="diagnostic-title">后端连接</view><view class="diagnostic-state">{{backendMessage}}</view></view><image class="diagnostic-arrow {{backendExpanded?'open':''}}" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
  <view wx:if="{{backendExpanded}}" class="backend-panel panel-enter">
    <view class="backend-url">{{backendUrl}}</view><button class="btn-soft mini tappable" loading="{{checkingBackend}}" bindtap="checkBackend" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">重新检测</button>
    <block wx:if="{{!cloudMode}}"><input class="input" value="{{devBackendUrl}}" bindinput="onBackendInput" placeholder="开发环境 API 地址"/><view class="actions compact-actions"><button class="btn-soft grow tappable" bindtap="saveBackendUrl" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">使用地址</button><button class="btn-soft grow tappable" bindtap="resetBackendUrl" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">恢复默认</button></view></block>
  </view>

  <view class="security-line"><image src="/assets/icons/shield.png" mode="aspectFit"/><text>密钥加密保存在后端</text></view>
  <view class="reset tappable" bindtap="reset" hover-class="tap" hover-start-time="0" hover-stay-time="80">恢复系统模式</view>
</view>
