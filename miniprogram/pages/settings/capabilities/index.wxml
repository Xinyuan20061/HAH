<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page capability-page ui-page-content">
  <view class="capability-head">
    <view class="eyebrow">YOUR HEALTH CAPABILITIES</view>
    <view class="page-title">健康能力</view>
    <view class="intro">把想要的帮助方式调成适合你的样子。每项能力只使用你明确允许的数据，可以随时开启或关闭。</view>
  </view>

  <view wx:if="{{loading}}" class="state-card"><view class="state-spinner"></view><view class="state-title">正在读取健康能力</view></view>
  <view wx:elif="{{error}}" class="state-card state-card-error"><view class="grow"><view class="state-title">能力列表没有加载出来</view><view class="state-desc">{{error}}</view></view><button class="retry-btn tappable" bindtap="retry" hover-class="tap-btn">重试</button></view>
  <view wx:else>
    <view id="capability-{{plugin.plugin_id}}" wx:for="{{plugins}}" wx:for-item="plugin" wx:key="plugin_id" class="capability-card {{plugin.enabled?'enabled':'paused'}}">
      <view class="capability-top">
        <view class="capability-mark">{{plugin.enabled?'✓':plugin.installation_id?'·':'+'}}</view>
        <view class="grow"><view class="capability-title">{{plugin.title}}</view><view class="capability-summary">{{plugin.summary}}</view></view>
        <view class="state-pill {{plugin.enabled?'state-on':''}}">{{plugin.enabled?'使用中':plugin.manifest_reconsent_required?'需重新确认':plugin.installation_id?'已关闭':'未开启'}}</view>
      </view>
      <view class="capability-value">{{plugin.user_value}}</view>
      <view class="privacy-note">{{plugin.privacy_summary}}</view>
      <view class="manifest-note">审核版本 {{plugin.version}} · 不执行用户上传代码</view>

      <view class="card-actions">
        <button class="secondary-btn tappable" data-plugin="{{plugin.plugin_id}}" bindtap="openConfig" hover-class="tap">{{plugin.expanded?'收起设置':'设置'}}</button>
        <button wx:if="{{plugin.enabled}}" class="pause-btn tappable" data-plugin="{{plugin.plugin_id}}" bindtap="toggle" loading="{{busy===plugin.plugin_id}}" hover-class="tap">关闭</button>
        <button wx:else class="enable-btn tappable" data-plugin="{{plugin.plugin_id}}" bindtap="toggle" loading="{{busy===plugin.plugin_id}}" hover-class="tap-btn">开启</button>
      </view>

      <view wx:if="{{plugin.expanded}}" class="config-panel">
        <view class="panel-heading">希望它优先帮你</view>
        <view class="choice-list">
          <view wx:for="{{plugin.config_schema.goals}}" wx:for-item="choice" wx:key="id" class="choice-row {{plugin.config.goal===choice.id?'choice-selected':''}} tappable" data-plugin="{{plugin.plugin_id}}" data-field="goal" data-value="{{choice.id}}" bindtap="changeChoice" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
            <view class="choice-dot">{{plugin.config.goal===choice.id?'✓':''}}</view><text>{{choice.label}}</text>
          </view>
        </view>

        <view class="panel-heading source-heading">允许使用的数据</view>
        <view class="scope-list">
          <view wx:for="{{plugin.scope_options}}" wx:for-item="scope" wx:key="id" class="scope-row tappable" data-plugin="{{plugin.plugin_id}}" data-scope="{{scope.id}}" bindtap="changeScope" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
            <view class="scope-check {{scope.selected?'scope-checked':''}}">{{scope.selected?'✓':''}}</view>
            <view class="scope-label">{{scope.label}}</view><view class="scope-state">{{scope.selected?'允许':'不使用'}}</view>
          </view>
        </view>
        <view class="scope-footnote">未勾选的数据不会提供给这项能力；授权不能超出审核范围。</view>

        <view class="panel-heading source-heading">回答方式</view>
        <view class="option-row">
          <view wx:for="{{plugin.config_schema.output_styles}}" wx:for-item="choice" wx:key="id" class="option-chip {{plugin.config.output_style===choice.id?'option-selected':''}} tappable" data-plugin="{{plugin.plugin_id}}" data-field="output_style" data-value="{{choice.id}}" bindtap="changeChoice" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80">{{choice.label}}</view>
        </view>
        <view class="setting-row"><view><view class="setting-title">触发时机</view><view class="setting-desc">{{plugin.config_schema.triggers[0].label}}</view></view><view class="fixed-tag">按需</view></view>
        <view class="setting-row"><view><view class="setting-title">提醒偏好</view><view class="setting-desc">按需提示只会出现在相关对话中；不会发送后台通知。</view></view></view>
        <view class="option-row frequency-row">
          <view wx:for="{{plugin.config_schema.notification_frequencies}}" wx:for-item="choice" wx:key="id" class="option-chip {{plugin.config.notification_frequency===choice.id?'option-selected':''}} tappable" data-plugin="{{plugin.plugin_id}}" data-field="notification_frequency" data-value="{{choice.id}}" bindtap="changeChoice" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80">{{choice.label}}</view>
        </view>

        <view wx:if="{{plugin.safety.may_propose_action}}" class="proposal-setting tappable" data-plugin="{{plugin.plugin_id}}" bindtap="changeProposal" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80">
          <view class="proposal-check {{plugin.config.allow_action_proposals?'proposal-checked':''}}">{{plugin.config.allow_action_proposals?'✓':''}}</view>
          <view class="grow"><view class="setting-title">允许提出行动申请</view><view class="setting-desc">开启后也只会生成待你确认的申请，不会自动执行。</view></view>
        </view>
        <view wx:else class="setting-desc proposal-unavailable">这项能力只提供只读建议，不提出行动申请。</view>

        <button wx:if="{{!plugin.enabled}}" class="enable-wide tappable" data-plugin="{{plugin.plugin_id}}" bindtap="toggle" loading="{{busy===plugin.plugin_id}}" hover-class="tap-btn">开启这项能力</button>
        <view wx:if="{{plugin.enabled}}" class="enabled-note">已开启 · 仍按上方授权范围工作；所有写入仍需你确认。<text wx:if="{{plugin.last_run_at}}"> 最近使用：{{plugin.last_run_at}}</text></view>
        <view wx:if="{{plugin.last_error}}" class="error-note">{{plugin.last_error}}</view>
        <view wx:elif="{{plugin.installation_id}}" class="paused-note">已关闭 · 历史记录保留，可随时重新开启。</view>

        <view class="management-row">
          <view class="audit-link tappable tappable" data-plugin="{{plugin.plugin_id}}" bindtap="showAudit" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80">{{plugin.show_audit?'收起使用记录':'查看使用记录'}}</view>
          <view wx:if="{{plugin.installation_id}}" class="delete-link tappable tappable" data-plugin="{{plugin.plugin_id}}" bindtap="remove" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80">删除能力配置</view>
        </view>
        <view wx:if="{{plugin.show_audit}}" class="audit-list">
          <view wx:if="{{!plugin.audit.length}}" class="audit-empty">还没有使用记录。</view>
          <view wx:for="{{plugin.audit}}" wx:for-item="event" wx:key="at" class="audit-row"><view class="audit-event">{{event.label}}</view><view class="audit-time">{{event.at}}</view><view wx:if="{{event.summary}}" class="audit-summary">{{event.summary}}</view></view>
        </view>
      </view>
    </view>
    <view class="bottom-note">HealthMate 提供一般健康参考，不替代医生诊断。能力只使用你明确允许的数据；未验证的信息会说明限制。</view>
  </view>
</view>
