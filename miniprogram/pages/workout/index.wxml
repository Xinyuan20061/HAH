<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page ui-page-content"><view class="work-hero"><view class="kicker">个性化训练</view><view class="title">从这周能做到的开始</view></view><view class="builder card"><view class="label">训练目标</view><view class="chips"><view wx:for="{{goals}}" wx:key="*this" data-v="{{item}}" bindtap="pickGoal" class="{{item===goal?'on':''}} tappable" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view></view><view class="label">训练水平</view><view class="chips"><view wx:for="{{levels}}" wx:key="*this" data-v="{{item}}" bindtap="pickLevel" class="{{item===level?'on':''}} tappable" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view></view><view class="label">可用器械</view><view class="chips"><view wx:for="{{equipments}}" wx:key="*this" data-v="{{item}}" bindtap="pickEquipment" class="{{item===equipment?'on':''}} tappable" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item}}</view></view><view class="slider-row"><view><text class="b">每周 {{days}} 天</text><text class="small">训练频率</text></view><slider min="2" max="6" value="{{days}}" bindchange="days" activeColor="#506336" block-color="#506336"/></view><view class="slider-row"><view><text class="b">{{minutes}} 分钟</text><text class="small">单次时长</text></view><slider min="20" max="75" step="5" value="{{minutes}}" bindchange="minutes" activeColor="#506336" block-color="#506336"/></view><button class="generate-btn tappable" bindtap="generate" loading="{{loading}}" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">{{loading?'正在生成你的计划…':'生成我的一周计划'}}</button></view><view wx:if="{{plan}}" class="plan"><view class="plan-head"><view class="pill">{{plan.provider}}</view><view class="plan-title">{{plan.title}}</view><view class="subtitle">{{plan.summary}}</view></view><view wx:for="{{plan.days}}" wx:key="index" class="day card"><view class="day-head"><view><text class="b">{{item.day}}</text><text class="small">{{item.focus}}</text></view><text>{{item.duration}} min</text></view><view wx:for="{{item.exercises}}" wx:key="index" class="exercise tappable" bindtap="openExercise" data-name="{{item.name}}" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view><text class="b">{{item.name}}</text><text class="small">{{item.sets}} · {{item.reps}}</text></view><view class="exercise-side"><text>休 {{item.rest}}</text><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view></view></view><view class="tips card"><text class="b">训练提醒</text><view wx:for="{{plan.tips}}" wx:key="*this">· {{item}}</view></view></view></view>
