.work-hero{padding:12rpx 6rpx 28rpx}.kicker{font-size:20rpx;color:#2d735f;letter-spacing:3rpx;font-weight:800}.title{font-size:45rpx;font-weight:800;line-height:1.25;margin:14rpx 0}.builder{padding:30rpx}.label{font-weight:700;font-size:24rpx;margin:20rpx 0 14rpx}.label:first-child{margin-top:0}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips text{padding:13rpx 19rpx;border-radius:999rpx;background:#f1f5f3;color:#69766f;font-size:22rpx}.chips text.on{background:#183f34;color:white}.slider-row{margin-top:26rpx;border-top:1rpx solid #edf1ef;padding-top:24rpx}.slider-row>view{display:flex;justify-content:space-between;align-items:center}.slider-row .b{font-size:27rpx}.slider-row .small{font-size:20rpx;color:#8a9590}.generate-btn{height:92rpx;border-radius:28rpx;background:#d8ff83;color:#173d32;font-weight:800;margin-top:28rpx}.generate-btn::after{border:none}.plan-head{padding:20rpx 6rpx 14rpx}.plan-title{font-size:36rpx;font-weight:800;margin:14rpx 0}.day-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:15rpx}.day-head .b,.day-head .small{display:block}.day-head .b{font-size:29rpx}.day-head .small{font-size:21rpx;color:#87928d;margin-top:4rpx}.day-head>text{font-size:21rpx;background:#edf4f1;padding:9rpx 14rpx;border-radius:999rpx}.exercise{display:flex;justify-content:space-between;align-items:center;padding:19rpx 0;border-top:1rpx solid #edf1ef}.exercise .b,.exercise .small{display:block}.exercise .b{font-size:25rpx}.exercise .small,.exercise>text{font-size:20rpx;color:#87928d;margin-top:5rpx}.tips{background:#173f34;color:#fff;line-height:1.8;font-size:23rpx}.tips .b{display:block;font-size:27rpx;margin-bottom:8rpx}

.exercise{transition:background .2s}.exercise:active{background:#f5f8f6}.detail-go{font-size:28rpx;color:#2f745f;margin-left:6rpx}.plan{animation:planIn .38s ease-out}@keyframes planIn{from{opacity:.2;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}
