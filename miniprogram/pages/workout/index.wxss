.work-hero{padding:12rpx 8rpx 32rpx}.kicker{font-size:20rpx;color:#506336;letter-spacing:3rpx;font-weight:800}.title{font-size:45rpx;font-weight:800;line-height:1.25;margin:16rpx 0}.builder{padding:32rpx}.label{font-weight:700;font-size:24rpx;margin:20rpx 0 16rpx}.label:first-child{margin-top:0}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips text,.chips view{padding:12rpx 20rpx;border-radius:999rpx;background:#f7f7f2;color:#5f665f;font-size:22rpx;transform:scale(1);box-shadow:0 0 0 rgba(196,226,103,0);transition:opacity .16s ease-out,padding .34s cubic-bezier(.34,1.56,.64,1),transform .34s cubic-bezier(.34,1.56,.64,1),background-color .22s ease-out,box-shadow .3s ease-out}.chips text.on,.chips view.on{padding:12rpx 32rpx;background:#c4e267;color:#111613;transform:scale(1.04);box-shadow:0 6rpx 18rpx rgba(196,226,103,.45)}.slider-row{margin-top:24rpx;border-top:1rpx solid #eeeee6;padding-top:24rpx}.slider-row>view{display:flex;justify-content:space-between;align-items:center}.slider-row .b{font-size:27rpx}.slider-row .small{font-size:20rpx;color:#5f665f}.generate-btn{height:92rpx;border-radius:28rpx;background:#c4e267;color:#111613;font-weight:800;margin-top:32rpx}.generate-btn::after{border:none}.plan-head{padding:20rpx 8rpx 16rpx}.plan-title{font-size:36rpx;font-weight:800;margin:16rpx 0}.day-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.day-head .b,.day-head .small{display:block}.day-head .b{font-size:29rpx}.day-head .small{font-size:21rpx;color:#5f665f;margin-top:4rpx}.day-head>text{font-size:21rpx;background:#f7f7f2;padding:8rpx 16rpx;border-radius:999rpx}.exercise{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-top:1rpx solid #eeeee6}.exercise .b,.exercise .small{display:block}.exercise .b{font-size:25rpx}.exercise .small,.exercise>text{font-size:20rpx;color:#5f665f;margin-top:4rpx}.tips{background:#111613;color:#fff;line-height:1.8;font-size:23rpx}.tips .b{display:block;font-size:27rpx;margin-bottom:8rpx}

.exercise{transition:background .2s}.exercise:active{background:#f7f7f2}.detail-go{font-size:28rpx;color:#506336;margin-left:8rpx}.plan{animation:planIn .38s ease-out}@keyframes planIn{from{opacity:.2;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}
