.eval-page{background:linear-gradient(#eff5f2 0,#f6f8f7 420rpx)}.hero{margin-top:6rpx;padding:34rpx}.kicker{font-size:19rpx;font-weight:800;letter-spacing:3rpx;color:#d7ff84}.hero-title{font-size:40rpx;font-weight:800;line-height:1.25;margin:14rpx 0}.hero-sub{font-size:22rpx;line-height:1.7;opacity:.78}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.metric-card{background:#fff;border-radius:26rpx;padding:24rpx;min-height:145rpx;box-sizing:border-box}.metric-label{font-size:21rpx;color:#71807a}.metric-value{font-size:34rpx;font-weight:800;margin-top:13rpx}.empty-value{font-size:27rpx;color:#9aa5a0}.metric-sample{font-size:18rpx;color:#9aa5a0;margin-top:8rpx}.bench{padding:22rpx 0;border-bottom:1rpx solid #eef1ef}.bench:last-child{border-bottom:0}.bench-name{font-weight:720}.bench-value{font-size:34rpx;font-weight:800;color:#285b4c}.bench-note{margin-top:10rpx;font-size:21rpx;color:#77837e;line-height:1.6}.evidence-row{font-size:22rpx;color:#697670;line-height:1.7;margin-top:10rpx}.compact{font-size:22rpx;margin:0}
.agent-overview{display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden;border:1rpx solid #e2e8e4;border-radius:22rpx;background:#173f35;color:#fff}.agent-overview view{padding:24rpx 12rpx;text-align:center}.agent-overview view+view{border-left:1rpx solid rgba(255,255,255,.12)}.agent-overview text,.agent-overview b{display:block}.agent-overview text{color:rgba(255,255,255,.62);font-size:18rpx}.agent-overview b{margin-top:10rpx;font-size:25rpx}.agent-distributions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:16rpx}.distribution-card{padding:22rpx;border:1rpx solid #e4e7e4;border-radius:20rpx;background:#fff}.dist-title{margin-bottom:12rpx;font-size:22rpx;font-weight:700}.dist-row{display:flex;justify-content:space-between;padding:10rpx 0;border-top:1rpx solid #eff1ef;color:#6c7872;font-size:19rpx}.dist-row b{color:#284f44;font-weight:700}.dist-empty{padding:18rpx 0;color:#99a19d;font-size:19rpx}.agent-note{margin-top:14rpx;color:#7e8983;font-size:19rpx;line-height:1.55}
.feedback-evidence{margin-top:18rpx;padding:24rpx;border:1rpx solid #dfe7e2;border-radius:22rpx;background:#fff}.feedback-evidence-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.feedback-evidence-sub{color:#87918c;font-size:18rpx}.feedback-rate{text-align:right}.feedback-rate b,.feedback-rate text{display:block}.feedback-rate b{color:#2c6755;font-size:31rpx}.feedback-rate text{margin-top:2rpx;color:#8a938e;font-size:17rpx}.feedback-summary{display:flex;gap:22rpx;margin-top:20rpx;padding:15rpx 18rpx;border-radius:14rpx;color:#53645d;background:#eff4f1;font-size:19rpx}.feedback-bars{margin-top:12rpx}
