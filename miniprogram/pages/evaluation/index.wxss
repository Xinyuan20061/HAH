.eval-page{background:linear-gradient(#f7f7f2 0,#f7f7f2 420rpx)}.hero{margin-top:8rpx;padding:32rpx}.kicker{font-size:19rpx;font-weight:800;letter-spacing:3rpx;color:#c4e267}.hero-title{font-size:40rpx;font-weight:800;line-height:1.25;margin:16rpx 0}.hero-sub{font-size:22rpx;line-height:1.7;opacity:.78}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.metric-card{background:#fff;border-radius:26rpx;padding:24rpx;min-height:145rpx;box-sizing:border-box}.metric-label{font-size:21rpx;color:#5f665f}.metric-value{font-size:34rpx;font-weight:800;margin-top:12rpx}.empty-value{font-size:27rpx;color:#506336}.metric-sample{font-size:18rpx;color:#506336;margin-top:8rpx}.bench{padding:24rpx 0;border-bottom:1rpx solid #eeeee6}.bench:last-child{border-bottom:0}.bench-name{font-weight:720}.bench-value{font-size:34rpx;font-weight:800;color:#111613}.bench-note{margin-top:12rpx;font-size:21rpx;color:#5f665f;line-height:1.6}.evidence-row{font-size:22rpx;color:#5f665f;line-height:1.7;margin-top:12rpx}.compact{font-size:22rpx;margin:0}
.agent-overview{display:grid;grid-template-columns:repeat(3,1fr);overflow:hidden;border:1rpx solid #e9efd9;border-radius:22rpx;background:#111613;color:#fff}.agent-overview view{padding:24rpx 12rpx;text-align:center}.agent-overview view+view{border-left:1rpx solid rgba(255,255,255,.12)}.agent-overview text,.agent-overview b{display:block}.agent-overview text{color:rgba(255,255,255,.62);font-size:18rpx}.agent-overview b{margin-top:12rpx;font-size:25rpx}.agent-distributions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:16rpx}.distribution-card{padding:24rpx;border:1rpx solid #e9efd9;border-radius:20rpx;background:#fff}.dist-title{margin-bottom:12rpx;font-size:22rpx;font-weight:700}.dist-row{display:flex;justify-content:space-between;padding:12rpx 0;border-top:1rpx solid #eeeee6;color:#5f665f;font-size:19rpx}.dist-row b{color:#111613;font-weight:700}.dist-empty{padding:20rpx 0;color:#506336;font-size:19rpx}.agent-note{margin-top:16rpx;color:#5f665f;font-size:19rpx;line-height:1.55}
.feedback-evidence{margin-top:20rpx;padding:24rpx;border:1rpx solid #e9efd9;border-radius:22rpx;background:#fff}.feedback-evidence-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.feedback-evidence-sub{color:#5f665f;font-size:18rpx}.feedback-rate{text-align:right}.feedback-rate b,.feedback-rate text{display:block}.feedback-rate b{color:#506336;font-size:31rpx}.feedback-rate text{margin-top:4rpx;color:#5f665f;font-size:17rpx}.feedback-summary{display:flex;gap:24rpx;margin-top:20rpx;padding:16rpx 20rpx;border-radius:14rpx;color:#506336;background:#f7f7f2;font-size:19rpx}.feedback-bars{margin-top:12rpx}
