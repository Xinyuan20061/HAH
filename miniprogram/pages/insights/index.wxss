.insights-page { min-height: 100vh; padding: 28rpx 28rpx 70rpx; box-sizing: border-box; background: #f5f4ef; }
.insight-hero { position: relative; overflow: hidden; padding: 32rpx; border-radius: 28rpx; color: #f8f7f2; background: #173f35; }
.insight-hero::after { content: ''; position: absolute; right: -96rpx; bottom: -120rpx; width: 330rpx; height: 330rpx; border: 1rpx solid rgba(255,255,255,.13); border-radius: 50%; box-shadow: 0 0 0 48rpx rgba(255,255,255,.025), 0 0 0 96rpx rgba(255,255,255,.018); }
.hero-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
.hero-kicker { color: rgba(255,255,255,.68); font-size: 21rpx; letter-spacing: 3rpx; }
.live-dot { display: flex; align-items: center; gap: 9rpx; color: rgba(255,255,255,.68); font-size: 19rpx; }
.live-dot text { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8bd4b8; box-shadow: 0 0 0 6rpx rgba(139,212,184,.12); }
.hero-title { position: relative; z-index: 1; width: 88%; margin-top: 55rpx; font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.hero-copy { position: relative; z-index: 1; width: 84%; margin-top: 20rpx; color: rgba(255,255,255,.7); font-size: 23rpx; line-height: 1.65; }
.quality-panel { position: relative; z-index: 1; width: 72%; margin-top: 28rpx; }
.quality-row { display: flex; justify-content: space-between; color: rgba(255,255,255,.62); font-size: 18rpx; }
.quality-track { height: 7rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.13); }
.quality-track view { height: 100%; border-radius: inherit; background: #9ed8c0; }
.hero-time { position: relative; z-index: 1; margin-top: 22rpx; color: rgba(255,255,255,.48); font-size: 19rpx; }
.loading-stack { margin-top: 24rpx; }
.skeleton-card { height: 390rpx; margin-bottom: 18rpx; border-radius: 24rpx; background: linear-gradient(90deg,#e6e4dd 25%,#f3f2ed 37%,#e6e4dd 63%); background-size: 400% 100%; animation: move 1.4s ease infinite; }
.skeleton-card.short { height: 250rpx; }
@keyframes move { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.insight-state { margin-top: 24rpx; padding: 52rpx 34rpx; border: 1rpx solid #e1dfd7; border-radius: 24rpx; text-align: center; background: #fff; }
.state-symbol,.clear-ring { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: auto; border-radius: 50%; font-size: 38rpx; }
.state-symbol { color: #9b5143; background: #f5e9e5; }
.clear-ring { color: #2d6d59; background: #e5f0ea; }
.state-title { margin-top: 24rpx; font-size: 28rpx; font-weight: 680; }
.state-copy { margin-top: 12rpx; color: #7b8580; font-size: 22rpx; line-height: 1.65; }
.insight-state button { width: 250rpx; margin-top: 28rpx; border: 0; border-radius: 17rpx; color: #fff; background: #173f35; font-size: 24rpx; }
.list-heading { margin: 38rpx 2rpx 18rpx; }
.list-title { font-size: 31rpx; font-weight: 690; }
.list-summary { margin-top: 8rpx; color: #818984; font-size: 21rpx; line-height: 1.55; }
.insight-card { position: relative; overflow: hidden; margin-bottom: 18rpx; padding: 28rpx; border: 1rpx solid #e4e1d9; border-radius: 24rpx; background: #fff; }
.insight-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 7rpx; background: #4e806f; }
.tone-amber::before { background: #b48645; }.tone-violet::before { background: #776a91; }.tone-blue::before { background: #527c91; }.tone-rose::before { background: #9a675f; }
.card-head { display: flex; align-items: center; justify-content: space-between; }
.topic-pill { padding: 8rpx 14rpx; border-radius: 999rpx; color: #315d50; background: #e9f0ec; font-size: 19rpx; }
.severity { color: #8a918d; font-size: 20rpx; }
.card-title { margin-top: 24rpx; color: #1d2924; font-size: 32rpx; font-weight: 690; line-height: 1.4; }
.evidence-block,.advice-block { margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 17rpx; color: #59655f; background: #f6f5f0; font-size: 22rpx; line-height: 1.65; }
.advice-block { color: #35584e; background: #edf3ef; }
.block-label { margin-bottom: 6rpx; color: #8b928e; font-size: 18rpx; letter-spacing: 2rpx; }
.advice-block .block-label { color: #658076; }
.card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.card-actions button { min-height: 80rpx; margin: 0; border-radius: 16rpx; font-size: 23rpx; }
.card-actions button::after { border: 0; }
.action-primary { color: #fff; background: #173f35; }
.action-link { color: #315e51; background: #e8efeb; }
.feedback-panel { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #eceae4; }
.feedback-question { color: #727d77; font-size: 20rpx; }
.feedback-actions { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; margin-top: 14rpx; }
.feedback-actions button { min-height: 62rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid #dfe3df; border-radius: 14rpx; color: #52635c; background: #fafaf7; font-size: 19rpx; line-height: 62rpx; }
.feedback-actions button::after { border: 0; }
.feedback-done { color: #356454; font-size: 20rpx; }
.feedback-done > text { margin-right: 8rpx; }
.feedback-done > view { margin-top: 6rpx; color: #909792; font-size: 17rpx; }
.boundary-card { margin-top: 26rpx; padding: 24rpx 26rpx; border: 1rpx solid #dedcd4; border-radius: 20rpx; color: #78817c; background: rgba(255,255,255,.55); font-size: 20rpx; line-height: 1.65; }
.boundary-title { margin-bottom: 8rpx; color: #56635d; font-size: 22rpx; font-weight: 650; }
.quality-message { margin-bottom: 10rpx; color: #53655d; }
.feedback-policy { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx solid #e2e0d8; }
.experiment-live { margin-top: 22rpx; padding: 28rpx; border-radius: 24rpx; color: #f7faf8; background: linear-gradient(145deg,#173f35,#285f50); box-shadow: 0 14rpx 34rpx rgba(23,63,53,.16); }
.experiment-live-head { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }
.experiment-kicker { color:#8fc8b4; font-size:17rpx; font-weight:800; letter-spacing:2rpx; }
.experiment-title { margin-top:8rpx; font-size:28rpx; font-weight:800; }
.experiment-status { flex:none; padding:7rpx 13rpx; border-radius:999rpx; color:#173f35; background:#cceadd; font-size:18rpx; font-weight:750; }
.experiment-hypothesis { margin-top:16rpx; color:rgba(255,255,255,.76); font-size:20rpx; line-height:1.65; }
.experiment-action { margin-top:18rpx; padding:18rpx; border:1rpx solid rgba(255,255,255,.14); border-radius:16rpx; background:rgba(255,255,255,.08); font-size:21rpx; line-height:1.6; }
.experiment-action .block-label { color:#a5d5c5; }
.experiment-progress-head,.experiment-meta { display:flex; justify-content:space-between; gap:15rpx; margin-top:17rpx; color:rgba(255,255,255,.72); font-size:18rpx; }
.experiment-track { overflow:hidden; height:10rpx; margin-top:9rpx; border-radius:999rpx; background:rgba(255,255,255,.13); }
.experiment-track view { height:100%; border-radius:999rpx; background:#9bd8c2; }
.experiment-controls { display:flex; gap:12rpx; margin-top:20rpx; }
.experiment-controls button { margin:0; border-radius:15rpx; font-size:20rpx; }
.experiment-controls button::after { border:0; }
.review-button { flex:1; color:#173f35; background:#d5eee5; }
.stop-button { width:150rpx; color:rgba(255,255,255,.75); background:rgba(255,255,255,.1); }
.experiment-boundary { margin-top:15rpx; color:rgba(255,255,255,.52); font-size:17rpx; line-height:1.55; }
.experiment-proposal { margin-top:22rpx; padding:22rpx; border:1rpx solid #dce7e1; border-radius:19rpx; background:#f3f8f5; }
.experiment-proposal .experiment-kicker { color:#417361; }
.proposal-title { margin-top:7rpx; color:#244b3e; font-size:24rpx; font-weight:800; }
.proposal-hypothesis { margin-top:10rpx; color:#61736b; font-size:19rpx; line-height:1.6; }
.proposal-history { margin-top:10rpx; padding:10rpx 14rpx; border-radius:13rpx; color:#4d6b60; background:#e7f0eb; font-size:18rpx; line-height:1.55; }
.proposal-variants { display:grid; grid-template-columns:1fr 1fr; gap:12rpx; margin-top:16rpx; }
.variant-card { padding:16rpx; border:1rpx solid #dbe5df; border-radius:16rpx; background:#fff; }
.variant-head { display:flex; justify-content:space-between; align-items:center; color:#315d4e; font-size:19rpx; }
.variant-head b { font-size:21rpx; }
.variant-action { min-height:94rpx; margin-top:10rpx; color:#6a7872; font-size:18rpx; line-height:1.5; }
.variant-card button { min-height:58rpx; margin:12rpx 0 0; padding:0 8rpx; border-radius:13rpx; color:#fff; background:#356957; font-size:18rpx; line-height:58rpx; }
.variant-card button::after { border:0; }
.proposal-boundary { margin-top:12rpx; color:#829089; font-size:17rpx; line-height:1.55; }
