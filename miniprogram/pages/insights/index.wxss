.insights-page {min-height: 100vh;padding: 32rpx 32rpx 70rpx;box-sizing: border-box;background: #f7f7f2; }
.insight-hero {position: relative;overflow: hidden;padding: 32rpx;border-radius: 28rpx;color: #f8f7f2;background: #111613; }
.insight-hero::after {content: '';position: absolute;right: -96rpx;bottom: -120rpx;width: 330rpx;height: 330rpx;border: 1rpx solid rgba(255,255,255,.13);border-radius: 50%;box-shadow: 0 0 0 48rpx rgba(255,255,255,.025), 0 0 0 96rpx rgba(255,255,255,.018); }
.hero-top {position: relative;z-index: 1;display: flex;align-items: center;justify-content: space-between; }
.hero-kicker {color: rgba(255,255,255,.68);font-size: 21rpx;letter-spacing: 3rpx; }
.live-dot {display: flex;align-items: center;gap: 8rpx;color: rgba(255,255,255,.68);font-size: 19rpx; }
.live-dot text {width: 10rpx;height: 10rpx;border-radius: 50%;background: #e9efd9;box-shadow: 0 0 0 6rpx rgba(139,212,184,.12); }
.hero-title {position: relative;z-index: 1;width: 88%;margin-top: 55rpx;font-size: 44rpx;font-weight: 700;line-height: 1.3; }
.hero-copy {position: relative;z-index: 1;width: 84%;margin-top: 20rpx;color: rgba(255,255,255,.7);font-size: 23rpx;line-height: 1.65; }
.quality-panel {position: relative;z-index: 1;width: 72%;margin-top: 32rpx; }
.quality-row {display: flex;justify-content: space-between;color: rgba(255,255,255,.62);font-size: 18rpx; }
.quality-track {height: 7rpx;margin-top: 12rpx;overflow: hidden;border-radius: 999rpx;background: rgba(255,255,255,.13); }
.quality-track view {height: 100%;border-radius: inherit;background: #e9efd9; }
.hero-time {position: relative;z-index: 1;margin-top: 24rpx;color: rgba(255,255,255,.48);font-size: 19rpx; }
.loading-stack {margin-top: 24rpx; }
.skeleton-card {height: 390rpx;margin-bottom: 24rpx;border-radius: 24rpx;background: linear-gradient(90deg,#eeeee6 25%,#f7f7f2 37%,#eeeee6 63%);background-size: 400% 100%;animation: move 1.4s ease infinite; }
.skeleton-card.short {height: 250rpx; }
@keyframes move { 0% {background-position: 100% 0; } 100% {background-position: 0 0; } }
.insight-state {margin-top: 24rpx;padding: 52rpx 32rpx;border: 1rpx solid #eeeee6;border-radius: 24rpx;text-align: center;background: #fff; }
.state-symbol,.clear-ring {display: flex;align-items: center;justify-content: center;width: 72rpx;height: 72rpx;margin: auto;border-radius: 50%;font-size: 38rpx; }
.state-symbol {color: #9b5143;background: #eeeee6; }
.clear-ring {color: #506336;background: #e9efd9; }
.clear-ring image {width: 40rpx;height: 40rpx; }
.state-title {margin-top: 24rpx;font-size: 28rpx;font-weight: 680; }
.state-copy {margin-top: 12rpx;color: #5f665f;font-size: 22rpx;line-height: 1.65; }
.insight-state button {width: 250rpx;margin-top: 32rpx;border: 0;border-radius: 17rpx;color:#111613;background: #c4e267;font-size: 24rpx; }
.list-heading {margin: 40rpx 4rpx 20rpx; }
.list-title {font-size: 31rpx;font-weight: 690; }
.list-summary {margin-top: 8rpx;color: #5f665f;font-size: 21rpx;line-height: 1.55; }
.insight-card {position: relative;overflow: hidden;margin-bottom: 24rpx;padding: 32rpx;border: 1rpx solid #eeeee6;border-radius: 24rpx;background: #fff; }
.insight-card::before {content: '';position: absolute;left: 0;top: 0;bottom: 0;width: 7rpx;background: #c4e267; }
.tone-amber::before {background: #b48645; }.tone-violet::before {background: #776a91; }.tone-blue::before {background: #527c91; }.tone-rose::before {background: #9a675f; }
.card-head {display: flex;align-items: center;justify-content: space-between; }
.topic-pill {padding: 8rpx 16rpx;border-radius: 999rpx;color: #506336;background: #e9efd9;font-size: 19rpx; }
.severity {color: #5f665f;font-size: 20rpx; }
.card-title {margin-top: 24rpx;color: #111613;font-size: 32rpx;font-weight: 690;line-height: 1.4; }
.evidence-block,.advice-block {margin-top: 24rpx;padding: 20rpx 24rpx;border-radius: 17rpx;color: #5f665f;background: #f7f7f2;font-size: 22rpx;line-height: 1.65; }
.advice-block {color: #111613;background: #f7f7f2; }
.basis-block {margin-top: 24rpx;padding: 20rpx 24rpx;border-radius: 17rpx;color: #5f665f;background: #f2f4ec;font-size: 21rpx;line-height: 1.6; }
.basis-fact {display: flex;justify-content: space-between;gap: 16rpx;margin-top: 8rpx; }
.basis-coverage {margin-top: 12rpx;color: #506336;font-size: 20rpx; }
.basis-limits {margin-top: 12rpx;padding-top: 12rpx;border-top: 1rpx dashed #d7dcc9; }
.basis-limit {margin-top: 8rpx;color: #7c8273;font-size: 20rpx; }
.action-timeline {margin-top: 24rpx;padding: 20rpx 24rpx;border-radius: 17rpx;background: #f7f7f2;font-size: 21rpx; }
.timeline-item {margin-top: 12rpx; }
.timeline-row {display: flex;align-items: center;justify-content: space-between;color: #111613; }
.timeline-status {color: #506336;font-size: 19rpx; }
.timeline-date {margin-top: 4rpx;color: #7c8273;font-size: 19rpx; }
.timeline-outcome {margin-top: 8rpx;color: #5f665f;font-size: 20rpx;line-height: 1.5; }
.error-state {border-color:#ead1cc; }
.clear-state {border-color:#e9efd9; }
.insight-list {margin-top:24rpx; }
.block-label {margin-bottom: 8rpx;color: #5f665f;font-size: 18rpx;letter-spacing: 2rpx; }
.advice-block .block-label {color: #506336; }
.card-actions {display: grid;grid-template-columns: 1fr 1fr;gap: 16rpx;margin-top: 24rpx; }
.card-actions button {min-height: 80rpx;margin: 0;border-radius: 16rpx;font-size: 23rpx; }
.card-actions button::after {border: 0; }
.action-primary {color:#111613;background: #c4e267; }
.action-link {color: #506336;background: #e9efd9; }
.feedback-panel {margin-top: 24rpx;padding-top: 20rpx;border-top: 1rpx solid #eeeee6; }
.feedback-question {color: #5f665f;font-size: 20rpx; }
.feedback-actions {display: grid;grid-template-columns: repeat(3,1fr);gap: 12rpx;margin-top: 16rpx; }
.feedback-actions button {min-height: 62rpx;margin: 0;padding: 0 8rpx;border: 1rpx solid #e9efd9;border-radius: 14rpx;color: #506336;background: #f7f7f2;font-size: 19rpx;line-height: 62rpx; }
.feedback-actions button::after {border: 0; }
.feedback-done {display:flex;align-items:center;flex-wrap:wrap;color:#506336;font-size:20rpx; }
.feedback-done > image {width:28rpx;height:28rpx;margin-right:8rpx; }
.feedback-done > view {margin-top: 8rpx;color: #506336;font-size: 17rpx; }
.boundary-card {margin-top: 24rpx;padding: 24rpx 24rpx;border: 1rpx solid #eeeee6;border-radius: 20rpx;color: #5f665f;background: rgba(255,255,255,.55);font-size: 20rpx;line-height: 1.65; }
.boundary-title {margin-bottom: 8rpx;color: #5f665f;font-size: 22rpx;font-weight: 650; }
.quality-message {margin-bottom: 12rpx;color: #506336; }
.feedback-policy {margin-top: 12rpx;padding-top: 12rpx;border-top: 1rpx solid #eeeee6; }
.experiment-live {margin-top: 24rpx;padding: 32rpx;border-radius: 24rpx;color: #f7faf8;background: linear-gradient(145deg,#111613,#111613);box-shadow: 0 14rpx 34rpx rgba(17,22,19,.16); }
.experiment-live-head {display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx; }
.experiment-kicker {color:#f7f7f2;font-size:17rpx;font-weight:800;letter-spacing:2rpx; }
.experiment-title {margin-top:8rpx;font-size:28rpx;font-weight:800; }
.experiment-status {flex:none;padding:8rpx 12rpx;border-radius:999rpx;color:#111613;background:#e9efd9;font-size:18rpx;font-weight:750; }
.experiment-hypothesis {margin-top:16rpx;color:rgba(255,255,255,.76);font-size:20rpx;line-height:1.65; }
.experiment-action {margin-top:20rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:16rpx;background:rgba(255,255,255,.08);font-size:21rpx;line-height:1.6; }
.experiment-action .block-label {color:#f7f7f2; }
.experiment-progress-head,.experiment-meta {display:flex;justify-content:space-between;gap:16rpx;margin-top:16rpx;color:rgba(255,255,255,.72);font-size:18rpx; }
.experiment-track {overflow:hidden;height:10rpx;margin-top:8rpx;border-radius:999rpx;background:rgba(255,255,255,.13); }
.experiment-track view {height:100%;border-radius:999rpx;background:#e9efd9; }
.experiment-controls {display:flex;gap:12rpx;margin-top:20rpx; }
.experiment-controls button {margin:0;border-radius:15rpx;font-size:20rpx; }
.experiment-controls button::after {border:0; }
.review-button {flex:1;color:#111613;background:#e9efd9; }
.stop-button {width:150rpx;color:rgba(255,255,255,.75);background:rgba(255,255,255,.1); }
.experiment-boundary {margin-top:16rpx;color:rgba(255,255,255,.52);font-size:17rpx;line-height:1.55; }
.experiment-proposal {margin-top:24rpx;padding:24rpx;border:1rpx solid #e9efd9;border-radius:19rpx;background:#f7f7f2; }
.experiment-proposal .experiment-kicker {color:#506336; }
.proposal-title {margin-top:8rpx;color:#111613;font-size:24rpx;font-weight:800; }
.proposal-hypothesis {margin-top:12rpx;color:#506336;font-size:19rpx;line-height:1.6; }
.proposal-history {margin-top:12rpx;padding:12rpx 16rpx;border-radius:13rpx;color:#506336;background:#e9efd9;font-size:18rpx;line-height:1.55; }
.proposal-variants {display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:16rpx; }
.variant-card {padding:16rpx;border:1rpx solid #e9efd9;border-radius:16rpx;background:#fff; }
.variant-head {display:flex;justify-content:space-between;align-items:center;color:#506336;font-size:19rpx; }
.variant-head b {font-size:21rpx; }
.variant-action {min-height:94rpx;margin-top:12rpx;color:#5f665f;font-size:18rpx;line-height:1.5; }
.variant-card button {min-height:58rpx;margin:12rpx 0 0;padding:0 8rpx;border-radius:13rpx;color:#111613;background:#c4e267;font-size:18rpx;line-height:58rpx; }
.variant-card button::after {border:0; }
.proposal-boundary {margin-top:12rpx;color:#5f665f;font-size:17rpx;line-height:1.55; }
