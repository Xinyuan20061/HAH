.hero{background:linear-gradient(145deg,#111613,#111613);border-radius:38rpx;padding:32rpx;color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:260rpx;height:260rpx;border-radius:50%;background:rgba(196,226,103,.12);right:-80rpx;top:-100rpx}.kicker{font-size:18rpx;letter-spacing:3rpx;opacity:.65}.hero-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.hero .title{color:#fff;font-size:48rpx;margin:16rpx 0 8rpx}.hero .subtitle{color:rgba(255,255,255,.65)}.motion-dot{width:112rpx;height:112rpx;border-radius:50%;border:2rpx solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.motion-dot view{width:22rpx;height:22rpx;border-radius:50%;background:#c4e267;box-shadow:0 0 0 18rpx rgba(217,255,132,.1);animation:pulse 1.7s infinite}.muscles{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:32rpx;position:relative;z-index:2}.muscles text{font-size:19rpx;padding:8rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.1)}.steps view{display:grid;grid-template-columns:56rpx 1fr;gap:12rpx;padding:16rpx 0;border-top:1rpx solid #eeeee6;line-height:1.65;font-size:24rpx}.steps view:first-child{border-top:0}.num{font-size:18rpx;color:#506336;font-weight:800;letter-spacing:1rpx}.cue-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.cue{margin:0;min-height:128rpx;font-size:22rpx;line-height:1.55}.cue-mark{display:block;color:#506336;margin-bottom:12rpx}.mistakes view{display:flex;gap:16rpx;padding:16rpx 0;border-top:1rpx solid #eeeee6;font-size:23rpx}.mistakes view:first-child{border-top:0}.mistakes view text:first-child{color:#b05a55;font-weight:900}.breath{display:flex;gap:20rpx;align-items:center;margin-top:24rpx;background:#f7f7f2}.breath .icon{width:68rpx;height:68rpx;border-radius:22rpx;background:#c4e267;color:#111613;display:flex;align-items:center;justify-content:center;font-size:32rpx}.breath .b{font-weight:800;margin-bottom:4rpx}.breath .muted{font-size:21rpx;line-height:1.5}.safety{font-size:20rpx;line-height:1.6;color:#5f665f;padding:4rpx 8rpx 24rpx}@keyframes pulse{0%,100%{transform:scale(.86);opacity:.75}50%{transform:scale(1.12);opacity:1}}
