.hero{background:linear-gradient(145deg,#153d32,#2a6c58);border-radius:38rpx;padding:34rpx;color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:260rpx;height:260rpx;border-radius:50%;background:rgba(217,255,132,.12);right:-80rpx;top:-100rpx}.kicker{font-size:18rpx;letter-spacing:3rpx;opacity:.65}.hero-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.hero .title{font-size:48rpx;margin:16rpx 0 6rpx}.hero .subtitle{color:rgba(255,255,255,.65)}.motion-dot{width:112rpx;height:112rpx;border-radius:50%;border:2rpx solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.motion-dot view{width:22rpx;height:22rpx;border-radius:50%;background:#d9ff84;box-shadow:0 0 0 18rpx rgba(217,255,132,.1);animation:pulse 1.7s infinite}.muscles{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:28rpx;position:relative;z-index:2}.muscles text{font-size:19rpx;padding:9rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.1)}.steps view{display:grid;grid-template-columns:56rpx 1fr;gap:12rpx;padding:17rpx 0;border-top:1rpx solid #edf1ef;line-height:1.65;font-size:24rpx}.steps view:first-child{border-top:0}.num{font-size:18rpx;color:#3d8069;font-weight:800;letter-spacing:1rpx}.cue-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.cue{margin:0;min-height:128rpx;font-size:22rpx;line-height:1.55}.cue-mark{display:block;color:#2e795f;margin-bottom:10rpx}.mistakes view{display:flex;gap:16rpx;padding:15rpx 0;border-top:1rpx solid #edf1ef;font-size:23rpx}.mistakes view:first-child{border-top:0}.mistakes view text:first-child{color:#b05a55;font-weight:900}.breath{display:flex;gap:18rpx;align-items:center;margin-top:24rpx;background:#edf5f1}.breath .icon{width:68rpx;height:68rpx;border-radius:22rpx;background:#174c3d;color:#d9ff84;display:flex;align-items:center;justify-content:center;font-size:32rpx}.breath .b{font-weight:800;margin-bottom:5rpx}.breath .muted{font-size:21rpx;line-height:1.5}.safety{font-size:20rpx;line-height:1.6;color:#8a9690;padding:4rpx 8rpx 24rpx}@keyframes pulse{0%,100%{transform:scale(.86);opacity:.75}50%{transform:scale(1.12);opacity:1}}
