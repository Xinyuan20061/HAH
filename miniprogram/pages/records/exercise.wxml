<view class="page"><view class="title">运动记录</view><view class="subtitle intro">把训练当成长期习惯，记录时长和体感比追求绝对精确的消耗值更重要。</view><view class="card"><view class="label">运动项目</view><input class="input" placeholder="例如：快走 / 慢跑 / 力量训练" value="{{form.name}}" data-k="name" bindinput="inp"/><view class="grid"><view><view class="label">时长（分钟）</view><input class="input" type="number" value="{{form.duration_min}}" data-k="duration_min" bindinput="inp"/></view><view><view class="label">估计消耗 kcal</view><input class="input" type="digit" value="{{form.calories_burned}}" data-k="calories_burned" bindinput="inp"/></view></view><view class="label">强度</view><picker range="{{levels}}" bindchange="level"><view class="input">{{levels[levelIndex]}}</view></picker><button class="btn-primary save" bindtap="save">完成记录</button></view><view class="section-title">快速开始</view><view class="templates"><block wx:for="{{templates}}" wx:key="name"><view class="template" bindtap="fill" data-i="{{index}}"><view class="template-name">{{item.name}}</view><view class="muted">{{item.duration_min}} min · 约 {{item.calories_burned}} kcal</view></view></block></view><view class="section-title">最近记录</view><block wx:for="{{records}}" wx:key="id"><view class="record card"><view class="grow"><view class="row"><view class="record-name">{{item.name}}</view><view class="tag">{{item.intensity}}</view></view><view class="muted record-meta">{{item.duration_min}} min · {{item.calories_burned}} kcal</view></view><view class="delete" bindtap="remove" data-id="{{item.id}}">删除</view></view></block><view wx:if="{{!records.length}}" class="card empty">还没有运动记录。</view></view>
