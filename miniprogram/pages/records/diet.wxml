<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page ui-page-content"><view class="title">饮食记录</view><view class="subtitle intro">先记录真实摄入，再逐步追求精确。营养值不确定时可以先填估计值。</view>
<view class="card"><view class="label">吃了什么</view><input class="input" placeholder="例如：鸡胸肉沙拉" value="{{form.name}}" data-k="name" bindinput="inp"/><view class="label">这一餐</view><picker range="{{meals}}" bindchange="meal"><view class="input">{{meals[mealIndex]}}</view></picker><view class="grid"><view><view class="label">热量 kcal</view><input class="input" type="digit" value="{{form.calories}}" data-k="calories" bindinput="inp"/></view><view><view class="label">蛋白质 g</view><input class="input" type="digit" value="{{form.protein}}" data-k="protein" bindinput="inp"/></view><view><view class="label">碳水 g</view><input class="input" type="digit" value="{{form.carbs}}" data-k="carbs" bindinput="inp"/></view><view><view class="label">脂肪 g</view><input class="input" type="digit" value="{{form.fat}}" data-k="fat" bindinput="inp"/></view></view><button class="btn-primary tappable" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存记录</button></view>
<view class="section-title">常用模板</view><scroll-view scroll-x><view class="template-wrap"><block wx:for="{{templates}}" wx:key="name"><view class="template tappable" bindtap="fill" data-i="{{index}}" hover-class="tap-chip" hover-start-time="0" hover-stay-time="80"><view class="template-name">{{item.name}}</view><view class="muted">{{item.calories}} kcal · {{item.protein}}g 蛋白质</view></view></block></view></scroll-view>
<view class="section-title">最近记录</view><block wx:for="{{records}}" wx:key="id"><view class="record card {{item.id===dragId?'dragging':''}} {{leavingId===item.id?'leaving':''}}" data-id="{{item.id}}" style="{{item.id===dragId?dragStyle:''}}" bindtouchstart="swipeDeleteStart" bindtouchmove="swipeDeleteMove" bindtouchend="swipeDeleteEnd" bindtouchcancel="swipeDeleteCancel"><view class="grow"><view class="row"><view class="record-name">{{item.name}}</view><view class="tag">{{item.meal_type}}</view></view><view class="muted record-meta">{{item.calories}} kcal · P {{item.protein}}g · C {{item.carbs}}g · F {{item.fat}}g</view></view><view class="delete tappable" bindtap="remove" data-id="{{item.id}}" hover-class="tap" hover-start-time="0" hover-stay-time="80">删除</view></view></block><view wx:if="{{!records.length}}" class="card empty">还没有饮食记录。</view></view>
