.label{font-size:23rpx;color:#5f665f;margin:24rpx 0 8rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx 20rpx;margin-bottom:32rpx}.template-wrap{display:flex;gap:16rpx;padding-bottom:4rpx}.template{width:300rpx;flex:none;background:#fff;border-radius:24rpx;padding:24rpx;box-sizing:border-box;border:1rpx solid #e9efd9}.template-name{font-weight:700;margin-bottom:8rpx}.template .muted{font-size:20rpx}.record{display:flex;align-items:center;padding:24rpx}.record-name{font-weight:700;margin-right:12rpx}.record-meta{font-size:21rpx;margin-top:8rpx}.delete{font-size:21rpx;color:#A65A5A;padding:16rpx}

/* ── Curved Card Deletion ──────────────────────────────────────────────────
   卡片跟手时按 inline transform 走弧线，基础过渡写在 .record 上，
   这样「弹回」也有动画；跟手期间用 .dragging 关掉过渡，否则会有拖尾延迟。
   过渡写在基础类而不是复合选择器里，回弹才不会瞬跳。 */
.record {transition: transform .34s cubic-bezier(.34,1.56,.64,1), opacity .28s ease-out; }
.dragging {transition: none; }
.leaving {opacity: 0; transition: transform .42s cubic-bezier(.4,0,1,.4), opacity .42s ease-out; }
