.label{font-size:23rpx;color:#5f665f;margin:24rpx 0 8rpx}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx 20rpx;margin-bottom:32rpx}
.input{width:100%;box-sizing:border-box}

.diet-page{padding-bottom:96rpx}
.intro{margin:8rpx 0 24rpx}
.back-link{margin-left:16rpx;color:#506336;font-size:20rpx}

.filters{margin-bottom:24rpx}
.filter-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.day-nav{padding:8rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:20rpx}
.day-pick{padding:8rpx 24rpx;border-radius:999rpx;background:#c4e267;color:#111613;font-size:24rpx;font-weight:760}
.meal-pick{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:20rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#f7f7f2;color:#111613;font-size:24rpx}
.meal-pick image{width:24rpx;height:24rpx;flex:none;opacity:.7}

.record{margin-bottom:24rpx;padding:0}
.record-head{display:flex;align-items:center;gap:16rpx;padding:24rpx}
.record-head .grow{min-width:0;flex:1}
.record-name{color:#111613;font-size:28rpx;font-weight:720;line-height:1.35}
.record-meta{margin-top:8rpx;font-size:20rpx}
.record-kcal{flex:none;color:#111613;font-size:30rpx;font-weight:800;font-variant-numeric:tabular-nums}
.record-kcal text{margin-left:4rpx;color:#5f665f;font-size:14rpx;font-weight:500}
.record-body{padding:0 24rpx 24rpx;border-top:1rpx solid #eeeee6}
.record-macros{margin-top:12rpx;font-size:20rpx}
.provenance{display:inline-block;margin-top:16rpx;padding:8rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:18rpx}
.item-list{margin-top:16rpx}
.item-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-height:56rpx;border-bottom:1rpx solid #eeeee6}
.item-row:last-child{border-bottom:0}
.item-name{color:#111613;font-size:22rpx}
.item-value{color:#5f665f;font-size:20rpx;font-variant-numeric:tabular-nums}
.record-actions{display:flex;gap:16rpx;margin-top:20rpx}
.record-action{padding:16rpx 24rpx;border-radius:999rpx;background:#f7f7f2;color:#111613;font-size:22rpx}
.record-action.danger{background:rgba(192,57,43,.1);color:#c0392b}

.more{margin-top:8rpx;padding:24rpx;border-radius:16rpx;background:#fff;color:#506336;font-size:22rpx;text-align:center}
.list-foot{margin-top:24rpx;font-size:18rpx;text-align:center}

.state-card-empty .retry{background:#c4e267;color:#111613}
.retry{flex:none;margin:0;padding:0 24rpx;min-height:64rpx;border:0;border-radius:999rpx;background:#e9efd9;color:#111613;font-size:22rpx;line-height:64rpx}
.retry::after{border:0}
.sk-overview{height:420rpx;border-radius:28rpx}
.shimmer{background:linear-gradient(100deg,#e9efd9 20%,#f7f7f2 40%,#e9efd9 60%);background-size:220% 100%;animation:dietShimmer 1.3s infinite}

.mask{position:fixed;inset:0;background:rgba(17,22,19,.35);animation:fadeIn .2s ease-out}
.edit-panel{position:fixed;left:0;right:0;bottom:0;padding:32rpx;padding-bottom:calc(32rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff;animation:sheetUp .28s cubic-bezier(.2,.8,.2,1)}
.edit-title{color:#111613;font-size:30rpx;font-weight:780}
.edit-items{margin-top:24rpx}
.edit-item{display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx}
.item-name-input{flex:1;min-width:0}
.item-kcal-input{width:180rpx;flex:none;text-align:right}
.edit-actions{display:flex;gap:16rpx;margin-top:32rpx}
.edit-actions button{flex:1;margin:0}
.conflict{margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:rgba(155,91,0,.1)}
.conflict-text{color:#9b5b00;font-size:22rpx;line-height:1.5}
.conflict-actions{display:flex;gap:16rpx;margin-top:16rpx}

/* ── Curved Card Deletion ──────────────────────────────────────────────────
   卡片跟手时按 inline transform 走弧线，基础过渡写在 .record 上，
   这样「弹回」也有动画；跟手期间用 .dragging 关掉过渡，否则会有拖尾延迟。
   过渡写在基础类而不是复合选择器里，回弹才不会瞬跳。 */
.record{transition:transform .34s cubic-bezier(.34,1.56,.64,1),opacity .28s ease-out}
.record.dragging{transition:none}
.record.leaving{opacity:0;transition:transform .42s cubic-bezier(.4,0,1,.4),opacity .42s ease-out}

@keyframes dietShimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes sheetUp{from{opacity:0;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}
