/* HealthMate 3.0: calmer evidence-first visual language. */
.media-page{background:#f5f4ef}.kicker{color:#3b695b;font-weight:700}.title{font-weight:720}.drop{border:1rpx dashed #b8beb9;border-radius:22rpx;background:#faf9f5}.upload-icon{border-radius:50%;background:#234c40;color:#fff}.btn{border-radius:18rpx;font-weight:650}.secondary{background:#e4ece8}.scanner{border-radius:18rpx;background:#213e35}.scan-line{background:#e8dfc9;box-shadow:0 0 18rpx rgba(232,223,201,.48)}.motion-badge,.overall-score,.profile-score,.alignment-score{border-radius:50%;background:#e7dfca;color:#28483f}.candidate-track view{background:#4f806f}.observed-card{background:#1f4137}.observed-card .pill,.observed-pattern b{color:#e8dfc9}.intent-picker,.profile-stats view,.score-grid view,.angle-grid view{border-radius:15rpx;background:#f0f2ee}.worker-state.online{background:#e1eee7;color:#245f4b}.recognition-card,.semantic-card{border-width:1rpx}.skeleton-wrap{border-radius:22rpx}

/* 动作识别升级：识别来源徽章 */
.badge-row{display:flex;gap:10rpx;align-items:center;margin-bottom:10rpx;flex-wrap:wrap}
.source-badge.review{background:#e8f0ff;color:#2d5f9e}
.source-badge{display:inline-block;padding:6rpx 14rpx;border-radius:999rpx;font-size:19rpx;font-weight:700}

/* 逐帧动作拆解：放大卡片 + 详细讲解 */
.frame-detail-card{background:#fff;border-radius:26rpx;padding:24rpx;margin:22rpx 0;box-shadow:0 4rpx 18rpx rgba(31,65,55,.06)}
.frame-detail-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;gap:12rpx}
.frame-detail-title{font-size:30rpx;font-weight:850;color:#173f34}
.frame-stage{font-size:21rpx;font-weight:700;color:#2d735f;background:#eaf3ee;padding:6rpx 16rpx;border-radius:999rpx;flex:none}
.frame-detail-card .frame-hero{height:560rpx;border-radius:22rpx}
.frame-explanation{font-size:26rpx;line-height:1.8;color:#28483f;background:#f4f7f2;border-radius:18rpx;padding:22rpx 24rpx;margin-top:20rpx}
.frame-coach{margin:18rpx 0 0}
.frame-coach b{font-size:25rpx;font-weight:800;color:#1f4137;display:block;margin-bottom:6rpx}
.frame-coach view{font-size:23rpx;line-height:1.6;color:#64736d}
.frame-coach text{font-size:22rpx;line-height:1.6;color:#245f4c;display:block;margin-top:8rpx}

/* 逐帧条放大，数字不重叠 */
.frame-strip{white-space:nowrap;width:100%;margin-bottom:24rpx;padding-bottom:8rpx}
.frame-item{display:inline-block;width:250rpx;margin-right:14rpx;border-radius:22rpx;background:#fff;padding:10rpx;box-sizing:border-box;border:2rpx solid transparent;vertical-align:top}
.frame-item.on{border-color:#2d755f}
.frame-item image{width:228rpx;height:150rpx;border-radius:16rpx;background:#e8eeeb}
.frame-metric{height:120rpx;border-radius:14rpx;background:#edf3f0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx}
.frame-metric text:first-child{font-size:32rpx;font-weight:700;color:#184c3e;line-height:1}
.frame-metric text:last-child{font-size:19rpx;color:#87938f;line-height:1}
.frame-time{font-size:19rpx;font-weight:700;margin:10rpx 4rpx 2rpx;line-height:1}

/* 角度数值 2 位小数，卡片不重叠 */
.angle-grid b{font-size:30rpx;line-height:1.2;white-space:nowrap}
.angle-grid text{font-size:18rpx;line-height:1.3;white-space:nowrap}
.angle-grid view{padding:20rpx 12rpx}
.rep-line b{font-size:34rpx;line-height:1.15}
.rep-line text{margin-top:8rpx}
.ai-summary-card{background:#1f4137;border-radius:22rpx;padding:24rpx 26rpx;margin-bottom:22rpx}
.ai-summary-title{font-size:19rpx;letter-spacing:2rpx;color:#e8dfc9;font-weight:700;margin-bottom:10rpx}
.ai-summary-text{font-size:25rpx;line-height:1.8;color:#eef6f2}