.frame-detail-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;gap:12rpx}
.frame-detail-title{font-size:30rpx;font-weight:850;color:#111613}
.frame-stage{font-size:21rpx;font-weight:700;color:#506336;background:#f7f7f2;padding:8rpx 16rpx;border-radius:999rpx;flex:none}
.frame-detail-card .frame-hero{height:560rpx;border-radius:22rpx}
.frame-explanation{font-size:26rpx;line-height:1.8;color:#111613;background:#f7f7f2;border-radius:18rpx;padding:24rpx 24rpx;margin-top:20rpx}
.frame-coach{margin:20rpx 0 0}
.frame-coach b{font-size:25rpx;font-weight:800;color:#111613;display:block;margin-bottom:8rpx}
.frame-coach view{font-size:23rpx;line-height:1.6;color:#5f665f}
.frame-coach text{font-size:22rpx;line-height:1.6;color:#111613;display:block;margin-top:8rpx}

.frame-strip{white-space:nowrap;width:100%;margin-bottom:24rpx;padding-bottom:8rpx}
.frame-item{display:inline-block;width:250rpx;margin-right:16rpx;border-radius:22rpx;background:#fff;padding:12rpx;box-sizing:border-box;border:2rpx solid transparent;vertical-align:top}
.frame-item.on{border-color:#c4e267}
