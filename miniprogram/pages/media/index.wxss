.frame-metric text:first-child{font-size:32rpx;font-weight:700;color:#111613;line-height:1}
.frame-metric text:last-child{font-size:19rpx;color:#5f665f;line-height:1}
.frame-time{font-size:19rpx;font-weight:700;margin:12rpx 4rpx 4rpx;line-height:1}

