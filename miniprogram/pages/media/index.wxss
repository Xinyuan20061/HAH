.ai-summary-text{font-size:25rpx;line-height:1.8;color:#111613}
.kinetics-pct{margin-left:16rpx;font-size:22rpx;color:#506336;font-weight:750}
.detail-toggle .ui-chevron,.goal-entry .ui-chevron{transition:transform .24s cubic-bezier(.2,.8,.2,1)}
.detail-toggle .ui-chevron.open,.goal-entry .ui-chevron.open{transform:rotate(90deg)}
