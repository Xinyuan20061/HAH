<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page media-page ui-page-content">
  <view class="media-hero"><view class="kicker">动作反馈</view><view class="title">录一段，看看动作</view><view class="subtitle">保持全身入镜，建议拍摄 5–20 秒。</view></view>

  <view class="drop tappable" bindtap="choose" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="upload-icon ui-fixed-circle"><image src="/assets/icons/upload.png" mode="aspectFit"/></view><text class="b">{{file?'已选择视频':'选择动作视频'}}</text><text class="small">{{file?name:'支持 MP4 / MOV'}}</text></view>
  <video wx:if="{{file&&type==='video'}}" src="{{file}}" controls class="preview"></video>

  <view class="privacy-note">默认使用纯色画布骨架图进行云端复核；仅在您同意时使用真实关键帧并经脱敏处理。结果仅供一般健身参考，不做医疗判断。</view>

  <picker mode="selector" range="{{exerciseOptions}}" value="{{exerciseIndex}}" bindchange="changeExercise"><view class="motion-picker">动作：{{exerciseOptions[exerciseIndex]}}<text>切换</text></view></picker>

  <view class="consent-row"><view class="consent-text"><text class="consent-title">云端视觉协作</text><text class="consent-sub">{{consentDeepseek?'已开启云端复核':'仅本地分析'}}</text></view><switch checked="{{consentDeepseek}}" bindchange="toggleConsent" color="#506336"/></view>

  <button class="btn primary single-action tappable" bindtap="startAnalysis" loading="{{analyzing}}" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">{{analyzing?'正在处理…':'开始分析'}}</button>
  <view wx:if="{{jobStatus&&!analyzing&&!vm}}" class="state-card"><view class="state-desc">{{jobStatus}}</view></view>

  <view wx:if="{{vm}}" class="motion-result">
    <view class="result-head">
      <view class="badge-row">
        <view class="source-badge {{vm.abstained||vm.uncertain?'warn':''}}">{{vm.stateBadge}}</view>
        <view wx:if="{{vm.reviewBadge}}" class="source-badge review">{{vm.reviewBadge}}</view>
        <view wx:if="{{vm.localOnly}}" class="source-badge local">仅本地分析</view>
      </view>
      <view class="motion-name">{{vm.detectedName}}</view>
      <view wx:if="{{vm.reason}}" class="muted">{{vm.reason}}</view>
    </view>

    <view wx:if="{{vm.summaryText}}" class="ai-summary-card">
      <view class="ai-summary-title">整体点评</view>
      <view class="ai-summary-text">{{vm.summaryText}}</view>
      <view wx:if="{{vm.summaryDegraded}}" class="ai-summary-degraded">{{vm.summaryDegradedNote}}</view>
    </view>

    <view wx:if="{{vm.abstained||vm.uncertain}}" class="recognition-action">暂不能确定这段动作：可能存在低光、遮挡、多人、未拍完整动作周期或判断意见不一致。可在上方手动选择动作后重新分析，或重拍一段更完整的视频。</view>

    <view class="score-block">
      <block wx:if="{{vm.qualityAvailable}}">
        <view class="rep-line"><view><b>{{vm.qualityOverall}}</b><text>动作质量</text></view><view><b>{{vm.qualityReps}}</b><text>次数</text></view></view>
        <view wx:if="{{vm.qualityDims.length}}" class="score-grid"><view wx:for="{{vm.qualityDims}}" wx:key="label"><text>{{item.label}}</text><b>{{item.value}}</b></view></view>
      </block>
      <view wx:else class="no-score-note">{{vm.noScoreNote}}<text wx:if="{{vm.noScoreReason}}">（{{vm.noScoreReason}}）</text></view>
    </view>

    <view wx:if="{{vm.keyframes.length}}" class="keyframes-block">
      <view class="block-title">关键帧拆解</view>
      <view class="kf-card" wx:for="{{vm.keyframes}}" wx:key="id">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="kf-img"/>
        <view class="kf-meta"><text class="kf-time">{{item.tLabel}}</text><text wx:if="{{item.phase}}" class="kf-phase">{{item.phase}}</text></view>
        <view class="kf-finding">{{item.finding}}</view>
        <view class="kf-advice">{{item.advice}}</view>
        <view class="kf-evidence">{{vm.evidenceLabel}}：{{item.evidenceTypeLabel}}</view>
      </view>
    </view>

    <view class="feedback-row">
      <view class="fb-btn tappable" bindtap="confirmLabel" hover-class="tap" hover-start-time="0" hover-stay-time="80">识别对了</view>
      <view class="fb-btn tappable" bindtap="correctLabel" hover-class="tap" hover-start-time="0" hover-stay-time="80">动作不对</view>
      <view class="fb-btn soft tappable" data-kind="frame" bindtap="sendFeedback" hover-class="tap" hover-start-time="0" hover-stay-time="80">关键帧不准</view>
      <view class="fb-btn soft tappable" data-kind="advice" bindtap="sendFeedback" hover-class="tap" hover-start-time="0" hover-stay-time="80">建议无用</view>
    </view>

    <view class="detail-toggle tappable" bindtap="toggleDetails" hover-class="tap" hover-start-time="0" hover-stay-time="80"><text>{{showDetails?'收起详情':'查看详情与来源'}}</text><image class="ui-chevron {{showDetails?'open':''}}" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="disclosure {{showDetails?'open':''}}" style="height:{{detailsHeight}}" bindtransitionend="onDisclosureEnd"><view class="disclosure-body" id="detailsBody"><view class="motion-details">
      <view class="detail-section">
        <view class="detail-title">候选与判断把握</view>
        <view wx:if="{{vm.candidatePct!==null}}" class="candidate"><view class="row space"><text>{{vm.candidateNote}}</text><b>{{vm.candidatePct}}%</b></view></view>
        <view wx:elif="{{!vm.candidatePct}}" class="muted">本次未提供候选分值。</view>
        <view wx:if="{{vm.showConfidence}}" class="confidence-line">判断把握度：{{vm.confidencePct}}%</view>
        <view wx:else class="muted">判断把握度：暂无校准结果，不显示数值。</view>
        <view wx:if="{{vm.sourceList}}" class="muted">参与来源：{{vm.sourceList}}</view>
        <view wx:if="{{traceInfo}}" class="trace-box">
          <view wx:if="{{traceInfo.note}}">{{traceInfo.note}}</view>
          <view wx:if="{{traceInfo.summary}}">{{traceInfo.summary}}</view>
        </view>
        <view wx:if="{{vm.traceId}}" class="muted">分析编号：{{vm.traceId}}</view>
      </view>
      <view wx:if="{{vm.limitations.length}}" class="detail-section"><view class="detail-title">使用限制</view><view wx:for="{{vm.limitations}}" wx:key="*this" class="muted">{{item}}</view></view>
    </view></view></view>

    <view class="goal-entry tappable" bindtap="toggleGoal" hover-class="tap" hover-start-time="0" hover-stay-time="80"><text>设置今日目标</text><image class="ui-chevron {{showGoal?'open':''}}" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view wx:if="{{showGoal}}" class="goal-editor"><view class="intent-grid"><picker mode="selector" range="{{targetOptions}}" value="{{targetIndex}}" bindchange="changeTarget"><view class="intent-picker"><text>目标部位</text><b>{{targetOptions[targetIndex]}}</b></view></picker><picker mode="selector" range="{{goalOptions}}" value="{{goalIndex}}" bindchange="changeGoal"><view class="intent-picker"><text>训练目标</text><b>{{goalOptions[goalIndex]}}</b></view></picker></view><button class="btn-soft tappable" bindtap="saveTrainingIntent" loading="{{savingIntent}}" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存目标</button></view>
  </view>

  <view class="notice">疼痛或不适时请停止。结果仅供一般健身参考，不替代医生诊断。</view>
</view>
