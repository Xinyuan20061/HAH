<view class="page report-page">
  <block wx:if="{{loading}}"><view class="sk-hero shimmer"></view><view class="sk-grid"><view class="sk-card shimmer" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view></view><view class="sk-chart shimmer"></view></block>
  <block wx:elif="{{r}}">
    <view class="report-hero"><view class="row space"><view class="grow"><view class="kicker">WEEKLY INSIGHT · {{r.range}}</view><view class="hero-title">这一周，你的健康节奏得分 {{scoreText}}</view></view><view class="score-ring"><text class="b">{{scoreText}}</text><text class="small">/100</text></view></view><view class="hero-note">周报不是打分你“够不够自律”，而是帮你看见哪件事正在变得更稳定。</view><view class="hero-streak">连续打卡 {{r.streak.current}} 天 · 最长 {{r.streak.longest}} 天</view></view>
    <view class="metrics"><view class="metric card"><text class="b">{{displayAvg.sleep}}</text><text class="small">小时 · 记录日平均睡眠</text></view><view class="metric card"><text class="b">{{displayAvg.exercise}}</text><text class="small">分钟 · 记录日平均运动</text></view><view class="metric card"><text class="b">{{displayAvg.water}}</text><text class="small">ml · 记录日平均饮水</text></view><view class="metric card"><text class="b">{{displayAvg.protein}}</text><text class="small">g · 记录日平均蛋白质</text></view></view>
    <view class="facts-card card"><view class="row space"><view><view class="facts-title">程序事实层</view><view class="facts-sub">未记录日期不会按 0 参与平均</view></view><view class="quality">{{qualityText}}</view></view><view class="coverage">{{coverageText}}</view><view class="compare" wx:if="{{compare.length}}"><view wx:for="{{compare}}" wx:key="name"><text>{{item.name}}</text><text class="{{item.flat?'flat':item.up?'up':'down'}}">{{item.text}}</text></view></view><view class="facts-note">{{r.data_quality.note}}</view></view>

    <view class="section-title">本周总结</view>
    <view wx:if="{{aiLoading&&!ai}}" class="ai-summary card"><view class="ai-head"><view class="ai-orb">✦</view><view class="grow"><view class="ai-line shimmer"></view><view class="ai-line short shimmer"></view></view></view><view class="ai-block shimmer"></view></view>
    <view wx:if="{{ai}}" class="ai-summary card"><view class="ai-head"><view class="ai-orb">✦</view><view><view class="provider">每周回顾</view><view class="ai-title">{{ai.title}}</view></view></view><view class="ai-text">{{ai.summary}}</view><view class="wins" wx:if="{{ai.wins.length}}"><view wx:for="{{ai.wins}}" wx:key="*this">✓ {{item}}</view></view><view class="focus"><text>下周聚焦</text><text>{{ai.focus}}</text></view><view class="action"><text>建议行动</text><text>{{ai.action}}</text></view><view class="caution">{{ai.caution}}</view></view>

    <view class="section-title">交互趋势</view><view class="chart-card card"><view class="tabs"><view wx:for="{{tabs}}" wx:key="k" data-i="{{index}}" bindtap="pickMetric" class="{{item.k===metric?'on':''}} tappable" hover-class="tap" hover-start-time="0" hover-stay-time="80">{{item.n}}</view></view><view class="chart-meta"><text>{{metricName}} · 7 日</text><text>{{activeValue}}</text></view><canvas type="2d" id="weekCanvas" class="week-canvas" bindtouchstart="chartTouch" bindtouchmove="chartTouch"></canvas></view>

    <view class="section-title">本周观察</view><view class="insights card"><view wx:for="{{r.highlights}}" wx:key="*this"><text>✦</text><text class="b">{{item}}</text></view><view wx:if="{{!r.highlights.length}}" class="muted">连续记录几天后，这里会出现更有意义的趋势观察。</view></view>
  </block>
  <view wx:else class="card empty">周报暂时无法加载，请稍后重试。</view>
</view>
