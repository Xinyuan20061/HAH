.report-page{background:linear-gradient(180deg,#edf5f1 0,#f7f9f8 380rpx)}.report-hero{background:linear-gradient(140deg,#123b31,#276a57 58%,#90c4a9);color:white;border-radius:40rpx;padding:34rpx;box-shadow:0 24rpx 70rpx rgba(21,70,54,.18);position:relative;overflow:hidden}.report-hero:after{content:"";position:absolute;width:260rpx;height:260rpx;border-radius:50%;background:rgba(216,255,132,.13);right:-80rpx;top:-100rpx}.kicker{font-size:19rpx;letter-spacing:2rpx;opacity:.68}.hero-title{font-size:38rpx;font-weight:800;line-height:1.35;margin-top:14rpx;position:relative;z-index:2}.hero-note{font-size:22rpx;line-height:1.6;opacity:.72;margin-top:28rpx}.hero-streak{display:inline-block;margin-top:18rpx;padding:10rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.1);font-size:19rpx}.score-ring{width:128rpx;height:128rpx;border-radius:50%;border:12rpx solid #d9ff86;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;z-index:2}.score-ring .b{font-size:38rpx;font-weight:850}.score-ring .small{font-size:16rpx;opacity:.7}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.metric{margin:0}.metric .b,.metric .small{display:block}.metric .b{font-size:38rpx;font-weight:800}.metric .small{font-size:20rpx;color:#87938e;margin-top:4rpx}.ai-summary{background:#173f34;color:#fff}.ai-head{display:flex;align-items:center;gap:16rpx}.ai-orb{width:62rpx;height:62rpx;border-radius:21rpx;background:#d8ff84;color:#173f34;display:flex;align-items:center;justify-content:center;font-size:28rpx}.provider{font-size:15rpx;letter-spacing:2rpx;color:#a4c5b6}.ai-title{font-size:28rpx;font-weight:850;margin-top:4rpx}.ai-text{font-size:23rpx;line-height:1.7;margin-top:22rpx;color:#edf6f2}.wins{margin-top:17rpx;display:grid;gap:8rpx}.wins view{font-size:21rpx;color:#d6f29b}.focus,.action{margin-top:18rpx;padding:18rpx;border-radius:22rpx;background:rgba(255,255,255,.07)}.focus text,.action text{display:block}.focus text:first-child,.action text:first-child{font-size:16rpx;letter-spacing:2rpx;color:#98b7aa}.focus text:last-child,.action text:last-child{font-size:23rpx;font-weight:700;margin-top:5rpx}.caution{font-size:18rpx;line-height:1.55;opacity:.55;margin-top:18rpx}.ai-line{height:24rpx;width:360rpx;border-radius:8rpx}.ai-line.short{width:220rpx;margin-top:10rpx}.ai-block{height:130rpx;border-radius:20rpx;margin-top:24rpx;background:#244b40}.chart-card{padding:20rpx 18rpx 8rpx}.tabs{display:flex;gap:8rpx;background:#f0f4f2;border-radius:18rpx;padding:6rpx}.tabs view{flex:1;text-align:center;padding:12rpx 4rpx;font-size:20rpx;color:#77847f;border-radius:14rpx}.tabs view.on{background:#fff;color:#1c5443;font-weight:750;box-shadow:0 4rpx 16rpx rgba(24,78,63,.08)}.chart-meta{display:flex;justify-content:space-between;align-items:center;padding:20rpx 10rpx 6rpx}.chart-meta text:first-child{font-size:25rpx;font-weight:800}.chart-meta text:last-child{font-size:18rpx;color:#7f8d87}.week-canvas{width:100%;height:430rpx}.insights view{display:flex;gap:16rpx;align-items:center;padding:16rpx 0;border-top:1rpx solid #edf1ef}.insights view:first-child{border-top:0}.insights>view>text:first-child{color:#2f7b63}.insights .b{font-size:25rpx}.sk-hero{height:330rpx;border-radius:40rpx}.sk-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.sk-card{height:135rpx;border-radius:30rpx}.sk-chart{height:510rpx;border-radius:30rpx;margin-top:32rpx}.shimmer{background:linear-gradient(100deg,#e3eae6 20%,#f6f8f7 40%,#e3eae6 60%);background-size:220% 100%;animation:shimmer 1.3s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
.facts-card{padding:25rpx}.facts-title{font-size:27rpx;font-weight:820}.facts-sub{font-size:18rpx;color:#87938e;margin-top:4rpx}.quality{font-size:18rpx;background:#edf5f1;color:#28614f;padding:8rpx 13rpx;border-radius:999rpx}.coverage{font-size:22rpx;font-weight:700;margin-top:20rpx}.compare{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin-top:16rpx}.compare view{display:flex;justify-content:space-between;background:#f3f6f4;border-radius:16rpx;padding:13rpx 15rpx;font-size:19rpx}.compare .up{color:#277359}.compare .down{color:#9a6548}.compare .flat{color:#7e8b86}.facts-note{font-size:18rpx;color:#8a9691;line-height:1.55;margin-top:16rpx}
