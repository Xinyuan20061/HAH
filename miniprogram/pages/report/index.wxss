.facts-card{padding:24rpx}.facts-title{font-size:27rpx;font-weight:820}.facts-sub{font-size:18rpx;color:#5f665f;margin-top:4rpx}.quality{font-size:18rpx;background:#f7f7f2;color:#506336;padding:8rpx 12rpx;border-radius:999rpx}.coverage{font-size:22rpx;font-weight:700;margin-top:20rpx}.compare{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:16rpx}.compare view{display:flex;justify-content:space-between;background:#f7f7f2;border-radius:16rpx;padding:12rpx 16rpx;font-size:19rpx}.compare .up{color:#506336}.compare .down{color:#9a6548}.compare .flat{color:#5f665f}.facts-note{font-size:18rpx;color:#5f665f;line-height:1.55;margin-top:16rpx}
