.report-page{background:linear-gradient(180deg,#f7f7f2 0,#f7f7f2 380rpx)}.report-hero{background:linear-gradient(140deg,#111613,#111613 58%,#2f3a1e);color:white;border-radius:40rpx;padding:32rpx;box-shadow:0 24rpx 70rpx rgba(17,22,19,.18);position:relative;overflow:hidden}.report-hero:after{content:"";position:absolute;width:260rpx;height:260rpx;border-radius:50%;background:rgba(196,226,103,.13);right:-80rpx;top:-100rpx}.kicker{font-size:19rpx;letter-spacing:2rpx;opacity:.68}.hero-title{font-size:38rpx;font-weight:800;line-height:1.35;margin-top:16rpx;position:relative;z-index:2}.hero-note{font-size:22rpx;line-height:1.6;opacity:.72;margin-top:32rpx}.hero-streak{display:inline-block;margin-top:20rpx;padding:12rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.1);font-size:19rpx}.score-ring{width:128rpx;height:128rpx;border-radius:50%;border:12rpx solid #c4e267;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;z-index:2}.score-ring .b{color:#fff;font-size:38rpx;font-weight:850}.score-ring .small{color:rgba(255,255,255,.75);font-size:16rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx;margin-bottom:24rpx}.metric{margin:0}.metric .b,.metric .small{display:block}.metric .b{font-size:38rpx;font-weight:800}.metric .small{font-size:20rpx;color:#5f665f;margin-top:4rpx}.ai-summary{background:#111613;color:#fff}.ai-head{display:flex;align-items:center;gap:16rpx}.ai-orb{width:62rpx;height:62rpx;border-radius:50%;background:#c4e267;display:flex;align-items:center;justify-content:center}.ai-orb image{width:62rpx;height:62rpx}.provider{font-size:15rpx;letter-spacing:2rpx;color:#f7f7f2}.ai-title{font-size:28rpx;font-weight:850;margin-top:4rpx}.ai-text{font-size:23rpx;line-height:1.7;margin-top:24rpx;color:#edf6f2}.wins{margin-top:16rpx;display:grid;gap:8rpx}.wins view{display:flex;align-items:center;gap:12rpx;font-size:21rpx;color:#c4e267}.wins image{width:28rpx;height:28rpx;flex:none}.focus,.action