.trends-page{background:linear-gradient(180deg,#f7f7f2 0,#f7f7f2 340rpx)}.intro{margin-top:8rpx;margin-bottom:32rpx}.summary{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:24rpx}.sum{margin:0;padding:24rpx}.sum-v{font-size:36rpx;font-weight:740;display:inline}.sum-u{display:inline;font-size:19rpx;color:#506336;margin-left:4rpx}.sum-k{font-size:21rpx;margin-top:8rpx}.chart-card{padding:20rpx 20rpx 12rpx}.tabs{display:flex;gap:8rpx;background:#f7f7f2;border-radius:18rpx;padding:8rpx}.tabs view{flex:1;text-align:center;padding:12rpx 4rpx;font-size:20rpx;color:#5f665f;border-radius:14rpx}.tabs view.on{background:#fff;color:#111613;font-weight:750;box-shadow:0 4rpx 16rpx rgba(17,22,19,.08)}.chart-meta{display:flex;justify-content:space-between;align-items:center;padding:20rpx 12rpx 8rpx}.chart-meta text:first-child{font-size:25rpx;font-weight:800}.chart-meta text:last-child{font-size:18rpx;color:#5f665f}.trend-canvas{width:100%;height:430rpx}.table{padding:12rpx 20rpx}.table-row{display:grid;grid-template-columns:.8fr 1fr .8fr .8fr 1fr;gap:8rpx;align-items:center;padding:20rpx 0;border-top:1rpx solid #eeeee6;font-size:19rpx;color:#5f665f;text-align:center}.table-row text:first-child{text-align:left}.table-row.head{border-top:0;color:#506336;font-size:17rpx}.sk-row{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.sk{height:150rpx;border-radius:30rpx}.sk-chart{height:520rpx;border-radius:30rpx;margin-top:24rpx}.shimmer{background:linear-gradient(100deg,#e9efd9 20%,#f7f7f2 40%,#e9efd9 60%);background-size:220% 100%;animation:shimmer 1.3s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
