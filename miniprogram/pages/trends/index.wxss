.trends-page{background:linear-gradient(180deg,#f0f6f3 0,#f7f9f8 340rpx)}.intro{margin-top:8rpx;margin-bottom:28rpx}.summary{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:16rpx}.sum{margin:0;padding:23rpx}.sum-v{font-size:36rpx;font-weight:740;display:inline}.sum-u{display:inline;font-size:19rpx;color:#95A09B;margin-left:5rpx}.sum-k{font-size:21rpx;margin-top:8rpx}.chart-card{padding:20rpx 18rpx 10rpx}.tabs{display:flex;gap:8rpx;background:#f0f4f2;border-radius:18rpx;padding:6rpx}.tabs view{flex:1;text-align:center;padding:12rpx 4rpx;font-size:20rpx;color:#77847f;border-radius:14rpx}.tabs view.on{background:#fff;color:#1c5443;font-weight:750;box-shadow:0 4rpx 16rpx rgba(24,78,63,.08)}.chart-meta{display:flex;justify-content:space-between;align-items:center;padding:20rpx 10rpx 6rpx}.chart-meta text:first-child{font-size:25rpx;font-weight:800}.chart-meta text:last-child{font-size:18rpx;color:#7f8d87}.trend-canvas{width:100%;height:430rpx}.table{padding:10rpx 18rpx}.table-row{display:grid;grid-template-columns:.8fr 1fr .8fr .8fr 1fr;gap:6rpx;align-items:center;padding:18rpx 0;border-top:1rpx solid #edf1ef;font-size:19rpx;color:#65736d;text-align:center}.table-row text:first-child{text-align:left}.table-row.head{border-top:0;color:#98a29e;font-size:17rpx}.sk-row{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.sk{height:150rpx;border-radius:30rpx}.sk-chart{height:520rpx;border-radius:30rpx;margin-top:26rpx}.shimmer{background:linear-gradient(100deg,#e5ece8 20%,#f5f8f6 40%,#e5ece8 60%);background-size:220% 100%;animation:shimmer 1.3s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
