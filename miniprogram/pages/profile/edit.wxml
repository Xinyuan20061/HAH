<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page ui-page-content"><view class="intro"><view class="title">健康档案</view></view><view class="card"><view class="label">年龄</view><input class="input" type="number" value="{{form.age}}" data-k="age" bindinput="inp"/><view class="two"><view><view class="label">身高 cm</view><input class="input" type="digit" value="{{form.height_cm}}" data-k="height_cm" bindinput="inp"/></view><view><view class="label">体重 kg</view><input class="input" type="digit" value="{{form.weight_kg}}" data-k="weight_kg" bindinput="inp"/></view></view><view class="label">当前目标</view><picker range="{{goals}}" bindchange="goal"><view class="input">{{goals[goalIndex]}}</view></picker><view class="label">活动水平</view><picker range="{{activities}}" bindchange="activity"><view class="input">{{activities[activityIndex]}}</view></picker><view class="label">饮食偏好（可选）</view><input class="input" value="{{form.diet_preference}}" placeholder="例如：清淡、素食" data-k="diet_preference" bindinput="inp"/><view class="label">过敏信息（可选）</view><input class="input" value="{{form.allergies}}" placeholder="例如：花生、牛奶" data-k="allergies" bindinput="inp"/></view><button class="btn-primary tappable" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存健康档案</button></view>
