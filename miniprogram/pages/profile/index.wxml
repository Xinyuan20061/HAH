<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page profile-page ui-page-content">
  <view wx:if="{{loading}}" class="profile-skeleton">
    <view class="skeleton-line avatar-skeleton"></view>
    <view class="skeleton-copy"><view class="skeleton-line name-skeleton"></view><view class="skeleton-line sub-skeleton"></view></view>
    <view class="skeleton-line facts-skeleton"></view><view class="skeleton-line feature-skeleton"></view>
  </view>

  <view wx:elif="{{error}}" class="state-card state-card-error">
    <view class="grow"><view class="state-title">个人信息暂时没有加载出来</view><view class="state-desc">{{error}}</view></view>
    <button class="retry-btn tappable" bindtap="retry" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">重试</button>
  </view>

  <block wx:else>
    <view class="identity">
      <view class="avatar-shell ui-fixed-circle tappable" bindtap="openEdit" hover-class="tap-card" hover-start-time="0" hover-stay-time="80" aria-label="编辑头像与昵称">
        <image wx:if="{{avatarSrc}}" class="avatar-img" src="{{avatarSrc}}" mode="aspectFill"/>
        <view wx:else class="avatar-text">{{initial}}</view>
      </view>
      <view class="head-info">
        <view class="identity-kicker">个人健康空间</view>
        <view class="name-row">
          <text class="name">{{user.nickname||'微信用户'}}</text>
          <view class="edit-orb ui-fixed-circle tappable" bindtap="openEdit" hover-class="tap" hover-start-time="0" hover-stay-time="80" aria-label="编辑个人资料"><image src="/assets/icons/edit.png" mode="aspectFit"/></view>
        </view>
        <view class="goal-chip">{{goalText||'完善健康档案'}}</view>
      </view>
    </view>

    <view wx:if="{{profile}}" class="facts-strip tappable" bindtap="edit" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
      <view class="fact"><text class="fact-value">{{profile.age}}</text><text class="fact-unit">岁</text><view class="fact-label">年龄</view></view>
      <view class="fact-divider"></view>
      <view class="fact"><text class="fact-value">{{profile.height_cm}}</text><text class="fact-unit">cm</text><view class="fact-label">身高</view></view>
      <view class="fact-divider"></view>
      <view class="fact"><text class="fact-value">{{profile.weight_kg}}</text><text class="fact-unit">kg</text><view class="fact-label">体重</view></view>
      <image class="facts-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/>
    </view>
    <view wx:else class="profile-prompt tappable" bindtap="edit" hover-class="tap-card" hover-start-time="0" hover-stay-time="80"><view><view class="prompt-title">完善身体资料</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>

    <view class="section-heading"><text>健康中心</text></view>
    <view class="health-grid">
      <view class="goal-feature tappable" bindtap="goals" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
        <view class="feature-top"><view class="feature-orb ui-fixed-circle"><image src="/assets/icons/target.png" mode="aspectFit"/></view><image class="feature-arrow ui-fixed-circle" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
        <view class="feature-kicker">当前目标</view><view class="feature-title">{{goalText||'设置目标'}}</view>
      </view>
      <view class="side-stack">
        <view class="mini-feature trend-feature tappable" bindtap="trends" hover-class="tap-card" hover-start-time="0" hover-stay-time="80"><view class="mini-orb ui-fixed-circle"><image src="/assets/icons/trend.png" mode="aspectFit"/></view><view><view class="mini-title">7 日趋势</view></view></view>
        <view class="mini-feature tappable" bindtap="insights" hover-class="tap-card" hover-start-time="0" hover-stay-time="80"><view class="mini-orb ui-fixed-circle light"><image src="/assets/icons/bell.png" mode="aspectFit"/></view><view><view class="mini-title">健康提醒</view></view></view>
      </view>
    </view>

    <view class="section-heading settings-heading"><text>偏好与安全</text></view>
    <view class="settings-entry tappable" bindtap="settings" hover-class="tap-card" hover-start-time="0" hover-stay-time="80"><view class="settings-orb ui-fixed-circle"><image src="/assets/icons/settings.png" mode="aspectFit"/></view><view class="settings-title">设置</view><view class="settings-meta">服务与偏好</view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="notice">健康建议不替代医生诊断。</view>
  </block>

  <view class="mask tappable" wx:if="{{editing}}" bindtap="closeEdit" hover-class="tap" hover-start-time="0" hover-stay-time="80"></view>
  <view class="edit-panel" wx:if="{{editing}}">
    <view class="panel-handle"></view><view class="panel-title">编辑个人资料</view>
    <view class="avatar-shell ui-fixed-circle big">
      <image wx:if="{{avatarSrc}}" class="avatar-img" src="{{avatarSrc}}" mode="aspectFill"/><view wx:else class="avatar-text">{{initial}}</view>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择头像"></button>
    </view>
    <input class="nick-input" type="nickname" placeholder="填写昵称" value="{{nickDraft}}" bindinput="onNickInput" maxlength="30"/>
    <view class="panel-btns"><button class="btn ghost tappable" bindtap="closeEdit" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">取消</button><button class="btn primary tappable" bindtap="saveProfile" loading="{{saving}}" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存</button></view>
  </view>
</view>
