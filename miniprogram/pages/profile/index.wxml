<view class="page">
  <view class="profile-head">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换头像">
      <image wx:if="{{avatarSrc}}" class="avatar-img" src="{{avatarSrc}}" mode="aspectFill"/>
      <text wx:else class="avatar-text">{{initial}}</text>
    </button>
    <view class="head-info">
      <view class="name-row">
        <text class="name">{{user.nickname||'微信用户'}}</text>
        <view class="edit-link tappable" bindtap="openEdit" hover-class="tap" hover-start-time="0" hover-stay-time="80">编辑昵称</view>
      </view>
    </view>
  </view>
  <view class="menu-list">
    <view class="menu-row tappable" bindtap="edit" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box"><image class="ui-icon-image" src="/assets/icons/profile-card.png" mode="aspectFit"/></view><view><view class="info-title">身体资料</view><view class="muted menu-desc" wx:if="{{profile}}">{{profile.height_cm}} cm · {{profile.weight_kg}} kg · {{goalText}}</view></view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="goals" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/target.png" mode="aspectFit"/></view><view class="info-title">健康目标</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="trends" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/trend.png" mode="aspectFit"/></view><view class="info-title">7 日趋势</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="insights" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/bell.png" mode="aspectFit"/></view><view class="info-title">健康提醒</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="aiSettings" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/settings.png" mode="aspectFit"/></view><view><view class="info-title">识别与回答偏好</view><view class="muted menu-desc">{{ai.enabled&&ai.has_api_key?'已使用个人配置':'使用默认配置'}}</view></view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="privacy" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/shield.png" mode="aspectFit"/></view><view class="info-title">隐私与安全</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
    <view class="menu-row tappable" bindtap="evaluation" hover-class="tap" hover-start-time="0" hover-stay-time="80"><view class="menu-main"><view class="ui-icon-box soft"><image class="ui-icon-image" src="/assets/icons/report.png" mode="aspectFit"/></view><view class="info-title">运行与评测</view></view><image class="ui-chevron" src="/assets/icons/chevron.png" mode="aspectFit"/></view>
  </view>
  <view class="notice">健康建议不替代医生诊断。</view>

  <view class="mask tappable" wx:if="{{editing}}" bindtap="closeEdit" hover-class="tap" hover-start-time="0" hover-stay-time="80"></view>
  <view class="edit-panel" wx:if="{{editing}}">
    <view class="panel-title">编辑资料</view>
    <button class="avatar-btn big" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择头像">
      <image wx:if="{{avatarSrc}}" class="avatar-img big" src="{{avatarSrc}}" mode="aspectFill"/>
      <text wx:else class="avatar-text big">{{initial}}</text>
    </button>
    <view class="hint">点头像：可用微信头像，也可从相册选择</view>
    <input class="nick-input" type="nickname" placeholder="填写昵称" value="{{nickDraft}}" bindinput="onNickInput" maxlength="30"/>
    <view class="hint">点一下昵称输入框，键盘可直接带出微信昵称</view>
    <view class="panel-btns">
      <button class="btn ghost tappable" bindtap="closeEdit" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">取消</button>
      <button class="btn primary tappable" bindtap="saveProfile" loading="{{saving}}" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存</button>
    </view>
  </view>
</view>
