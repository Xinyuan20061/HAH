.profile-head{display:flex;align-items:center;padding:24rpx 4rpx 40rpx}.avatar-btn{margin:0;padding:0;background:none;border:3rpx solid #eeeee6;line-height:1;width:120rpx;height:120rpx;border-radius:22rpx;overflow:hidden;display:block;flex-shrink:0}.avatar-btn::after{border:none}.avatar-img{width:120rpx;height:120rpx;border-radius:22rpx;display:block;background:#f7f7f2}.avatar-text{width:120rpx;height:120rpx;border-radius:22rpx;background:#e9efd9;display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:750;color:#506336}.head-info{flex:1;min-width:0;margin-left:32rpx}.name-row{display:flex;align-items:flex-start;min-width:0}.name{font-size:34rpx;font-weight:750;flex:1;min-width:0;word-break:break-all;line-height:1.35}.edit-link{font-size:22rpx;color:#506336;margin-left:16rpx;padding:8rpx 16rpx;background:#e9efd9;border-radius:999rpx;flex-shrink:0;white-space:nowrap}.muted{font-size:22rpx;opacity:1;margin-top:8rpx;line-height:1.5;max-width:500rpx}.menu-list{background:#fff;border:1rpx solid #eeeee6;border-radius:24rpx;margin:0;padding:0 24rpx;overflow:hidden}.menu-row{display:flex;align-items:center;justify-content:space-between;min-height:112rpx;padding:20rpx 4rpx;color:#111613;font-size:30rpx}.menu-row+.menu-row{border-top:1rpx solid #eeeee6}.menu-main{display:flex;align-items:center;gap:20rpx;min-width:0}.menu-main .ui-icon-box{width:58rpx;height:58rpx}.menu-main .ui-icon-image{width:32rpx;height:32rpx}.info-title{font-size:27rpx;font-weight:700}.menu-desc{font-size:20rpx;margin-top:4rpx}.notice{text-align:center;font-size:22rpx;opacity:1;padding:24rpx 0 40rpx}
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(17,22,19,.45);z-index:90}.edit-panel{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:32rpx 32rpx 0 0;padding:40rpx 32rpx 48rpx;z-index:91;color:#111613}.panel-title{font-size:32rpx;font-weight:750;text-align:center;margin-bottom:32rpx}.avatar-btn.big{width:150rpx;height:150rpx;border-radius:28rpx;margin:0 auto}.avatar-img.big{width:150rpx;height:150rpx;border-radius:28rpx}.avatar-text.big{width:150rpx;height:150rpx;border-radius:28rpx;font-size:60rpx;background:#f7f7f2;color:#506336}.hint{font-size:22rpx;color:#5f665f;text-align:center;margin:16rpx 0 24rpx}.nick-input{background:#f7f7f2;border-radius:18rpx;padding:24rpx 24rpx;font-size:28rpx;color:#111613}.panel-btns{display:flex;gap:20rpx;margin-top:32rpx}.btn{flex:1;border-radius:18rpx;font-size:30rpx;font-weight:650;height:88rpx;line-height:88rpx;padding:0}.btn::after{border:none}.btn.ghost{background:#f7f7f2;color:#111613}.btn.primary{background:#c4e267;color:#111613}
