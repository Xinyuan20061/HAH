.profile-page{padding-top:32rpx}
.identity{display:flex;align-items:center;padding:8rpx 4rpx 32rpx}
.avatar-shell{position:relative;display:block;width:128rpx;min-width:128rpx;max-width:128rpx;height:128rpx;min-height:128rpx;max-height:128rpx;box-sizing:border-box;flex:0 0 128rpx;margin:0;padding:8rpx;overflow:hidden;border-radius:999rpx;background:#fff;box-shadow:0 12rpx 32rpx rgba(17,22,19,.08)}
.avatar-img,.avatar-text{display:flex;width:100%;height:100%;box-sizing:border-box;align-items:center;justify-content:center;overflow:hidden;border-radius:999rpx;background:#e9efd9}.avatar-img{display:block}.avatar-text{color:#506336;font-size:44rpx;font-weight:760}
.head-info{flex:1;min-width:0;margin-left:24rpx}.identity-kicker{color:#506336;font-size:20rpx;font-weight:700;letter-spacing:2rpx}.name-row{display:flex;align-items:center;min-width:0;margin-top:4rpx}.name{overflow:hidden;flex:1;min-width:0;color:#111613;font-size:40rpx;font-weight:780;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.edit-orb{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;flex:none;margin-left:12rpx;border-radius:50%;background:#fff}.edit-orb image{width:28rpx;height:28rpx}.goal-chip{display:inline-flex;margin-top:8rpx;padding:4rpx 16rpx;border-radius:999rpx;background:#e9efd9;color:#506336;font-size:19rpx}
.facts-strip{position:relative;display:grid;grid-template-columns:1fr 1rpx 1fr 1rpx 1fr;align-items:center;margin-bottom:32rpx;padding:24rpx 48rpx 24rpx 24rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035);text-align:center}.fact{min-width:0}.fact-value{font-size:32rpx;font-weight:760}.fact-unit{margin-left:4rpx;color:#5f665f;font-size:17rpx}.fact-label{margin-top:4rpx;color:#5f665f;font-size:18rpx}.fact-divider{width:1rpx;height:48rpx;background:#eeeee6}.facts-chevron{position:absolute;right:12rpx;width:32rpx;height:32rpx;opacity:.64}
.profile-prompt{display:flex;align-items:center;justify-content:space-between;margin-bottom:32rpx;padding:24rpx;border-radius:24rpx;background:#fff}.prompt-title{font-size:26rpx;font-weight:720}.prompt-copy{margin-top:4rpx;color:#5f665f;font-size:20rpx}
.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.section-heading text:first-child{font-size:28rpx;font-weight:760}.section-heading text:last-child{color:#5f665f;font-size:18rpx}
.health-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:16rpx;margin-bottom:32rpx}.goal-feature{display:flex;min-height:288rpx;flex-direction:column;padding:24rpx;border-radius:28rpx;background:#111613;color:#fff;box-shadow:0 16rpx 36rpx rgba(17,22,19,.14)}.feature-top{display:flex;align-items:center;justify-content:space-between}.feature-orb{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;border-radius:50%;background:#c4e267}.feature-orb image{width:38rpx;height:38rpx}.feature-arrow{width:48rpx;height:48rpx;padding:8rpx;border-radius:50%;background:#c4e267;box-sizing:border-box;opacity:.84}.feature-kicker{margin-top:auto;color:#c4e267;font-size:18rpx;font-weight:700;letter-spacing:2rpx}.feature-title{margin-top:4rpx;font-size:36rpx;font-weight:780}.feature-copy{margin-top:8rpx;color:#f7f7f2;font-size:18rpx;line-height:1.5;opacity:.72}
.side-stack{display:flex;min-width:0;flex-direction:column;gap:16rpx}.mini-feature{display:flex;min-height:136rpx;align-items:center;gap:12rpx;flex:1;padding:20rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}.trend-feature{background:#e9efd9}.mini-orb{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;flex:none;border-radius:50%;background:#fff}.mini-orb.light{background:#f7f7f2}.mini-orb image{width:32rpx;height:32rpx}.mini-title{font-size:23rpx;font-weight:740;white-space:nowrap}.mini-copy{margin-top:4rpx;color:#5f665f;font-size:17rpx;white-space:nowrap}
.settings-heading{margin-top:4rpx}.utility-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.utility{display:flex;min-width:0;flex-direction:column;align-items:center;padding:20rpx 8rpx;color:#5f665f;font-size:19rpx;text-align:center}.utility-orb{position:relative;display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;margin-bottom:12rpx;border:1rpx solid #eeeee6;border-radius:50%;background:#fff;box-shadow:0 8rpx 24rpx rgba(17,22,19,.04)}.utility-orb image{width:36rpx;height:36rpx}.config-dot{position:absolute;right:0;top:0;width:16rpx;height:16rpx;border:4rpx solid #f7f7f2;border-radius:50%;background:#b7bcb2}.config-dot.on{background:#c4e267}.notice{text-align:center;padding:32rpx 0 40rpx;color:#5f665f;font-size:19rpx}
.retry-btn{flex:none;margin:0;padding:0 20rpx;min-height:64rpx;border:0;border-radius:999rpx;background:#e9efd9;color:#111613;font-size:21rpx;line-height:64rpx}.retry-btn::after{border:0}
.profile-skeleton{display:grid;grid-template-columns:128rpx 1fr;align-items:center;gap:24rpx}.avatar-skeleton{width:128rpx;height:128rpx;border-radius:50%}.skeleton-copy{display:grid;gap:16rpx}.name-skeleton{width:64%;height:32rpx}.sub-skeleton{width:40%;height:20rpx}.facts-skeleton,.feature-skeleton{grid-column:1/-1;height:136rpx;margin-top:8rpx}.feature-skeleton{height:288rpx;margin-top:0;border-radius:28rpx}
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(17,22,19,.45);z-index:90}.edit-panel{position:fixed;left:0;right:0;bottom:0;padding:12rpx 32rpx 48rpx;border-radius:32rpx 32rpx 0 0;background:#fff;color:#111613;z-index:91}.panel-handle{width:64rpx;height:8rpx;margin:0 auto 20rpx;border-radius:999rpx;background:#eeeee6}.panel-title{margin-bottom:32rpx;font-size:32rpx;font-weight:750;text-align:center}.avatar-shell.big{width:152rpx;min-width:152rpx;max-width:152rpx;height:152rpx;min-height:152rpx;max-height:152rpx;flex-basis:152rpx;margin:0 auto}.avatar-shell.big .avatar-text{background:#f7f7f2;color:#506336;font-size:60rpx}.avatar-picker{position:absolute;left:0;top:0;width:100%;height:100%;margin:0;padding:0;border:0;border-radius:999rpx;opacity:0;z-index:2}.avatar-picker::after{border:0}.hint{margin:16rpx 0 24rpx;color:#5f665f;font-size:21rpx;text-align:center}.nick-input{padding:24rpx;border-radius:20rpx;background:#f7f7f2;color:#111613;font-size:28rpx}.input-hint{margin-bottom:0}.panel-btns{display:flex;gap:20rpx;margin-top:32rpx}.btn{height:88rpx;flex:1;margin:0;padding:0;border-radius:20rpx;font-size:28rpx;font-weight:650;line-height:88rpx}.btn::after{border:0}.btn.ghost{background:#f7f7f2;color:#111613}.btn.primary{background:#c4e267;color:#111613}
