.profile-head{display:flex;align-items:center;padding:36rpx 30rpx}.avatar-btn{margin:0;padding:0;background:none;border:3rpx solid rgba(255,255,255,.35);line-height:1;width:120rpx;height:120rpx;border-radius:22rpx;overflow:hidden;display:block;flex-shrink:0}.avatar-btn::after{border:none}.avatar-img{width:120rpx;height:120rpx;border-radius:22rpx;display:block;background:#EDF1EE}.avatar-text{width:120rpx;height:120rpx;border-radius:22rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:750;color:#fff}.head-info{flex:1;min-width:0;margin-left:28rpx}.name-row{display:flex;align-items:flex-start;min-width:0}.name{font-size:34rpx;font-weight:750;flex:1;min-width:0;word-break:break-all;line-height:1.35}.edit-link{font-size:22rpx;color:rgba(255,255,255,.75);margin-left:16rpx;padding:6rpx 14rpx;background:rgba(255,255,255,.14);border-radius:999rpx;flex-shrink:0;white-space:nowrap}.muted{font-size:22rpx;opacity:.72;margin-top:8rpx;line-height:1.5;max-width:500rpx}.menu-list{background:#fff;border-radius:28rpx;margin:0 24rpx;padding:0 26rpx;overflow:hidden}.menu-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 4rpx;color:#1d2823;font-size:30rpx}.menu-row+.menu-row{border-top:1rpx solid #EFF2F0}.info-title{font-size:28rpx;font-weight:700}.menu-desc{font-size:22rpx;margin-top:6rpx}.notice{text-align:center;font-size:22rpx;opacity:.55;padding:26rpx 0 40rpx}
.mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:90}.edit-panel{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:32rpx 32rpx 0 0;padding:36rpx 34rpx 48rpx;z-index:91;color:#1d2823}.panel-title{font-size:32rpx;font-weight:750;text-align:center;margin-bottom:30rpx}.avatar-btn.big{width:150rpx;height:150rpx;border-radius:28rpx;margin:0 auto}.avatar-img.big{width:150rpx;height:150rpx;border-radius:28rpx}.avatar-text.big{width:150rpx;height:150rpx;border-radius:28rpx;font-size:60rpx;background:#EDF1EE;color:#4A6A5C}.hint{font-size:22rpx;color:#8A9490;text-align:center;margin:14rpx 0 26rpx}.nick-input{background:#F4F6F5;border-radius:18rpx;padding:22rpx 24rpx;font-size:28rpx;color:#1d2823}.panel-btns{display:flex;gap:20rpx;margin-top:34rpx}.btn{flex:1;border-radius:18rpx;font-size:30rpx;font-weight:650;height:88rpx;line-height:88rpx;padding:0}.btn::after{border:none}.btn.ghost{background:#F2F4F3;color:#33413B}.btn.primary{background:#2E7D5B;color:#fff}
