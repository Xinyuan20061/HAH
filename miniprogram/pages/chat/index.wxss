.chat-page{height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#f7f7f2,#f7f7f2 360rpx)}.messages{flex:1;padding:24rpx 32rpx;box-sizing:border-box}.context{background:linear-gradient(145deg,#111613,#111613);color:white;border-radius:34rpx;padding:32rpx;margin-bottom:32rpx;box-shadow:0 20rpx 60rpx rgba(17,22,19,.16)}.context-head{display:flex;align-items:center;gap:16rpx}.ai-orb{width:58rpx;height:58rpx;border-radius:20rpx;background:#c4e267;color:#111613;display:flex;align-items:center;justify-content:center;font-size:28rpx}.ai-kicker{font-size:16rpx;letter-spacing:2rpx;color:#f7f7f2}.context-title{font-size:31rpx;font-weight:780;margin-top:4rpx}.settings{font-size:20rpx;color:#c4e267}.context-desc{font-size:21rpx;line-height:1.6;color:rgba(255,255,255,.68);margin-top:20rpx}.chips{margin-top:20rpx}.chips text,.chips view{display:inline-block;background:rgba(255,255,255,.1);border:1rpx solid rgba(255,255,255,.1);border-radius:999rpx;padding:12rpx 16rpx;margin:0 8rpx 8rpx 0;font-size:20rpx;color:#eaf5f0}.msg{display:flex;align-items:flex-end;gap:12rpx;margin:24rpx 0}.msg.user{justify-content:flex-end}.avatar-mini{width:48rpx;height:48rpx;border-radius:17rpx;background:#c4e267;color:#111613;display:flex;align-items:center;justify-content:center;font-size:21rpx;flex-shrink:0}.bubble{max-width:78%;padding:20rpx 24rpx;border-radius:25rpx;line-height:1.72;font-size:25rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(17,22,19,.045)}.user .bubble{background:#c4e267;color:#111613;border-bottom-right-radius:8rpx}.assistant .bubble{border-bottom-left-radius:8rpx}.cursor{color:#506336;animation:blink 1s infinite}@keyframes blink{50%{opacity:.15}}.bottom-space{height:16rpx}.composer{background:rgba(255,255,255,.96);padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-end;gap:16rpx;border-top:1rpx solid #e9efd9}.composer textarea{flex:1;background:#f7f7f2;border-radius:25rpx;min-height:48rpx;max-height:180rpx;padding:20rpx 20rpx;font-size:24rpx}.composer button{width:116rpx;height:84rpx;background:#c4e267;color:#111613;border-radius:25rpx;font-size:24rpx;margin:0;display:flex;align-items:center;justify-content:center}.composer button::after{border:none}
.agent-plan{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e9efd9}.agent-plan-kicker{font-size:16rpx;letter-spacing:2rpx;color:#506336;font-weight:800}.agent-plan-title{font-size:25rpx;font-weight:820;margin:8rpx 0 12rpx}.agent-item{display:flex;gap:12rpx;padding:12rpx 0}.dot{width:34rpx;height:34rpx;border-radius:12rpx;background:#f7f7f2;color:#111613;display:flex;align-items:center;justify-content:center;font-size:17rpx;font-weight:800;flex-shrink:0}.ap-title{font-size:21rpx;font-weight:750}.ap-desc{font-size:18rpx;line-height:1.5;color:#5f665f;margin-top:4rpx}.agent-plan button{margin-top:16rpx;background:#c4e267;color:#111613;border-radius:20rpx;font-size:21rpx;font-weight:800}.agent-plan button::after{border:none}.applied{margin-top:16rpx;background:#f7f7f2;color:#506336;border-radius:18rpx;padding:16rpx;text-align:center;font-size:20rpx;font-weight:750}

.action-flow{display:flex;align-items:center;gap:8rpx;margin:12rpx 0 8rpx}.action-flow text{font-size:16rpx;color:#506336;background:#f7f7f2;border-radius:999rpx;padding:8rpx 12rpx;transform:scale(.96);transition:background-color .32s ease-out,transform .32s cubic-bezier(.2,.8,.2,1),box-shadow .32s ease-out}.action-flow text.active{color:#7b5b1e;background:#fff2cf;transform:scale(1);box-shadow:0 0 0 4rpx rgba(17,22,19,.12)}.action-flow text.done{color:#111613;background:#f7f7f2;transform:scale(1)}.action-flow .action-line{display:block;width:18rpx;height:2rpx;background:#e9efd9;flex:none;transition:background-color .32s ease-out}.action-flow .action-line.on{background:#e9efd9}.safety-note{margin-top:16rpx;border-radius:16rpx;background:#fff0ed;color:#8d433c;padding:12rpx 16rpx;font-size:18rpx;line-height:1.5}
.resource-list{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e9efd9}.resource-card{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#f7f7f2}.resource-platform{font-size:17rpx;color:#506336}.resource-title{font-size:22rpx;font-weight:800;margin-top:8rpx}.resource-summary{font-size:18rpx;color:#5f665f;line-height:1.5;margin-top:4rpx}.resource-meta{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;color:#5f665f;font-size:17rpx}.resource-meta button{margin:0;background:#c4e267;color:#111613;border-radius:999rpx;font-size:17rpx;line-height:2}.resource-meta button::after{border:none}
.knowledge-list{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e9efd9}.knowledge-card{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#f7f7f2;border-left:5rpx solid #52728d}.knowledge-label{font-size:17rpx;color:#52728d;font-weight:750}
.adjustment-card{margin-top:16rpx;padding:16rpx;border-radius:19rpx;background:#fff7df;border:1rpx solid #f0ddb0}.adjustment-summary{font-size:21rpx;font-weight:760;color:#6c5422;margin-top:8rpx}.adjustment-reason{margin-top:12rpx;font-size:18rpx;line-height:1.5;color:#726649}.adjustment-reason text{font-weight:800;color:#59451c}.adjustment-applied{margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid #ead9ae;font-size:17rpx;color:#7b622b}
.exercise-recommendations{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e9efd9}.exercise-rec{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#f7f7f2}.exercise-rec .row{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.rec-score{width:66rpx;height:66rpx;border-radius:20rpx;background:#c4e267;color:#111613;display:flex;align-items:center;justify-content:center;font-size:23rpx;font-weight:850;flex:none}.rec-support{font-size:16rpx;color:#506336;margin-top:8rpx}
.trace-card {margin-top: 24rpx;padding: 20rpx;border: 1rpx solid #e9efd9;border-radius: 18rpx;background: #f7f7f2; }
.trace-head {display: flex;align-items: center;gap: 16rpx; }
.trace-icon {display: flex;align-items: center;justify-content: center;width: 42rpx;height: 42rpx;flex: none;border-radius: 50%;color:#111613;background: #c4e267;font-size: 20rpx; }
.trace-kicker {color: #506336;font-size: 21rpx;font-weight: 680; }
.trace-owner {margin-top: 4rpx;color: #5f665f;font-size: 18rpx; }
.trace-reasons {display: flex;flex-wrap: wrap;gap: 12rpx;margin-top: 16rpx; }
.trace-reasons text {padding: 8rpx 12rpx;border-radius: 999rpx;color: #506336;background: #fff;font-size: 18rpx; }
.trace-default {margin-top: 16rpx;color: #506336;font-size: 19rpx;line-height: 1.6; }
