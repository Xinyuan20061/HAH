.chat-page{height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#eef5f1,#f5f8f6 360rpx)}.messages{flex:1;padding:24rpx 28rpx;box-sizing:border-box}.context{background:linear-gradient(145deg,#153d33,#255d4d);color:white;border-radius:34rpx;padding:28rpx;margin-bottom:28rpx;box-shadow:0 20rpx 60rpx rgba(27,70,55,.16)}.context-head{display:flex;align-items:center;gap:17rpx}.ai-orb{width:58rpx;height:58rpx;border-radius:20rpx;background:#d8ff84;color:#173e33;display:flex;align-items:center;justify-content:center;font-size:28rpx}.ai-kicker{font-size:16rpx;letter-spacing:2rpx;color:#cce8d9}.context-title{font-size:31rpx;font-weight:780;margin-top:3rpx}.settings{font-size:20rpx;color:#d8ff84}.context-desc{font-size:21rpx;line-height:1.6;color:rgba(255,255,255,.68);margin-top:18rpx}.chips{margin-top:19rpx}.chips text{display:inline-block;background:rgba(255,255,255,.1);border:1rpx solid rgba(255,255,255,.1);border-radius:999rpx;padding:11rpx 16rpx;margin:0 8rpx 8rpx 0;font-size:20rpx;color:#eaf5f0}.msg{display:flex;align-items:flex-end;gap:11rpx;margin:22rpx 0}.msg.user{justify-content:flex-end}.avatar-mini{width:48rpx;height:48rpx;border-radius:17rpx;background:#173f34;color:#d8ff84;display:flex;align-items:center;justify-content:center;font-size:21rpx;flex-shrink:0}.bubble{max-width:78%;padding:21rpx 24rpx;border-radius:25rpx;line-height:1.72;font-size:25rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(27,64,51,.045)}.user .bubble{background:#1b5041;color:#fff;border-bottom-right-radius:8rpx}.assistant .bubble{border-bottom-left-radius:8rpx}.cursor{color:#4b8b74;animation:blink 1s infinite}@keyframes blink{50%{opacity:.15}}.bottom-space{height:18rpx}.composer{background:rgba(255,255,255,.96);padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-end;gap:14rpx;border-top:1rpx solid #e9efec}.composer textarea{flex:1;background:#eff4f1;border-radius:25rpx;min-height:48rpx;max-height:180rpx;padding:18rpx 20rpx;font-size:24rpx}.composer button{width:116rpx;height:84rpx;background:#183f34;color:#fff;border-radius:25rpx;font-size:24rpx;margin:0;display:flex;align-items:center;justify-content:center}.composer button::after{border:none}
.agent-plan{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #e6ece9}.agent-plan-kicker{font-size:16rpx;letter-spacing:2rpx;color:#4e7f6d;font-weight:800}.agent-plan-title{font-size:25rpx;font-weight:820;margin:8rpx 0 13rpx}.agent-item{display:flex;gap:12rpx;padding:10rpx 0}.dot{width:34rpx;height:34rpx;border-radius:12rpx;background:#e9f3ee;color:#235e4c;display:flex;align-items:center;justify-content:center;font-size:17rpx;font-weight:800;flex-shrink:0}.ap-title{font-size:21rpx;font-weight:750}.ap-desc{font-size:18rpx;line-height:1.5;color:#74817c;margin-top:3rpx}.agent-plan button{margin-top:14rpx;background:#173f34;color:#fff;border-radius:20rpx;font-size:21rpx;font-weight:800}.agent-plan button::after{border:none}.applied{margin-top:14rpx;background:#edf6f1;color:#28634f;border-radius:18rpx;padding:14rpx;text-align:center;font-size:20rpx;font-weight:750}

.action-flow{display:flex;align-items:center;gap:8rpx;margin:13rpx 0 8rpx}.action-flow text{font-size:16rpx;color:#96a19c;background:#f0f3f2;border-radius:999rpx;padding:7rpx 10rpx}.action-flow text.active{color:#7b5b1e;background:#fff2cf}.action-flow text.done{color:#245f4d;background:#e6f3ed}.action-flow .action-line{display:block;width:18rpx;height:2rpx;background:#d6dfdb;flex:none}.safety-note{margin-top:15rpx;border-radius:16rpx;background:#fff0ed;color:#8d433c;padding:12rpx 14rpx;font-size:18rpx;line-height:1.5}
.resource-list{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #e6ece9}.resource-card{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#f1f6f3}.resource-platform{font-size:17rpx;color:#4f806e}.resource-title{font-size:22rpx;font-weight:800;margin-top:6rpx}.resource-summary{font-size:18rpx;color:#74817c;line-height:1.5;margin-top:5rpx}.resource-meta{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx;color:#6b7b74;font-size:17rpx}.resource-meta button{margin:0;background:#183f34;color:#fff;border-radius:999rpx;font-size:17rpx;line-height:2}.resource-meta button::after{border:none}
.knowledge-list{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #e6ece9}.knowledge-card{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#eef3f8;border-left:5rpx solid #52728d}.knowledge-label{font-size:17rpx;color:#52728d;font-weight:750}
.adjustment-card{margin-top:17rpx;padding:16rpx;border-radius:19rpx;background:#fff7df;border:1rpx solid #f0ddb0}.adjustment-summary{font-size:21rpx;font-weight:760;color:#6c5422;margin-top:7rpx}.adjustment-reason{margin-top:11rpx;font-size:18rpx;line-height:1.5;color:#726649}.adjustment-reason text{font-weight:800;color:#59451c}.adjustment-applied{margin-top:12rpx;padding-top:10rpx;border-top:1rpx solid #ead9ae;font-size:17rpx;color:#7b622b}
.exercise-recommendations{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #e6ece9}.exercise-rec{margin-top:12rpx;padding:16rpx;border-radius:19rpx;background:#edf6f1}.exercise-rec .row{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.rec-score{width:66rpx;height:66rpx;border-radius:20rpx;background:#d8ff84;color:#173f34;display:flex;align-items:center;justify-content:center;font-size:23rpx;font-weight:850;flex:none}.rec-support{font-size:16rpx;color:#517467;margin-top:9rpx}
.trace-card { margin-top: 22rpx; padding: 20rpx; border: 1rpx solid #dce7e1; border-radius: 18rpx; background: #f1f6f3; }
.trace-head { display: flex; align-items: center; gap: 14rpx; }
.trace-icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; flex: none; border-radius: 50%; color: #fff; background: #346b5b; font-size: 20rpx; }
.trace-kicker { color: #315c50; font-size: 21rpx; font-weight: 680; }
.trace-owner { margin-top: 3rpx; color: #7a8a83; font-size: 18rpx; }
.trace-reasons { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.trace-reasons text { padding: 7rpx 12rpx; border-radius: 999rpx; color: #4e685f; background: #fff; font-size: 18rpx; }
.trace-default { margin-top: 14rpx; color: #62746c; font-size: 19rpx; line-height: 1.6; }
