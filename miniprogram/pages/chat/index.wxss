.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f7f2;
}

.agent-bar {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: rgba(247,247,242,.96);
  border-bottom: 1rpx solid #eeeee6;
}

.agent-identity,.agent-state,.assistant-meta,.trace-head,.plan-head {
  display: flex;
  align-items: center;
}

.agent-identity {gap: 16rpx;}
.agent-mark {width: 64rpx;height: 64rpx;flex: none;}
.agent-mark image,.welcome-mark image,.assistant-mark image,.suggestion-icon image,.icon-action image,.plan-icon image,.trace-icon image,.safety-note image,.icon-copy image,.composer-action image {width: 100%;height: 100%;display: block;}
.agent-name {font-size: 28rpx;font-weight: 720;line-height: 1.2;}
.agent-state {gap: 8rpx;margin-top: 4rpx;color: #5f665f;font-size: 20rpx;line-height: 1.2;}
.state-dot {width: 10rpx;height: 10rpx;border-radius: 50%;background: #506336;}
.state-dot.busy {animation: statusPulse 1.2s ease-in-out infinite;}

.icon-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  min-height: 60rpx;
  max-height: 60rpx;
  box-sizing: border-box;
  flex: 0 0 60rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(17,22,19,.035);
}
.icon-action::after {border: 0;}
.icon-action image {width: 34rpx;height: 34rpx;}

.messages {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.welcome {padding-top: 48rpx;animation: welcomeIn .38s cubic-bezier(.2,.8,.2,1);}
.welcome-mark {width: 80rpx;height: 80rpx;margin-bottom: 24rpx;}
.welcome-kicker {color: #506336;font-size: 22rpx;font-weight: 680;}
.welcome-title {margin-top: 8rpx;font-size: 46rpx;font-weight: 760;letter-spacing: -1rpx;line-height: 1.25;}

.suggestion-list {
  overflow: hidden;
  margin-top: 40rpx;
  border: 1rpx solid #eeeee6;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(17,22,19,.035);
}
.suggestion {display: flex;align-items: center;min-height: 106rpx;padding: 24rpx;border-bottom: 1rpx solid #eeeee6;box-sizing: border-box;}
.suggestion:last-child {border-bottom: 0;}
.suggestion-icon {width: 56rpx;height: 56rpx;flex: none;margin-right: 16rpx;}
.suggestion-copy {flex: 1;min-width: 0;}
.suggestion-title {font-size: 27rpx;font-weight: 680;line-height: 1.3;}
.chevron {width: 32rpx;height: 32rpx;margin-left: 12rpx;opacity: .48;}

.message-row {display: flex;margin: 32rpx 0;animation: messageIn .32s cubic-bezier(.2,.8,.2,1);}
.user-bubble {
  max-width: 82%;
  margin-left: auto;
  padding: 20rpx 24rpx;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  color: #111613;
  background: #c4e267;
  font-size: 27rpx;
  line-height: 1.65;
  box-shadow: 0 8rpx 26rpx rgba(17,22,19,.035);
}

.assistant-message {width: 100%;min-width: 0;}
.assistant-meta {gap: 12rpx;margin-bottom: 12rpx;color: #506336;font-size: 21rpx;font-weight: 680;}
.assistant-mark {width: 36rpx;height: 36rpx;flex: none;}
.safety-pill {margin-left: 4rpx;padding: 4rpx 12rpx;border-radius: 999rpx;color: #9b5b00;background: #fff7df;font-size: 17rpx;}
.response-text {padding-left: 48rpx;color: #111613;font-size: 29rpx;line-height: 1.82;white-space: pre-wrap;}
.cursor {display: inline-block;width: 4rpx;height: 30rpx;margin-left: 8rpx;border-radius: 999rpx;background: #506336;vertical-align: -4rpx;animation: cursorPulse .8s ease-in-out infinite;}

.thinking-state {display: flex;align-items: center;gap: 16rpx;padding: 12rpx 0 12rpx 48rpx;color: #5f665f;font-size: 22rpx;}
.thinking-dots {display: flex;align-items: center;gap: 8rpx;height: 24rpx;}
.thinking-dots view {width: 8rpx;height: 8rpx;border-radius: 50%;background: #506336;animation: thinkingDot 1s ease-in-out infinite;}
.thinking-dots view:nth-child(2) {animation-delay: .14s;}
.thinking-dots view:nth-child(3) {animation-delay: .28s;}

.content-reveal {animation: contentRise .34s cubic-bezier(.2,.8,.2,1);}
.section-label {color: #506336;font-size: 18rpx;font-weight: 760;letter-spacing: 1rpx;}

.safety-note {display: flex;align-items: flex-start;gap: 12rpx;margin: 20rpx 0 0 48rpx;padding: 16rpx;border-radius: 18rpx;color: #9b5b00;background: #fff7df;font-size: 20rpx;line-height: 1.5;}
.safety-note image {width: 36rpx;height: 36rpx;flex: none;}

.trace-card,.adjustment-card,.agent-plan,.resource-list,.knowledge-list,.exercise-recommendations {
  margin: 24rpx 0 0 48rpx;
  padding: 24rpx;
  border: 1rpx solid #eeeee6;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(17,22,19,.035);
}
.trace-head,.plan-head {gap: 16rpx;}
.trace-icon,.plan-icon {width: 48rpx;height: 48rpx;flex: none;}
.trace-kicker {color: #111613;font-size: 24rpx;font-weight: 700;}
.trace-owner {margin-top: 4rpx;color: #5f665f;font-size: 18rpx;}
.trace-reasons {display: flex;flex-wrap: wrap;gap: 12rpx;margin-top: 16rpx;}
.trace-reasons text {padding: 8rpx 12rpx;border-radius: 999rpx;color: #506336;background: #f7f7f2;font-size: 18rpx;}
.trace-default {margin-top: 16rpx;color: #5f665f;font-size: 20rpx;line-height: 1.6;}
.trace-detail,.trace-limitations,.trace-alternatives,.trace-load {margin-top:16rpx;color:#5f665f;font-size:19rpx;line-height:1.55;}
.trace-detail-label {color:#8e9389;font-size:16rpx;font-weight:650;}
.trace-limitations {padding:16rpx;border-radius:14rpx;background:#fff8e8;color:#755f35;}
.trace-limitations view+view,.trace-alternatives view+view {margin-top:8rpx;}
.trace-alternatives>view:not(.trace-detail-label) {margin-top:12rpx;padding-top:12rpx;border-top:1rpx solid #f0f0e9;}
.trace-alternatives text {color:#30372f;font-weight:650;}
.trace-alternatives>view>view {color:#7a8076;font-size:17rpx;}
.trace-load {color:#506336;font-weight:650;}

.adjustment-card {background: #fff7df;}
.adjustment-summary {margin-top: 8rpx;color: #6c5422;font-size: 22rpx;font-weight: 700;}
.adjustment-reason {margin-top: 12rpx;color: #726649;font-size: 19rpx;line-height: 1.55;}
.adjustment-reason text {color: #59451c;font-weight: 760;}
.adjustment-applied {margin-top: 12rpx;padding-top: 12rpx;border-top: 1rpx solid #ead9ae;color: #7b622b;font-size: 18rpx;}

.agent-plan-title {margin-top: 4rpx;font-size: 27rpx;font-weight: 760;}
.action-flow {display: flex;align-items: center;gap: 8rpx;margin: 20rpx 0 16rpx;}
.action-flow text {padding: 8rpx 12rpx;border-radius: 999rpx;color: #506336;background: #f7f7f2;font-size: 16rpx;transform: scale(.96);transition: background-color .32s ease-out,transform .32s cubic-bezier(.2,.8,.2,1),box-shadow .32s ease-out;}
.action-flow text.active {color: #9b5b00;background: #fff7df;transform: scale(1);box-shadow: 0 0 0 4rpx rgba(196,226,103,.24);}
.action-flow text.done {color: #111613;background: #e9efd9;transform: scale(1);}
.action-line {width: 16rpx;height: 2rpx;flex: none;background: #eeeee6;transition: background-color .32s ease-out;}
.action-line.on {background: #c4e267;}
.agent-item {display: flex;gap: 12rpx;padding: 12rpx 0;}
.dot {display: flex;align-items: center;justify-content: center;width: 36rpx;height: 36rpx;flex: none;border-radius: 12rpx;color: #111613;background: #e9efd9;font-size: 17rpx;font-weight: 760;}
.ap-title {font-size: 22rpx;font-weight: 700;}
.ap-desc {margin-top: 4rpx;color: #5f665f;font-size: 19rpx;line-height: 1.55;}
.plan-confirm {margin: 20rpx 0 0;padding: 0 24rpx;border-radius: 18rpx;color: #111613;background: #c4e267;font-size: 22rpx;font-weight: 720;}
.plan-confirm::after {border: 0;}
.applied {margin-top: 20rpx;padding: 16rpx;border-radius: 18rpx;color: #506336;background: #e9efd9;text-align: center;font-size: 20rpx;font-weight: 680;}

.resource-card,.exercise-rec,.knowledge-card {margin-top: 16rpx;padding: 20rpx;border-radius: 18rpx;background: #f7f7f2;}
.knowledge-card {border-left: 4rpx solid #506336;}
.resource-platform,.knowledge-label {color: #506336;font-size: 18rpx;}
.resource-title {margin-top: 8rpx;font-size: 23rpx;font-weight: 720;}
.resource-summary {margin-top: 4rpx;color: #5f665f;font-size: 19rpx;line-height: 1.55;}
.resource-meta {display: flex;align-items: center;justify-content: space-between;margin-top: 12rpx;color: #5f665f;font-size: 18rpx;}
.resource-meta > text {flex:1;min-width:0;}
.icon-copy {display:flex;align-items:center;justify-content:center;width:52rpx;min-width:52rpx;max-width:52rpx;height:52rpx;min-height:52rpx;max-height:52rpx;box-sizing:border-box;flex:0 0 52rpx;margin:0 0 0 16rpx;padding:0;overflow:hidden;border-radius:999rpx;background:#e9efd9;line-height:1;}
.icon-copy::after {border: 0;}
.icon-copy image {width: 28rpx;height: 28rpx;}
.exercise-rec .row {display: flex;align-items: center;justify-content: space-between;gap: 12rpx;}
.rec-score {display: flex;align-items: center;justify-content: center;width: 64rpx;height: 64rpx;flex: none;border-radius: 20rpx;color: #111613;background: #c4e267;font-size: 22rpx;font-weight: 760;}
.rec-support {margin-top: 8rpx;color: #506336;font-size: 17rpx;}

.bottom-space {height: 24rpx;}
.composer-wrap {padding:12rpx 32rpx calc(136rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:1rpx solid #eeeee6;}
.composer {display:flex;align-items:center;gap:8rpx;width:100%;box-sizing:border-box;padding:8rpx 8rpx 8rpx 24rpx;border:1rpx solid #eeeee6;border-radius:999rpx;background:#f7f7f2;}
.composer.focused {border-color: #c4e267;background: #fff;box-shadow: 0 0 0 8rpx rgba(196,226,103,.16);}
.composer-input {flex:9;min-width:0;min-height:64rpx;max-height:180rpx;box-sizing:border-box;padding:12rpx 0;font-size:25rpx;line-height:1.5;}
.composer-action {display:flex;align-items:center;justify-content:center;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;max-height:64rpx;box-sizing:border-box;flex:0 0 64rpx;margin:0;padding:0;border:0;border-radius:999rpx;background:#e9efd9;overflow:hidden;transform:scale(.94);transition:opacity .16s ease-out,transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease-out;}
.composer-action::after {border: 0;}
.composer-action image {width:64rpx;height:64rpx;}
.composer-action.ready {background: #c4e267;transform: scale(1);box-shadow: 0 8rpx 20rpx rgba(80,99,54,.14);}
.composer-action.stop {background: #111613;transform: scale(1);}
.stop-mark {width: 20rpx;height: 20rpx;border-radius: 5rpx;background: #fff;}

@keyframes welcomeIn {from {opacity: 0;transform: translateY(20rpx);}to {opacity: 1;transform: translateY(0);}}
@keyframes messageIn {from {opacity: 0;transform: translateY(16rpx);}to {opacity: 1;transform: translateY(0);}}
@keyframes contentRise {from {opacity: 0;transform: translateY(12rpx);}to {opacity: 1;transform: translateY(0);}}
@keyframes thinkingDot {0%,60%,100% {opacity: .28;transform: translateY(0);}30% {opacity: 1;transform: translateY(-8rpx);}}
@keyframes cursorPulse {0%,100% {opacity: .22;}50% {opacity: 1;}}
@keyframes statusPulse {0%,100% {opacity: .35;transform: scale(.8);}50% {opacity: 1;transform: scale(1.15);}}

/* Real pipeline stage chips (spec 8.7). Labelled as progress, not live model output. */
.stage-strip{display:flex;flex-wrap:wrap;gap:8rpx;margin:12rpx 0}
.stage-chip{padding:8rpx 16rpx;border-radius:999rpx;background:#f7f7f2;color:#5f665f;font-size:18rpx}
.stage-chip.running{background:#e9efd9;color:#506336}
.stage-chip.failed{background:rgba(192,57,43,.1);color:#c0392b}

/* Action proposal confirm cards (spec 8.5). Rendered from actions[] only. */
.action-cards{margin:16rpx 0}
.action-card{margin-bottom:24rpx;padding:24rpx;border:1rpx solid #eeeee6;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(17,22,19,.035)}
.action-head{display:flex;align-items:flex-start;gap:16rpx}
.action-head .grow{min-width:0;flex:1}
.action-title{color:#111613;font-size:26rpx;font-weight:760;margin-top:4rpx}
.action-state{flex:none;padding:8rpx 16rpx;border-radius:999rpx;background:#f7f7f2;color:#5f665f;font-size:18rpx}
.action-state.done{background:#e9efd9;color:#506336}
.action-summary{margin-top:12rpx;color:#5f665f;font-size:21rpx;line-height:1.6}
.action-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:20rpx}
.action-btn{padding:16rpx 24rpx;border-radius:999rpx;font-size:22rpx}
.action-btn.soft{background:#f7f7f2;color:#111613}
.action-btn.primary{background:#c4e267;color:#111613;font-weight:720}
.action-note{margin-top:12rpx;color:#9b5b00;font-size:20rpx;line-height:1.55}
