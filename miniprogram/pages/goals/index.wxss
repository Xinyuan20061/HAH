.goals-page{background:linear-gradient(180deg,#edf5f1 0,#f7f9f8 360rpx)}.hero{padding:12rpx 6rpx 28rpx}.kicker{font-size:18rpx;letter-spacing:3rpx;color:#2e745f;font-weight:800}.title{font-size:43rpx;line-height:1.28;font-weight:820;margin:14rpx 0 9rpx}.goal-card{padding:26rpx}.goal-name{display:flex;align-items:center;gap:16rpx}.gicon{width:58rpx;height:58rpx;border-radius:19rpx;background:#edf5f1;color:#235c4b;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:850}.goal-name .b{font-size:26rpx;font-weight:800}.goal-name .muted{font-size:19rpx;margin-top:3rpx}.target text:first-child{font-size:34rpx;font-weight:850}.target text:last-child{font-size:18rpx;color:#87938e;margin-left:4rpx}.progress{height:8rpx;background:#edf1ef;border-radius:999rpx;overflow:hidden;margin:22rpx 0 4rpx}.progress view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#255f4e,#b7e960);transition:width .35s}.weekly .b{font-size:26rpx;font-weight:800}.weekly .muted{font-size:20rpx;margin-top:5rpx}.week-v{font-size:28rpx;font-weight:800;color:#2a6b58}.save{height:94rpx;border-radius:30rpx;background:#173f34;color:#fff;font-size:27rpx;font-weight:800}.save::after{border:none}.note{font-size:19rpx;color:#929c97;line-height:1.6;padding:20rpx 8rpx}.skeleton-grid{display:grid;grid-template-columns:1fr;gap:18rpx}.sk-card{height:240rpx;border-radius:30rpx;background:#e8eeeb}.shimmer{background:linear-gradient(100deg,#e8eeeb 20%,#f5f8f6 40%,#e8eeeb 60%);background-size:220% 100%;animation:shimmer 1.35s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
.adaptive{padding:28rpx;background:linear-gradient(145deg,#173f34,#285f50);color:#fff}.adaptive .kicker{color:#bfe8d7}.adaptive-title{font-size:30rpx;font-weight:820;margin-top:8rpx}.adaptive-desc{color:rgba(255,255,255,.65);font-size:20rpx;line-height:1.6;margin-top:18rpx}.mini-btn{margin:0;background:#d8ff84;color:#183f34;border-radius:999rpx;font-size:20rpx;font-weight:800;line-height:58rpx;height:58rpx;padding:0 24rpx}.mini-btn::after{border:none}.rule-policy{font-size:18rpx;line-height:1.55;background:rgba(255,255,255,.07);padding:16rpx;border-radius:18rpx;margin-top:20rpx;color:#dbe9e3}.suggestion{border-top:1rpx solid rgba(255,255,255,.1);padding:20rpx 0}.suggestion .b{font-size:24rpx}.suggestion .muted{color:rgba(255,255,255,.55);font-size:18rpx;margin-top:4rpx}.decision{font-size:18rpx;border-radius:999rpx;padding:8rpx 13rpx;background:rgba(255,255,255,.08)}.decision.increase,.decision.reduce{background:#d8ff84;color:#183f34}.target-change{display:flex;align-items:center;gap:12rpx;font-size:30rpx;font-weight:800;margin-top:15rpx}.target-change button{margin:0 0 0 auto;height:54rpx;line-height:54rpx;padding:0 18rpx;border-radius:16rpx;background:#fff;color:#1d5948;font-size:19rpx}.target-change button::after{border:none}.reason{font-size:19rpx;line-height:1.55;color:#d7e7e0;margin-top:10rpx}.ai-explain{display:flex;justify-content:space-between;align-items:center;margin-top:10rpx;padding:18rpx;border-radius:20rpx;background:rgba(216,255,132,.11);color:#d8ff84;font-size:20rpx;line-height:1.5}
