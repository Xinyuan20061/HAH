.goals-page{background:linear-gradient(180deg,#f7f7f2 0,#f7f7f2 360rpx)}.hero{padding:12rpx 8rpx 32rpx}.kicker{font-size:18rpx;letter-spacing:3rpx;color:#506336;font-weight:800}.title{font-size:43rpx;line-height:1.28;font-weight:820;margin:16rpx 0 8rpx}.goal-card{padding:24rpx}.goal-name{display:flex;align-items:center;gap:16rpx}.gicon{width:58rpx;height:58rpx;border-radius:50%;background:#f7f7f2;display:flex;align-items:center;justify-content:center}.gicon image{width:32rpx;height:32rpx}.goal-name .b{font-size:26rpx;font-weight:800}.goal-name .muted{font-size:19rpx;margin-top:4rpx}.target text:first-child{font-size:34rpx;font-weight:850}.target text:last-child{font-size:18rpx;color:#5f665f;margin-left:4rpx}.progress{height:8rpx;background:#f7f7f2;border-radius:999rpx;overflow:hidden;margin:24rpx 0 4rpx}.progress view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#c4e267,#c4e267);transition:width .35s}.weekly .b{font-size:26rpx;font-weight:800}.weekly .muted{font-size:20rpx;margin-top:4rpx}.week-v{font-size:28rpx;font-weight:800;color:#506336}.save{height:94rpx;border-radius:30rpx;background:#c4e267;color:#111613;font-size:27rpx;font-weight:800}.save::after{border:none}.note{font-size:19rpx;color:#506336;line-height:1.6;padding:20rpx 8rpx}.skeleton-grid{display:grid;grid-template-columns:1fr;gap:20rpx}.sk-card{height:240rpx;border-radius:30rpx;background:#e9efd9}.shimmer{background:linear-gradient(100deg,#e9efd9 20%,#f7f7f2 40%,#e9efd9 60%);background-size:220% 100%;animation:shimmer 1.35s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:-100% 0}}
.adaptive{padding:32rpx;background:linear-gradient(145deg,#111613,#111613);color:#fff}.adaptive .kicker{color:#f7f7f2}.adaptive-title{font-size:30rpx;font-weight:820;margin-top:8rpx}.adaptive-desc{color:rgba(255,255,255,.65);font-size:20rpx;line-height:1.6;margin-top:20rpx}.mini-btn{margin:0;background:#c4e267;color:#111613;border-radius:999rpx;font-size:20rpx;font-weight:800;line-height:58rpx;height:58rpx;padding:0 24rpx}.mini-btn::after{border:none}.rule-policy{font-size:18rpx;line-height:1.55;background:rgba(255,255,255,.07);padding:16rpx;border-radius:18rpx;margin-top:20rpx;color:#f7f7f2}.suggestion{border-top:1rpx solid rgba(255,255,255,.1);padding:20rpx 0}.suggestion .b{font-size:24rpx}.suggestion .muted{color:rgba(255,255,255,.55);font-size:18rpx;margin-top:4rpx}.decision{font-size:18rpx;border-radius:999rpx;padding:8rpx 12rpx;background:rgba(255,255,255,.08)}.decision.increase,.decision.reduce{background:#c4e267;color:#111613}.target-change{display:flex;align-items:center;gap:12rpx;font-size:30rpx;font-weight:800;margin-top:16rpx}.target-change button{margin:0 0 0 auto;height:54rpx;line-height:54rpx;padding:0 20rpx;border-radius:16rpx;background:#fff;color:#111613;font-size:19rpx}.target-change button::after{border:none}.reason{font-size:19rpx;line-height:1.55;color:#f7f7f2;margin-top:12rpx}.ai-explain{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx;padding:20rpx;border-radius:20rpx;background:rgba(196,226,103,.11);color:#c4e267;font-size:20rpx;line-height:1.5}.ai-explain image{width:42rpx;height:42rpx;flex:none}

/* ── Velocity-Based Slider Snap ────────────────────────────────────────────
   松手时若还在快速滑动，JS 会按惯性多补一格；这里的回弹缩放把这个补格
   结果显式反馈出来，让用户看到「多走了一步」而不是数值静默变化。
   过渡必须写在基础类上（.target / .week-v），只写在 .snap 里会导致
   「放大有动画、回落瞬跳」。 */
.target, .week-v {transition: transform .26s cubic-bezier(.34,1.56,.64,1); }
.snap {transform: scale(1.12); }
