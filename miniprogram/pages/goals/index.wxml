<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="page goals-page ui-page-content">
  <view class="hero"><view class="kicker">目标体系</view><view class="title">把目标变成每天的一小步</view></view>
  <view wx:if="{{loading}}" class="skeleton-grid"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="sk-card shimmer"></view></view>
  <view wx:elif="{{error}}" class="state-card state-card-error"><view><view class="state-title">目标暂时加载失败</view><view class="state-desc">{{error}}</view></view><button class="btn-soft compact tappable" bindtap="retry" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">重试</button></view>
  <block wx:else>
    <view class="adaptive card">
      <view class="row space"><view><view class="kicker">近 14 天</view><view class="adaptive-title">动态调整目标</view></view><button class="mini-btn tappable" loading="{{dynamicLoading}}" bindtap="evaluateDynamic" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">评估</button></view>
      <block wx:if="{{dynamic}}">
        <view class="suggestion" wx:for="{{dynamic.items}}" wx:key="target_key">
          <view class="row space"><view><view class="b">{{item.label}}</view><view class="muted" wx:if="{{item.has_rate}}">有效记录 {{item.observed_days}} 天 · 达标率 {{item.completion_pct}}%</view><view class="muted" wx:else>有效记录 {{item.observed_days}} 天 · 数据不足</view></view><view class="decision {{item.decision}}">{{item.decision_label}}</view></view>
          <view class="target-change" wx:if="{{item.decision==='increase'||item.decision==='reduce'}}"><text>{{item.previous_target}}</text><text>→</text><text>{{item.recommended_target}}</text><button class="tappable" data-id="{{item.adjustment_id}}" bindtap="applyDynamic" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">应用</button></view>
        </view>
        <view class="ai-explain tappable" bindtap="explainDynamic" hover-class="tap" hover-start-time="0" hover-stay-time="80"><text>{{explainLoading?'正在整理…':dynamicExplain||'查看调整原因'}}</text><image src="/assets/icons/spark.png" mode="aspectFit"/></view>
      </block>
    </view>
    <view class="goal-card card" wx:for="{{cards}}" wx:key="k">
      <view class="row space"><view class="goal-name"><view class="gicon ui-fixed-circle"><image src="{{item.icon}}" mode="aspectFit"/></view><view><view class="b">{{item.name}}</view><view class="muted">今天 {{item.current}} {{item.unit}}</view></view></view><view class="target {{snapKey===item.k?'snap':''}}"><text>{{item.value}}</text><text>{{item.unit}}</text></view></view>
      <view class="progress"><view style="width:{{item.pct}}%"></view></view>
      <slider data-i="{{index}}" min="{{item.min}}" max="{{item.max}}" step="{{item.step}}" value="{{item.value}}" bindchanging="slideLive" bindchange="slide" activeColor="#506336" backgroundColor="#e9efd9" block-color="#506336" block-size="18"/>
    </view>
    <view class="card weekly"><view class="row space"><view><view class="b">每周打卡目标</view></view><view class="week-v {{checkinSnap?'snap':''}}">{{goals.weekly_checkin_target}} / 7</view></view><slider min="1" max="7" step="1" value="{{goals.weekly_checkin_target}}" bindchanging="checkinLive" bindchange="checkinTarget" activeColor="#506336" block-color="#506336" block-size="18"/></view>
    <button class="save tappable" loading="{{saving}}" bindtap="save" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">保存目标体系</button>
    <view class="note">特殊健康状况请咨询专业人员。</view>
  </block>
</view>
