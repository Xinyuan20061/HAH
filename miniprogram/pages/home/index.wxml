<include src="/components/page-transition/first-paint.wxml"/>
<page-transition/>
<view class="gym-page ui-page-content">
  <scroll-view scroll-y class="gym-scroll">
    <view class="gym-content">
      <block wx:if="{{loading}}">
        <view class="skeleton skeleton-head"></view><view class="skeleton skeleton-stage"></view><view class="skeleton skeleton-voice"></view>
      </block>
      <view wx:elif="{{error}}" class="load-error">
        <view class="error-title">暂时没有加载出来</view><view class="error-copy">{{error}}</view><button class="tappable" bindtap="retry" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">重新连接</button>
      </view>
      <block wx:else>
        <view class="gym-head">
          <view><view class="date-label">{{dateLabel}}</view><view class="gym-title space-title space-{{activeCompanion.id}}">{{activeCompanion.space}}</view></view>
          <view class="streak-mark"><text class="streak-number">{{streak.current||0}}</text><text>天</text></view>
        </view>
        <view class="week-strip">
          <view class="week-day {{item.done?'done':''}}" wx:for="{{streak.last7}}" wx:key="date"><view class="week-core"></view><text>{{item.label}}</text></view>
        </view>
        <view class="companion-switch">
          <view class="companion-choice tappable {{item.id===activeCompanion.id?'selected':''}}" wx:for="{{companions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCompanion" hover-class="tap" hover-start-time="0" hover-stay-time="80">
            <view class="choice-portrait"><image src="{{item.icon}}" mode="aspectFit" fade-in="{{false}}"/></view><view class="choice-name">{{item.name}}</view>
          </view>
        </view>
        <view class="companion-stage">
          <view class="stage-head">
            <view class="companion-name">{{activeCompanion.name}}</view>
            <view class="activity-pill"><view class="activity-dot"></view><text>{{characterStatus}}</text></view>
          </view>
          <agent-character class="stage-character" agent-id="{{activeCompanion.id}}" activity="{{characterActivity}}" bindclipcomplete="onCharacterClipComplete"/>
        </view>
        <view class="voice-zone">
          <view class="voice-ring {{recording?'recording':''}}"></view>
          <view class="voice-button ui-fixed-circle tappable {{recording?'recording':''}} {{voiceWorking?'working':''}}" bindtouchstart="startVoice" bindtouchend="stopVoice" bindtouchcancel="cancelVoice" hover-class="voice-button-press" hover-start-time="0" hover-stay-time="80" aria-label="按住与健康伙伴说话"><image src="/assets/icons/mic.png" mode="aspectFit"/></view>
          <view class="voice-status">{{voiceStatus}}</view>
          <view class="route-test-button tappable {{recording||voiceWorking?'disabled':''}}" bindtap="testPlanRouting" hover-class="tap" hover-start-time="0" hover-stay-time="80" aria-label="检查制定计划是否能进入计划草案">测试计划路由</view>
        </view>
        <view wx:if="{{response}}" class="voice-response">
          <view class="heard-text">“{{response.heard}}”</view>
          <view class="reply-row"><view class="reply-text">{{response.reply}}</view><view class="replay-button ui-fixed-circle tappable" bindtap="replay" hover-class="tap" hover-start-time="0" hover-stay-time="80" aria-label="重新播放"><image src="/assets/icons/speaker.png" mode="aspectFit"/></view></view>
          <view wx:if="{{response.action}}" class="response-action tappable" bindtap="runResponseAction" hover-class="tap-btn" hover-start-time="0" hover-stay-time="80">{{response.action.label}}</view>
          <view wx:if="{{response.action.target==='plan_preview'}}" class="draft-boundary">草案确认后才会加入计划</view>
        </view>
        <!-- 方案 §14 第 7 条「跨模态闭环」的入口：建议 → 状态 → 做过之后的变化 -->
        <view class="state-entry tappable" bindtap="goState" hover-class="tap-card" hover-start-time="0" hover-stay-time="80">
          <view class="state-entry-text"><view class="state-entry-title">状态与下一步</view><view class="state-entry-sub">建议、依据、上次做完的变化</view></view>
          <view class="state-entry-arrow">→</view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
