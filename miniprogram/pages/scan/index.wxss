.item-evidence{margin:24rpx 0}.food-item{padding:20rpx 0;border-bottom:1rpx solid #e9efd9}.food-item:last-child{border-bottom:0}.item-index{font-family:Georgia,serif;color:#506336;font-size:20rpx;margin-right:16rpx}.item-name{font-size:25rpx;font-weight:700}.item-kcal{font-size:23rpx;font-weight:700;color:#111613}.item-meta{margin:12rpx 0 8rpx;color:#5f665f;font-size:19rpx}.item-evidence-text{font-size:21rpx;line-height:1.6;color:#5f665f}.derived-total{padding:16rpx 20rpx;border-radius:15rpx;background:#f7f7f2;color:#506336;font-size:20rpx;line-height:1.5}.item-editor{padding:20rpx;border:1rpx solid #e9efd9;border-radius:20rpx}.item-editor-title{font-size:21rpx;font-weight:720;color:#506336;margin-bottom:12rpx}.item-editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.item-editor-grid .field{background:#f7f7f2}
.scan-page{background:#f7f7f2}.scan-hero{padding:12rpx 8rpx 24rpx}.kicker{font-size:20rpx;color:#506336;font-weight:700;letter-spacing:3rpx}.title{font-size:44rpx;line-height:1.3;font-weight:720;margin:16rpx 0}.camera{height:590rpx;border-radius:26rpx;overflow:hidden;background:#111613;position:relative;box-shadow:0 16rpx 44rpx rgba(17,22,19,.12)}.camera>image{width:100%;height:100%}.empty-camera{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:white}.lens{display:flex;align-items:center;justify-content:center;width:116rpx;height:116rpx;border:1rpx solid rgba(255,255,255,.46);border-radius:50%;background:rgba(255,255,255,.08)}.lens image{width:54rpx;height:54rpx}.empty-camera .b{font-size:30rpx;margin-top:32rpx}.empty-camera .small{font-size:22rpx;opacity:.65;margin-top:12rpx}.scan-corners view{position:absolute;width:68rpx;height:68rpx;border-color:white}.scan-corners view:nth-child(1){left:28rpx;top:28rpx;border-left:3rpx solid;border-top:3rpx solid;border-radius:12rpx 0 0 0}.scan-corners view:nth-child(2){right:28rpx;top:28rpx;border-right:3rpx solid;border-top:3rpx solid;border-radius:0 12rpx 0 0}.scan-corners view:nth-child(3){left:28rpx;bottom:28rpx;border-left:3rpx solid;border-bottom:3rpx solid;border-radius:0 0 0 12rpx}.scan-corners view:nth-child(4){right:28rpx;bottom:28rpx;border-right:3rpx solid;border-bottom:3rpx solid;border-radius:0 0 12rpx 0}.analyze{margin:24rpx 0 32rpx;height:94rpx;border-radius:18rpx;background:#c4e267;color:#111613;font-size:28rpx;font-weight:650}.analyze::after,.save::after{border:none}.dish{font-size:35rpx;font-weight:720;margin:16rpx 0 8rpx}.kcal{text-align:right}.kcal .b{display:block;font-family:Georgia,serif;font-size:52rpx}.kcal .small{font-size:20rpx;color:#5f665f}.macro{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:32rpx 0}.macro view{background:#f7f7f2;border-radius:16rpx;padding:20rpx 8rpx;text-align:center}.macro .b,.macro .small{display:block}.macro .b{font-size:28rpx}.macro .small{font-size:18rpx;color:#5f665f;margin-top:4rpx}.ingredients{display:flex;flex-wrap:wrap;gap:12rpx}.ingredients text{font-size:21rpx;background:#f7f7f2;padding:8rpx 16rpx;border-radius:999rpx}.tips{margin-top:24rpx;padding:24rpx;border-radius:18rpx;background:#e9efd9;color:#5d5238;line-height:1.7;font-size:23rpx}.tips-title{font-weight:700;margin-bottom:8rpx}.save{margin-top:24rpx;background:#c4e267;color:#111613;border-radius:18rpx;font-weight:650}.notice{font-size:20rpx;color:#5f665f;line-height:1.7;padding:0 8rpx}
.estimate-range{margin:24rpx 0;padding:24rpx;border:1rpx solid #eeeee6;border-radius:18rpx;background:#f7f7f2}.estimate-range>view:first-child{display:flex;justify-content:space-between;align-items:center}.estimate-range text{color:#5f665f;font-size:20rpx;line-height:1.55}.estimate-range b{font-size:24rpx}.range-line{position:relative;height:8rpx;margin:20rpx 0 8rpx;border-radius:99rpx;background:#e9efd9}
.range-line .range-fill{position:absolute;height:100%;border-radius:99rpx;background:#c4e267;transition:left .5s cubic-bezier(.2,.8,.2,1),width .5s cubic-bezier(.2,.8,.2,1)}
.range-line .range-dot{position:absolute;top:-7rpx;width:20rpx;height:20rpx;margin-left:-10rpx;border:4rpx solid #fff;border-radius:50%;background:#c4e267;box-shadow:0 1rpx 6rpx rgba(17,22,19,.2);transition:left .5s cubic-bezier(.2,.8,.2,1)}
.range-legend{display:flex;justify-content:space-between;color:#5f665f;font-size:19rpx}.evidence-block,.uncertainty{margin:20rpx 0;padding:24rpx;border-radius:18rpx;background:#f7f7f2}.uncertainty{background:#f7f7f2;color:#675b47;font-size:21rpx;line-height:1.7}.evidence-title{margin-bottom:12rpx;font-size:23rpx;font-weight:680}.evidence-tags{display:flex;flex-wrap:wrap;gap:12rpx}.evidence-tags text{padding:8rpx 12rpx;border:1rpx solid #e9efd9;border-radius:999rpx;background:#fff;font-size:20rpx}

.scan-beam{position:absolute;left:30rpx;right:30rpx;top:42rpx;height:4rpx;opacity:.4}.scan-beam.active{animation:scanMove 1.6s cubic-bezier(.45,.05,.55,.95) infinite;opacity:1}.beam-line{height:4rpx;border-radius:99rpx;background:linear-gradient(90deg,rgba(196,226,103,0),#c4e267 20%,#fff 50%,#c4e267 80%,rgba(196,226,103,0));box-shadow:0 0 24rpx rgba(216,255,132,.72)}.scan-status{position:absolute;left:50%;bottom:35rpx;transform:translateX(-50%);display:flex;align-items:center;gap:12rpx;background:rgba(17,22,19,.78);color:#fff;border-radius:999rpx;padding:12rpx 20rpx;font-size:19rpx;white-space:nowrap}.scan-dot{width:12rpx;height:12rpx;border-radius:50%;background:#c4e267;animation:scanPulse 1s infinite}@keyframes scanMove{0%{top:42rpx}50%{top:530rpx}100%{top:42rpx}}@keyframes scanPulse{0%,100%{opacity:.4;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}
.flow{display:flex;align-items:flex-start;margin:8rpx 4rpx 24rpx}
.flow-item{width:70rpx;text-align:center;color:#506336;font-size:19rpx}
.flow-item text{display:flex;margin:0 auto 8rpx;width:42rpx;height:42rpx;border-radius:50%;align-items:center;justify-content:center;background:#e9efd9;color:#5f665f;font-weight:700;transform:scale(.9);transition:background-color .3s ease-out,transform .34s cubic-bezier(.34,1.56,.64,1),box-shadow .3s ease-out}
.flow-item.on{color:#111613}
.flow-item.on text{background:#c4e267;color:#111613;transform:scale(1);box-shadow:0 0 0 6rpx rgba(17,22,19,.1)}
/* 完成的步骤：先过冲到 1.14 再回弹落位到 .94（弹簧感）；落点比"当前步"小，让当前步更突出 */
.flow-item.done text{background:#c4e267;transform:scale(.94);box-shadow:0 0 0 4rpx rgba(17,22,19,.1);animation:stepPop .44s cubic-bezier(.34,1.56,.64,1)}
@keyframes stepPop{0%{transform:scale(.8)}55%{transform:scale(1.14)}100%{transform:scale(.94)}}
/* 连接线用 scaleX 生长，而不是瞬间变色。数据状态 step 始终是唯一真相，动画只做视觉回应 */
.flow-line{position:relative;height:3rpx;flex:1;margin-top:20rpx;border-radius:999rpx;background:#e9efd9;overflow:hidden}
.flow-fill{position:absolute;left:0;top:0;right:0;bottom:0;border-radius:inherit;background:#c4e267;transform:scaleX(0);transform-origin:left center;transition:transform .46s cubic-bezier(.34,1.56,.64,1)}
.flow-fill.on{transform:scaleX(1)}.correction-head{border-top:1rpx solid #eeeee6;padding-top:24rpx;margin-top:8rpx}.info-title{font-size:27rpx;font-weight:750}.smalltxt{font-size:20rpx;margin-top:4rpx}.edit-btn{margin:0;padding:0 24rpx;height:58rpx;line-height:58rpx;border-radius:999rpx;background:#f7f7f2;color:#111613;font-size:22rpx}.edit-btn::after{border:none}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.field{background:#f7f7f2;border-radius:20rpx;padding:16rpx}.field text{font-size:19rpx;color:#5f665f}.field input{font-size:25rpx;margin-top:8rpx;min-height:44rpx}.field.wide,.edit-grid .wide{grid-column:1 / -1}.mini{margin-top:20rpx;font-size:22rpx}.state-panel{border-radius:24rpx;padding:24rpx 24rpx;margin:20rpx 0}.state-error{background:#f7f7f2;color:#823f39}.state-success{background:#f7f7f2;color:#111613}.state-title{font-size:25rpx;font-weight:760}.state-desc{font-size:21rpx;line-height:1.6;margin-top:8rpx}
.ai-summary-card{background:#c4e267;border-radius:22rpx;padding:24rpx 24rpx;margin-bottom:24rpx}
.ai-summary-title{font-size:19rpx;letter-spacing:2rpx;color:#111613;font-weight:700;margin-bottom:12rpx}
.ai-summary-text{font-size:25rpx;line-height:1.8;color:#111613}
