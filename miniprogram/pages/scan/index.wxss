.item-evidence{margin:24rpx 0}.food-item{padding:20rpx 0;border-bottom:1rpx solid #e8ece9}.food-item:last-child{border-bottom:0}.item-index{font-family:Georgia,serif;color:#8aa096;font-size:20rpx;margin-right:14rpx}.item-name{font-size:25rpx;font-weight:700}.item-kcal{font-size:23rpx;font-weight:700;color:#285c4c}.item-meta{margin:10rpx 0 7rpx;color:#77827d;font-size:19rpx}.item-evidence-text{font-size:21rpx;line-height:1.6;color:#4d5b55}.derived-total{padding:15rpx 18rpx;border-radius:15rpx;background:#eef4f1;color:#4d6a60;font-size:20rpx;line-height:1.5}.item-editor{padding:18rpx;border:1rpx solid #e2e9e5;border-radius:20rpx}.item-editor-title{font-size:21rpx;font-weight:720;color:#376052;margin-bottom:12rpx}.item-editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.item-editor-grid .field{background:#f8faf9}
.scan-page{background:#f5f4ef}.scan-hero{padding:12rpx 6rpx 26rpx}.kicker{font-size:20rpx;color:#3b695b;font-weight:700;letter-spacing:3rpx}.title{font-size:44rpx;line-height:1.3;font-weight:720;margin:14rpx 0}.camera{height:590rpx;border-radius:26rpx;overflow:hidden;background:#173a31;position:relative;box-shadow:0 16rpx 44rpx rgba(28,55,46,.12)}.camera image{width:100%;height:100%}.empty-camera{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:white}.lens{display:flex;align-items:center;justify-content:center;width:116rpx;height:116rpx;border:1rpx solid rgba(255,255,255,.46);border-radius:50%;font-family:Georgia,serif;font-size:26rpx;color:#f5f1e5}.empty-camera .b{font-size:30rpx;margin-top:28rpx}.empty-camera .small{font-size:22rpx;opacity:.65;margin-top:12rpx}.scan-corners view{position:absolute;width:68rpx;height:68rpx;border-color:white}.scan-corners view:nth-child(1){left:28rpx;top:28rpx;border-left:3rpx solid;border-top:3rpx solid;border-radius:12rpx 0 0 0}.scan-corners view:nth-child(2){right:28rpx;top:28rpx;border-right:3rpx solid;border-top:3rpx solid;border-radius:0 12rpx 0 0}.scan-corners view:nth-child(3){left:28rpx;bottom:28rpx;border-left:3rpx solid;border-bottom:3rpx solid;border-radius:0 0 0 12rpx}.scan-corners view:nth-child(4){right:28rpx;bottom:28rpx;border-right:3rpx solid;border-bottom:3rpx solid;border-radius:0 0 12rpx 0}.analyze{margin:24rpx 0 30rpx;height:94rpx;border-radius:18rpx;background:#173f34;color:#fff;font-size:28rpx;font-weight:650}.analyze::after,.save::after{border:none}.dish{font-size:35rpx;font-weight:720;margin:16rpx 0 6rpx}.kcal{text-align:right}.kcal .b{display:block;font-family:Georgia,serif;font-size:52rpx}.kcal .small{font-size:20rpx;color:#87928d}.macro{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:28rpx 0}.macro view{background:#f1f3ef;border-radius:16rpx;padding:18rpx 8rpx;text-align:center}.macro .b,.macro .small{display:block}.macro .b{font-size:28rpx}.macro .small{font-size:18rpx;color:#87928d;margin-top:4rpx}.ingredients{display:flex;flex-wrap:wrap;gap:10rpx}.ingredients text{font-size:21rpx;background:#edf4f1;padding:9rpx 14rpx;border-radius:999rpx}.tips{margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#f3ede2;color:#5d5238;line-height:1.7;font-size:23rpx}.tips-title{font-weight:700;margin-bottom:6rpx}.save{margin-top:24rpx;background:#173f35;color:#fff;border-radius:18rpx;font-weight:650}.notice{font-size:20rpx;color:#87908b;line-height:1.7;padding:0 8rpx}
.estimate-range{margin:24rpx 0;padding:22rpx;border:1rpx solid #e4e2da;border-radius:18rpx;background:#faf9f5}.estimate-range>view:first-child{display:flex;justify-content:space-between;align-items:center}.estimate-range text{color:#737c77;font-size:20rpx;line-height:1.55}.estimate-range b{font-size:24rpx}.range-line{position:relative;height:8rpx;margin:18rpx 0 14rpx;border-radius:99rpx;background:#e4e8e5}.range-line .range-fill{position:absolute;left:18%;right:14%;height:100%;border-radius:99rpx;background:#6f978a}.range-line .range-dot{position:absolute;left:54%;top:-7rpx;width:20rpx;height:20rpx;border:4rpx solid #fff;border-radius:50%;background:#224f42;box-shadow:0 1rpx 6rpx rgba(0,0,0,.2)}.evidence-block,.uncertainty{margin:20rpx 0;padding:22rpx;border-radius:18rpx;background:#edf3f0}.uncertainty{background:#f5f0e8;color:#675b47;font-size:21rpx;line-height:1.7}.evidence-title{margin-bottom:12rpx;font-size:23rpx;font-weight:680}.evidence-tags{display:flex;flex-wrap:wrap;gap:10rpx}.evidence-tags text{padding:8rpx 13rpx;border:1rpx solid #d3dfd9;border-radius:999rpx;background:#fff;font-size:20rpx}

.scan-beam{position:absolute;left:30rpx;right:30rpx;top:42rpx;height:4rpx;opacity:.4}.scan-beam.active{animation:scanMove 1.6s cubic-bezier(.45,.05,.55,.95) infinite;opacity:1}.beam-line{height:4rpx;border-radius:99rpx;background:linear-gradient(90deg,rgba(216,255,132,0),#d8ff84 20%,#fff 50%,#d8ff84 80%,rgba(216,255,132,0));box-shadow:0 0 24rpx rgba(216,255,132,.72)}.scan-status{position:absolute;left:50%;bottom:35rpx;transform:translateX(-50%);display:flex;align-items:center;gap:10rpx;background:rgba(17,47,39,.78);color:#fff;border-radius:999rpx;padding:13rpx 18rpx;font-size:19rpx;white-space:nowrap}.scan-dot{width:12rpx;height:12rpx;border-radius:50%;background:#d8ff84;animation:scanPulse 1s infinite}@keyframes scanMove{0%{top:42rpx}50%{top:530rpx}100%{top:42rpx}}@keyframes scanPulse{0%,100%{opacity:.4;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}
.flow{display:flex;align-items:flex-start;margin:8rpx 4rpx 26rpx}.flow-item{width:70rpx;text-align:center;color:#9aa6a1;font-size:19rpx}.flow-item text{display:flex;margin:0 auto 6rpx;width:42rpx;height:42rpx;border-radius:50%;align-items:center;justify-content:center;background:#e7ecea;color:#7f8d87;font-weight:700}.flow-item.on{color:#1c5a48}.flow-item.on text{background:#d8ff84;color:#173f34}.flow-line{height:3rpx;flex:1;background:#dfe6e2;margin-top:20rpx}.flow-line.on{background:#8ebcaa}.correction-head{border-top:1rpx solid #edf1ef;padding-top:24rpx;margin-top:8rpx}.info-title{font-size:27rpx;font-weight:750}.smalltxt{font-size:20rpx;margin-top:4rpx}.edit-btn{margin:0;padding:0 24rpx;height:58rpx;line-height:58rpx;border-radius:999rpx;background:#edf4f1;color:#245b4b;font-size:22rpx}.edit-btn::after{border:none}.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.field{background:#f5f7f6;border-radius:20rpx;padding:16rpx}.field text{font-size:19rpx;color:#76827e}.field input{font-size:25rpx;margin-top:8rpx;min-height:44rpx}.field.wide,.edit-grid .wide{grid-column:1 / -1}.mini{margin-top:18rpx;font-size:22rpx}.state-panel{border-radius:24rpx;padding:22rpx 24rpx;margin:18rpx 0}.state-error{background:#fff1ef;color:#823f39}.state-success{background:#edf8f1;color:#235a42}.state-title{font-size:25rpx;font-weight:760}.state-desc{font-size:21rpx;line-height:1.6;margin-top:6rpx}
