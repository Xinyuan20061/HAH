# Public HTTPS domain of the WeChat Cloud Run service.
# Local AI workers cannot use wx.cloud.callContainer, so the worker endpoint must be publicly reachable.
API_BASE_URL=https://YOUR-SERVICE-DOMAIN/api/v1
WORKER_TOKEN=
WORKER_ID=healthmate-laptop-01
WORKER_NAME=HealthMate RTX Worker
POLL_INTERVAL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_MB=200
MAX_REDIRECTS=5
API_MAX_RETRIES=3
LOG_LEVEL=INFO

# Capabilities: comma separated. motion_pose works with MediaPipe.
# food_vision requires a local OpenAI-compatible vision model endpoint.
CAPABILITIES=motion_pose,food_vision

# Vision provider: local keeps images on this computer; deepseek sends the compressed
# image to the configured API after the user explicitly starts food analysis.
# local_first: local first, low score falls back to cloud; cloud_first: cloud first;
# off: never call the cloud and use local capability only.
AI_MODE=local_first
LOCAL_CONFIDENCE_THRESHOLD=0.6
VLM_PROVIDER=local
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local multimodal model. Examples: LM Studio / vLLM / Ollama OpenAI-compatible / other VLM server.
LOCAL_VLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_VLM_MODEL=
LOCAL_VLM_API_KEY=
LOCAL_VLM_TIMEOUT_SECONDS=120
# Opt in only if this endpoint supports response_format json_object.
LOCAL_VLM_JSON_MODE=false
IMAGE_MAX_DIMENSION=1280
IMAGE_MAX_BYTES=1000000

# Optional pretrained Food-101 classifier. Install requirements-food-classifier.txt
# and set a reviewed Hugging Face image-classification checkpoint ID. It proposes
# dish-name candidates only; the configured VLM estimates portions and nutrients.
FOOD_CLASSIFIER_MODEL=
FOOD_CLASSIFIER_TOP_K=3

# Only for local development when the media source is served from localhost.
ALLOW_PRIVATE_MEDIA_HOSTS=false

# Optional trained skeleton semantic model. Leave empty to use the audited rule baseline.
# The sidecar file must be MODEL_PATH + ".json" and use motion-semantic-v1 labels.
SEMANTIC_MODEL_PATH=
SEMANTIC_MODEL_SHA256=
SEMANTIC_MODEL_MIN_CONFIDENCE=0.45
